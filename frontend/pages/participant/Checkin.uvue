<script setup>
import { ref, computed } from 'vue'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import * as liveApi from '../../api/live'
import { getDesktopMaxWidth } from '../../utils/viewport'
import { showError, showSuccess } from '../../utils/toast'

const pageMaxWidth = getDesktopMaxWidth()
const sessionId = ref<string>('')
const name = ref<string>('')
const submitting = ref<boolean>(false)
const submitted = ref<boolean>(false)
const errorMessage = ref<string>('')

const canSubmit = computed<boolean>(() => !!sessionId.value && !!name.value.trim() && !submitting.value && !submitted.value)
const buttonText = computed<string>(() => submitting.value ? '签到中...' : (submitted.value ? '已签到' : '确认签到'))

onLoad((optionsParam) => {
  if (optionsParam != null) {
    sessionId.value = (optionsParam['sessionId'] as string) || ''
  }
  if (!sessionId.value) {
    errorMessage.value = '签到入口无效'
  }
})

function goBack() {
  uni.navigateBack()
}

async function submitCheckin() {
  if (!canSubmit.value) return
  submitting.value = true
  errorMessage.value = ''
  try {
    await liveApi.checkin(sessionId.value, {
      name: name.value.trim()
    } as UTSJSONObject)
    submitted.value = true
    showSuccess('签到成功')
  } catch (e : unknown) {
    const message = e instanceof Error ? e.message : '签到失败'
    errorMessage.value = message
    showError(message)
  } finally {
    submitting.value = false
  }
}
</script>

<template>
  <view class="page app-secondary-page">
    <NavBar title="培训签到" backgroundColor="#FFFFFF" titleColor="#111827" backIconColor="#333333" @back="goBack" />

    <view class="content app-secondary-page-content" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="card">
        <view class="header-icon">
          <AppIcon name="toolCheckin" size="48rpx" />
        </view>
        <text class="title">{{ submitted ? '签到成功' : '欢迎参加培训' }}</text>
        <text class="desc">{{ submitted ? '请回到现场等待培训师安排' : '请输入姓名完成签到' }}</text>

        <view v-if="!submitted" class="form-group">
          <input class="input" v-model="name" placeholder="请输入你的姓名" placeholder-class="input-placeholder" />
        </view>

        <text v-if="errorMessage" class="error-text">{{ errorMessage }}</text>

        <view :class="['submit-btn', { disabled: !canSubmit }]" @click="submitCheckin">
          <text class="submit-btn-text">{{ buttonText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<style lang="scss" scoped>
.page {
  min-height: 100vh;
  background-color: #F5F6FA;
}

.content {
  margin: 0 auto;
  padding: 28rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 44rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.06);
}

.header-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background-color: #EEF3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 10rpx;
}

.desc {
  font-size: 27rpx;
  color: #8E8E93;
  margin-bottom: 34rpx;
}

.form-group {
  width: 100%;
  margin-bottom: 22rpx;
}

.input {
  height: 92rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1A1A2E;
}

.input-placeholder {
  color: #B8BCC8;
}

.error-text {
  width: 100%;
  font-size: 24rpx;
  color: #FF4D4F;
  margin-bottom: 18rpx;
  text-align: center;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 20rpx;
  background-color: #4A7CF7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  opacity: 0.48;
}

.submit-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
</style>
