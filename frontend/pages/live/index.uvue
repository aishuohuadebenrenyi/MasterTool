<script setup>
import { ref, computed, watch, onMounted, onUnmounted, getCurrentInstance } from 'vue'
import { useLiveStore } from '../../stores/live'
import { usePlanStore } from '../../stores/plan'
import { useConfigStore } from '../../stores/config'
import NavBar from '../../components/NavBar.uvue'
import ConfirmDialog from '../../components/ConfirmDialog.uvue'
import HalfSheet from '../../components/HalfSheet.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import TimerDisplay from './components/TimerDisplay.uvue'
import ToolButton from './components/ToolButton.uvue'
import * as noteApi from '../../api/note'
import { calcNavBarInfo } from '../../utils/navbar'
import { getDesktopMaxWidth, getSafeAreaBottom, getViewportHeight } from '../../utils/viewport'

const liveStore = useLiveStore()
const planStore = usePlanStore()
const configStore = useConfigStore()
const navBarInfo = calcNavBarInfo()
const navBarHeight = navBarInfo['navBarHeight'] as number

const templateId = ref<string>('')
const peopleCount = ref<number>(30)

const showExitDialog = ref<boolean>(false)

const safeAreaBottom = ref<number>(getSafeAreaBottom())
const viewportHeight = ref<number>(getViewportHeight())
const pageMaxWidth = ref<number>(getDesktopMaxWidth())

const timerSeconds = ref<number>(0)
const timerRunning = ref<boolean>(false)
let timerInterval : number | null = null
let timerTapTimeout : number | null = null
const touchStartX = ref<number>(0)
const touchStartY = ref<number>(0)
const lastTouchTime = ref<number>(0)

const planName = computed<string>(() => liveStore.planName || (planStore.currentPlan ? (planStore.currentPlan['name'] as string) : '培训现场'))

const phases = computed<Array<UTSJSONObject>>(() => {
  const plan = planStore.currentPlan
  if (plan && plan['phases']) {
    return plan['phases'] as Array<UTSJSONObject>
  }
  return [
    { name: '开场' },
    { name: '破冰' },
    { name: '主体' },
    { name: '总结' }
  ] as Array<UTSJSONObject>
})

const currentPhaseIndex = computed<number>(() => liveStore.currentPhaseIndex)

const currentPhaseName = computed<string>(() => {
  const list = phases.value
  if (list.length === 0) return '准备中'
  const idx = currentPhaseIndex.value
  if (idx >= 0 && idx < list.length) {
    return (list[idx]['name'] as string) || '进行中'
  }
  return '进行中'
})

const reminders = computed<Array<string>>(() => {
  const list = phases.value
  const idx = currentPhaseIndex.value
  if (idx >= 0 && idx < list.length && list[idx]['reminders']) {
    return list[idx]['reminders'] as Array<string>
  }
  return ['注意时间控制', '关注参与者状态', '保持互动节奏']
})

const timerDisplay = computed<string>(() => {
  const mins = Math.floor(timerSeconds.value / 60)
  const secs = timerSeconds.value % 60
  const m = mins < 10 ? '0' + mins : '' + mins
  const s = secs < 10 ? '0' + secs : '' + secs
  return m + ':' + s
})

const timerProgress = computed<number>(() => {
  const total = phaseDurationSeconds.value
  if (total <= 0) return 0
  const elapsed = total - timerSeconds.value
  return Math.min((elapsed / total) * 100, 100)
})

const phaseDurationSeconds = computed<number>(() => {
  const list = phases.value
  const idx = currentPhaseIndex.value
  if (idx >= 0 && idx < list.length) {
    const phase = list[idx]
    if (phase['time']) {
      return (phase['time'] as number) * 60
    }
  }
  return 900
})

const canPrev = computed<boolean>(() => currentPhaseIndex.value > 0)
const canNext = computed<boolean>(() => currentPhaseIndex.value < phases.value.length - 1)

const quickTools = computed<Array<UTSJSONObject>>(() => {
  const tid = templateId.value || 'corporate'
  if (tid === 'teambuilding') {
    return [
      { key: 'checkin', iconName: 'toolCheckin', name: '签到' } as UTSJSONObject,
      { key: 'group', iconName: 'toolGroup', name: '分组' } as UTSJSONObject,
      { key: 'score', iconName: 'toolScore', name: '积分' } as UTSJSONObject,
      { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
    ]
  } else if (tid === 'improv_show') {
    return [
      { key: 'pick', iconName: 'toolRandom', name: '随机' } as UTSJSONObject,
      { key: 'timer', iconName: 'toolTimer', name: '计时' } as UTSJSONObject,
      { key: 'sound', iconName: 'toolSound', name: '音效' } as UTSJSONObject,
      { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
    ]
  } else if (tid === 'improv_training') {
    return [
      { key: 'pick', iconName: 'toolRandom', name: '随机' } as UTSJSONObject,
      { key: 'timer', iconName: 'toolTimer', name: '计时' } as UTSJSONObject,
      { key: 'note', iconName: 'toolNote', name: '笔记' } as UTSJSONObject,
      { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
    ]
  }
  return [
    { key: 'checkin', iconName: 'toolCheckin', name: '签到' } as UTSJSONObject,
    { key: 'group', iconName: 'toolGroup', name: '分组' } as UTSJSONObject,
    { key: 'score', iconName: 'toolScore', name: '积分' } as UTSJSONObject,
    { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
  ]
})

const checkinSheet = ref<boolean>(false)
const groupSheet = ref<boolean>(false)
const scoreSheet = ref<boolean>(false)
const pickSheet = ref<boolean>(false)
const interactSheet = ref<boolean>(false)
const soundSheet = ref<boolean>(false)
const standaloneTimerSheet = ref<boolean>(false)
const noteSheet = ref<boolean>(false)
const showToolbox = ref<boolean>(false)

const allTools : Array<UTSJSONObject> = [
  { key: 'checkin', iconName: 'toolCheckin', name: '签到' } as UTSJSONObject,
  { key: 'group', iconName: 'toolGroup', name: '分组' } as UTSJSONObject,
  { key: 'score', iconName: 'toolScore', name: '积分' } as UTSJSONObject,
  { key: 'pick', iconName: 'toolRandom', name: '随机' } as UTSJSONObject,
  { key: 'interact', iconName: 'toolInteract', name: '互动' } as UTSJSONObject,
  { key: 'sound', iconName: 'toolSound', name: '音效' } as UTSJSONObject,
  { key: 'timer', iconName: 'toolTimer', name: '计时' } as UTSJSONObject,
  { key: 'note', iconName: 'toolNote', name: '笔记' } as UTSJSONObject
]

function closeToolbox() {
  showToolbox.value = false
}

function openToolFromToolbox(tool : UTSJSONObject) {
  showToolbox.value = false
  const key = tool['key'] as string
  if (key === 'checkin') checkinSheet.value = true
  else if (key === 'group') groupSheet.value = true
  else if (key === 'score') scoreSheet.value = true
  else if (key === 'pick') pickSheet.value = true
  else if (key === 'interact') interactSheet.value = true
  else if (key === 'sound') soundSheet.value = true
  else if (key === 'timer') standaloneTimerSheet.value = true
  else if (key === 'note') noteSheet.value = true
}

const checkinCount = ref<number>(12)
const recentCheckins = ref<Array<UTSJSONObject>>([
  { name: '张三', time: '14:32' } as UTSJSONObject,
  { name: '李四', time: '14:30' } as UTSJSONObject,
  { name: '王五', time: '14:28' } as UTSJSONObject
])

const groupMethod = ref<string>('average')
const groupCount = ref<number>(4)
const groupResults = ref<Array<UTSJSONObject>>([])
const isGrouped = ref<boolean>(false)

const scoreMode = ref<string>('simple')
const teamScores = ref<Array<UTSJSONObject>>([])

const pickTab = ref<string>('actor')
const pickResult = ref<string>('')
const isPicking = ref<boolean>(false)

const interactType = ref<string>('')

const activeSound = ref<string>('')
const soundList : Array<UTSJSONObject> = [
  { key: 'cheer', iconName: 'soundCheer', name: '欢呼' } as UTSJSONObject,
  { key: 'clap', iconName: 'soundClap', name: '鼓掌' } as UTSJSONObject,
  { key: 'bell', iconName: 'soundBell', name: '铃声' } as UTSJSONObject,
  { key: 'countdown', iconName: 'toolTimer', name: '倒计时' } as UTSJSONObject,
  { key: 'theme', iconName: 'soundTheme', name: '主题' } as UTSJSONObject,
  { key: 'error', iconName: 'soundError', name: '错误音' } as UTSJSONObject
]

const standaloneTimerMode = ref<string>('countup')
const countdownMinutes = ref<number>(1)
const standaloneSeconds = ref<number>(0)
const standaloneRunning = ref<boolean>(false)
let standaloneInterval : number | null = null

const standaloneTimerDisplay = computed<string>(() => {
  const mins = Math.floor(standaloneSeconds.value / 60)
  const secs = standaloneSeconds.value % 60
  const m = mins < 10 ? '0' + mins : '' + mins
  const s = secs < 10 ? '0' + secs : '' + secs
  return m + ':' + s
})

const noteContent = ref<string>('')

const hasOpenSheet = computed<boolean>(() => {
  return checkinSheet.value || groupSheet.value || scoreSheet.value || pickSheet.value || interactSheet.value ||
    soundSheet.value || standaloneTimerSheet.value || noteSheet.value || showToolbox.value || showExitDialog.value
})

function toggleTimer() {
  if (timerRunning.value) {
    timerRunning.value = false
    if (timerInterval) {
      clearInterval(timerInterval)
      timerInterval = null
    }
    liveStore.pauseSession()
  } else {
    if (timerSeconds.value <= 0) {
      timerSeconds.value = phaseDurationSeconds.value
    }
    timerRunning.value = true
    timerInterval = setInterval(() => {
      if (timerSeconds.value > 0) {
        timerSeconds.value--
      } else {
        timerRunning.value = false
        if (timerInterval) {
          clearInterval(timerInterval)
          timerInterval = null
        }
      }
    }, 1000)
    liveStore.resumeSession()
  }
}

function delayFiveMinutes() {
  timerSeconds.value += 300
  uni.showToast({ title: '已延时 5 分钟', icon: 'none' })
}

function handleTimerTap() {
  if (configStore.doubleTapDelayEnabled) {
    if (timerTapTimeout) {
      clearTimeout(timerTapTimeout)
      timerTapTimeout = null
      delayFiveMinutes()
      return
    }
    timerTapTimeout = setTimeout(() => {
      timerTapTimeout = null
      toggleTimer()
    }, 220)
    return
  }
  toggleTimer()
}

function handleBack() {
  showExitDialog.value = true
}

function confirmExit() {
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  timerRunning.value = false
  liveStore.endSession()
  uni.navigateBack({})
}

function cancelExit() {
  showExitDialog.value = false
}

function handlePrev() {
  if (canPrev.value) {
    liveStore.prevPhase()
  }
}

function handleNext() {
  if (canNext.value) {
    liveStore.nextPhase()
  } else {
    if (timerInterval) {
      clearInterval(timerInterval)
      timerInterval = null
    }
    timerRunning.value = false
    liveStore.endSession()
    uni.redirectTo({ url: '/pages/live/LiveEnd' })
  }
}

function handleToolClick(idx : number) {
  const tool = quickTools.value[idx]
  const key = tool['key'] as string
  if (key === 'toolbox') {
    showToolbox.value = true
    return
  }
  if (key === 'checkin') checkinSheet.value = true
  else if (key === 'group') groupSheet.value = true
  else if (key === 'score') scoreSheet.value = true
  else if (key === 'pick') pickSheet.value = true
  else if (key === 'interact') interactSheet.value = true
  else if (key === 'sound') soundSheet.value = true
  else if (key === 'timer') standaloneTimerSheet.value = true
  else if (key === 'note') noteSheet.value = true
}

const groupColors : Array<string> = ['#4A7CF7', '#FF6B6B', '#51CF66', '#FFD43B', '#CC5DE8', '#FF922B', '#20C997', '#F06595', '#A9E34B', '#748FFC']

function doGrouping() {
  const total = peopleCount.value
  const count = groupCount.value
  const base = Math.floor(total / count)
  const remainder = total % count
  const results : Array<UTSJSONObject> = []
  for (let i = 0; i < count; i++) {
    const c = i < remainder ? base + 1 : base
    results.push({ name: '第' + (i + 1) + '队', count: c, color: groupColors[i % groupColors.length] } as UTSJSONObject)
  }
  groupResults.value = results
  isGrouped.value = false
}

function syncScoresFromGroups() {
  const scores : Array<UTSJSONObject> = []
  for (let i = 0; i < groupResults.value.length; i++) {
    const g = groupResults.value[i]
    scores.push({ name: g['name'] as string, score: 0, color: g['color'] as string } as UTSJSONObject)
  }
  teamScores.value = scores
}

function adjustGroupCount(delta : number) {
  const next = groupCount.value + delta
  if (next >= 2 && next <= 10) {
    groupCount.value = next
  }
}

function changeScore(idx : number, delta : number) {
  const currentScore = (teamScores.value[idx]['score'] as number) || 0
  teamScores.value[idx]['score'] = Math.max(0, currentScore + delta)
}

function resetScores() {
  for (let i = 0; i < teamScores.value.length; i++) {
    teamScores.value[i]['score'] = 0
  }
}

function startPick() {
  isPicking.value = true
  pickResult.value = ''
  setTimeout(() => {
    const names : Array<string> = ['张三', '李四', '王五', '赵六', '钱七', '孙八', '周九', '吴十']
    const idx = Math.floor(Math.random() * names.length)
    pickResult.value = names[idx]
    isPicking.value = false
  }, 1500)
}

function playSound(key : string) {
  activeSound.value = key
  setTimeout(() => {
    activeSound.value = ''
  }, 500)
}

function toggleStandaloneTimer() {
  if (standaloneRunning.value) {
    standaloneRunning.value = false
    if (standaloneInterval) {
      clearInterval(standaloneInterval)
      standaloneInterval = null
    }
  } else {
    if (standaloneTimerMode.value === 'countdown' && standaloneSeconds.value === 0) {
      standaloneSeconds.value = countdownMinutes.value * 60
    }
    standaloneRunning.value = true
    standaloneInterval = setInterval(() => {
      if (standaloneTimerMode.value === 'countdown') {
        if (standaloneSeconds.value > 0) {
          standaloneSeconds.value--
        } else {
          standaloneRunning.value = false
          if (standaloneInterval) {
            clearInterval(standaloneInterval)
            standaloneInterval = null
          }
        }
      } else {
        standaloneSeconds.value++
      }
    }, 1000)
  }
}

function resetStandaloneTimer() {
  standaloneRunning.value = false
  if (standaloneInterval) {
    clearInterval(standaloneInterval)
    standaloneInterval = null
  }
  standaloneSeconds.value = 0
}

function saveNote() {
  const content = noteContent.value.trim()
  if (!content) return
  const payload = {
    phaseIndex: currentPhaseIndex.value,
    phaseName: currentPhaseName.value,
    content
  } as UTSJSONObject
  liveStore.addNote(payload)
  const currentSessionId = liveStore.sessionId || ''
  if (currentSessionId) {
    noteApi.saveNote({
      sessionId: currentSessionId,
      phase: currentPhaseName.value,
      content
    } as UTSJSONObject).catch((e : unknown) => {
      console.log('[live.note.save]', e)
    })
  }
  noteContent.value = ''
}

function handleTouchStart(event : TouchEvent) {
  if (hasOpenSheet.value) return
  const touches = event.touches
  if (touches.length === 0) return
  touchStartX.value = touches[0].clientX
  touchStartY.value = touches[0].clientY
  lastTouchTime.value = Date.now()
}

function handleTouchEnd(event : TouchEvent) {
  if (hasOpenSheet.value) return
  const changedTouches = event.changedTouches
  if (changedTouches.length === 0) return
  const deltaX = changedTouches[0].clientX - touchStartX.value
  const deltaY = changedTouches[0].clientY - touchStartY.value
  const duration = Date.now() - lastTouchTime.value
  if (Math.abs(deltaY) > 48 || Math.abs(deltaX) < 60 || duration > 600) {
    return
  }
  if (deltaX < 0 && configStore.swipeNextEnabled) {
    console.log('[live.swipe]', 'next', deltaX, deltaY, duration)
    handleNext()
  } else if (deltaX > 0 && configStore.swipePrevEnabled) {
    console.log('[live.swipe]', 'prev', deltaX, deltaY, duration)
    handlePrev()
  }
}

watch(currentPhaseIndex, () => {
  timerRunning.value = false
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  timerSeconds.value = phaseDurationSeconds.value
  doGrouping()
})

onMounted(async () => {
  safeAreaBottom.value = getSafeAreaBottom()
  viewportHeight.value = getViewportHeight()
  pageMaxWidth.value = getDesktopMaxWidth()
  configStore.restoreConfig()
  const instance = getCurrentInstance()
  if (instance && instance.proxy) {
    const page = (instance.proxy as unknown as UTSJSONObject)['$page'] as UTSJSONObject | null
    if (page && page['options']) {
      const options = page['options'] as UTSJSONObject
      const pid = options['planId'] as string | null
      const tid = options['templateId'] as string | null
      const name = options['name'] as string | null
      const count = options['peopleCount'] as string | null
      if (tid) {
        templateId.value = tid
      }
      if (name) {
        liveStore.planName = (decodeURIComponent(name) as string) || name
      }
      if (count) {
        peopleCount.value = parseInt(count) || 30
      }
      if (pid) {
        await planStore.fetchPlanDetail(pid)
        templateId.value = (planStore.currentPlan?.['type'] as string) || templateId.value
        peopleCount.value = Number(planStore.currentPlan?.['people'] || peopleCount.value)
        await liveStore.startSession({
          planId: pid,
          planName: (planStore.currentPlan?.['name'] as string) || '',
          peopleCount: peopleCount.value
        } as UTSJSONObject)
      } else if (tid) {
        await liveStore.startSession({ templateId: tid, planName: (decodeURIComponent(name || '') as string) } as UTSJSONObject)
      }
    }
  }
  if (liveStore.sessionId) {
    try {
      const savedNotes = await noteApi.getNoteList(liveStore.sessionId)
      for (let i = savedNotes.length - 1; i >= 0; i--) {
        liveStore.addNote({
          phaseName: savedNotes[i]['phase'],
          content: savedNotes[i]['content'],
          createdAt: savedNotes[i]['createdAt']
        } as UTSJSONObject)
      }
    } catch (_e : unknown) {
    }
  }
  timerSeconds.value = phaseDurationSeconds.value
})

onUnmounted(() => {
  if (timerTapTimeout) {
    clearTimeout(timerTapTimeout)
    timerTapTimeout = null
  }
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  if (standaloneInterval) {
    clearInterval(standaloneInterval)
    standaloneInterval = null
  }
})
</script>

<template>
  <view class="page" @touchstart="handleTouchStart" @touchend="handleTouchEnd">
    <NavBar :title="planName" backgroundColor="#1A1A2E" @back="handleBack"></NavBar>

    <view
      :class="['live-body', { 'sheet-open': hasOpenSheet }]"
      :style="{ '--nav-bar-height': navBarHeight + 'px', '--safe-area-bottom': safeAreaBottom + 'px', maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }"
    >
      <view class="phase-progress-wrap">
        <view class="phase-progress">
          <text class="phase-progress-text">环节 {{ currentPhaseIndex + 1 }}/{{ phases.length }}</text>
          <view class="phase-progress-bar">
            <view class="phase-progress-fill" :style="{ width: ((currentPhaseIndex + 1) / phases.length * 100) + '%' }"></view>
          </view>
        </view>
      </view>

      <view class="current-phase-section">
        <text class="current-phase-name">{{ currentPhaseName }}</text>
      </view>

      <view class="timer-section" @click="handleTimerTap">
        <TimerDisplay :time="timerDisplay" :progress="timerProgress" :isRunning="timerRunning"></TimerDisplay>
        <text class="timer-hint">{{ configStore.doubleTapDelayEnabled ? (timerRunning ? '单击暂停，双击延时 5 分钟' : '单击开始，双击延时 5 分钟') : (timerRunning ? '点击暂停' : '点击开始') }}</text>
      </view>

      <view class="reminders-section">
        <view class="reminders-header">
          <view class="section-title-row">
            <AppIcon name="phaseSummary" size="28rpx" />
            <text class="reminders-title">关键提醒</text>
          </view>
        </view>
        <view class="reminder-item" v-for="(item, idx) in reminders" :key="idx">
          <text class="reminder-bullet">•</text>
          <text class="reminder-text">{{ item }}</text>
        </view>
      </view>

      <view v-if="!hasOpenSheet" class="bottom-action-section">
        <view class="toolbar-section">
          <view class="toolbar-grid">
            <ToolButton
              v-for="(tool, idx) in quickTools"
              :key="idx"
              :iconName="tool['iconName'] as string"
              :label="tool['name'] as string"
              @click="handleToolClick(idx)"
            ></ToolButton>
          </view>
        </view>

        <view class="nav-buttons">
          <view :class="['nav-btn', 'nav-btn-prev', { disabled: !canPrev }]" @click="handlePrev">
            <text class="nav-btn-text">{{ '上一环节' }}</text>
          </view>
          <view class="nav-btn nav-btn-next" @click="handleNext">
            <text class="nav-btn-text">{{ canNext ? '下一环节' : '结束培训' }}</text>
          </view>
        </view>
      </view>
    </view>

    <HalfSheet :visible="checkinSheet" size="large" title="签到管理" @update:visible="checkinSheet = $event">
      <view class="checkin-stats">
        <text class="checkin-stats-text">已签到 {{ checkinCount }} / 预计 {{ peopleCount }} 人</text>
      </view>
      <view class="checkin-qr">
        <view class="checkin-qr-icon-wrap">
          <AppIcon name="stateQr" size="56rpx" />
        </view>
        <text class="checkin-qr-hint">参与者扫码签到</text>
        <text class="checkin-qr-text">参与者扫码后自动进入签到列表</text>
      </view>
      <view class="checkin-list-header">
        <text class="checkin-list-title">最近签到</text>
      </view>
      <view class="checkin-item" v-for="(item, idx) in recentCheckins" :key="idx">
        <view class="checkin-avatar">
          <text class="checkin-avatar-text">{{ (item['name'] as string).charAt(0) }}</text>
        </view>
        <text class="checkin-name">{{ item['name'] as string }}</text>
        <text class="checkin-time">{{ item['time'] as string }}</text>
      </view>
      <template #footer>
        <view class="sheet-footer-btn sheet-footer-btn-danger" @click="checkinSheet = false">
          <text class="sheet-footer-btn-text">结束签到</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="groupSheet" size="large" title="分组管理" @update:visible="groupSheet = $event">
      <text class="sheet-label">分组方式</text>
      <view class="group-method-row">
        <view :class="['group-method-btn', { active: groupMethod === 'average' }]" @click="groupMethod = 'average'">
          <text class="group-method-text">按人数均分</text>
        </view>
        <view :class="['group-method-btn', { active: groupMethod === 'free' }]" @click="groupMethod = 'free'">
          <text class="group-method-text">自由分组</text>
        </view>
        <view :class="['group-method-btn', { active: groupMethod === 'random' }]" @click="groupMethod = 'random'">
          <text class="group-method-text">随机分组</text>
        </view>
      </view>
      <text class="sheet-label">队伍数量</text>
      <view class="group-count-row">
        <view class="group-count-btn" @click="adjustGroupCount(-1)">
          <text class="group-count-btn-text">−</text>
        </view>
        <text class="group-count-value">{{ groupCount }}</text>
        <view class="group-count-btn" @click="adjustGroupCount(1)">
          <text class="group-count-btn-text">+</text>
        </view>
      </view>
      <text class="sheet-label">分组结果</text>
      <view class="group-result-item" v-for="(item, idx) in groupResults" :key="idx">
        <view class="group-color-dot" :style="{ backgroundColor: item['color'] as string }"></view>
        <text class="group-result-name">{{ item['name'] as string }}</text>
        <text class="group-result-count">{{ item['count'] as number }}人</text>
      </view>
      <template #footer>
        <view class="sheet-footer-row">
          <view class="sheet-footer-btn sheet-footer-btn-secondary" @click="doGrouping()">
            <text class="sheet-footer-btn-text-secondary">重新分组</text>
          </view>
          <view class="sheet-footer-btn sheet-footer-btn-primary" @click="isGrouped = true; syncScoresFromGroups(); groupSheet = false">
            <text class="sheet-footer-btn-text">确认分组</text>
          </view>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="scoreSheet" size="large" title="积分管理" @update:visible="scoreSheet = $event">
      <text class="sheet-label">积分模式</text>
      <view class="score-mode-row">
        <view :class="['score-mode-btn', { active: scoreMode === 'simple' }]" @click="scoreMode = 'simple'">
          <text class="score-mode-text">简化模式</text>
        </view>
        <view :class="['score-mode-btn', { active: scoreMode === 'detailed' }]" @click="scoreMode = 'detailed'">
          <text class="score-mode-text">详细模式</text>
        </view>
      </view>
      <text class="sheet-label">队伍积分</text>
      <view v-if="!isGrouped" class="score-not-grouped">
        <text class="score-not-grouped-text">请先完成分组</text>
      </view>
      <view v-if="isGrouped" class="score-item" v-for="(item, idx) in teamScores" :key="idx">
        <view class="score-color-dot" :style="{ backgroundColor: item['color'] as string }"></view>
        <text class="score-name">{{ item['name'] as string }}</text>
        <text class="score-value">{{ item['score'] as number }}</text>
        <view class="score-btn-minus" @click="changeScore(idx, -1)">
          <text class="score-btn-text">−</text>
        </view>
        <view class="score-btn-plus" @click="changeScore(idx, 1)">
          <text class="score-btn-text">+</text>
        </view>
      </view>
      <template #footer>
        <view class="sheet-footer-btn sheet-footer-btn-danger" @click="resetScores">
          <text class="sheet-footer-btn-text">重置积分</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="pickSheet" size="standard" title="随机抽取" @update:visible="pickSheet = $event">
      <view class="pick-tabs">
        <view :class="['pick-tab', { active: pickTab === 'actor' }]" @click="pickTab = 'actor'">
          <text class="pick-tab-text">抽演员</text>
        </view>
        <view :class="['pick-tab', { active: pickTab === 'audience' }]" @click="pickTab = 'audience'">
          <text class="pick-tab-text">抽观众</text>
        </view>
        <view :class="['pick-tab', { active: pickTab === 'topic' }]" @click="pickTab = 'topic'">
          <text class="pick-tab-text">抽题目</text>
        </view>
      </view>
      <view class="pick-action-area">
        <view v-if="!isPicking && !pickResult" class="pick-start-btn" @click="startPick">
          <text class="pick-start-text">开始抽取</text>
        </view>
        <view v-if="isPicking" class="pick-animating">
          <text class="pick-animating-text">抽取中...</text>
        </view>
        <view v-if="!isPicking && pickResult" class="pick-result-area">
          <text class="pick-result-text">{{ pickResult }}</text>
        </view>
      </view>
      <view v-if="!isPicking && pickResult" class="pick-retry">
        <view class="pick-retry-btn" @click="startPick">
          <text class="pick-retry-text">再抽一次</text>
        </view>
      </view>
    </HalfSheet>

    <HalfSheet :visible="interactSheet" size="large" title="互动工具" @update:visible="interactSheet = $event">
      <view v-if="!interactType" class="interact-options">
        <view class="interact-card" @click="interactType = 'wordcloud'">
          <AppIcon name="stateCloud" size="36rpx" />
          <text class="interact-card-name">词云</text>
          <text class="interact-card-desc">参与者提交关键词，实时生成词云</text>
        </view>
        <view class="interact-card" @click="interactType = 'vote'">
          <AppIcon name="stateChart" size="36rpx" />
          <text class="interact-card-name">投票</text>
          <text class="interact-card-desc">发起实时投票，收集参与者意见</text>
        </view>
        <view class="interact-card" @click="interactType = 'promise'">
          <AppIcon name="statePromise" size="36rpx" />
          <text class="interact-card-name">承诺</text>
          <text class="interact-card-desc">参与者做出承诺，增强行动意愿</text>
        </view>
      </view>
      <view v-if="interactType === 'wordcloud'" class="interact-detail">
        <view class="interact-detail-header">
          <view class="section-title-row">
            <AppIcon name="stateCloud" size="28rpx" />
            <text class="interact-detail-title">词云互动</text>
          </view>
          <view class="interact-back" @click="interactType = ''">
            <text class="interact-back-text">返回</text>
          </view>
        </view>
        <view class="interact-placeholder">
          <text class="interact-placeholder-text">参与者扫码参与词云互动</text>
        </view>
      </view>
      <view v-if="interactType === 'vote'" class="interact-detail">
        <view class="interact-detail-header">
          <view class="section-title-row">
            <AppIcon name="stateChart" size="28rpx" />
            <text class="interact-detail-title">投票互动</text>
          </view>
          <view class="interact-back" @click="interactType = ''">
            <text class="interact-back-text">返回</text>
          </view>
        </view>
        <view class="interact-placeholder">
          <text class="interact-placeholder-text">参与者扫码参与投票</text>
        </view>
      </view>
      <view v-if="interactType === 'promise'" class="interact-detail">
        <view class="interact-detail-header">
          <view class="section-title-row">
            <AppIcon name="statePromise" size="28rpx" />
            <text class="interact-detail-title">承诺互动</text>
          </view>
          <view class="interact-back" @click="interactType = ''">
            <text class="interact-back-text">返回</text>
          </view>
        </view>
        <view class="interact-placeholder">
          <text class="interact-placeholder-text">参与者扫码提交承诺</text>
        </view>
      </view>
    </HalfSheet>

    <HalfSheet :visible="soundSheet" size="standard" title="音效面板" @update:visible="soundSheet = $event">
      <view class="sound-grid">
        <view
          v-for="(sound, idx) in soundList"
          :key="idx"
          :class="['sound-btn', { active: activeSound === (sound['key'] as string) }]"
          @click="playSound(sound['key'] as string)"
        >
          <AppIcon :name="sound['iconName'] as string" size="34rpx" />
          <text class="sound-btn-name">{{ sound['name'] as string }}</text>
        </view>
      </view>
    </HalfSheet>

    <HalfSheet :visible="standaloneTimerSheet" size="large" title="独立计时" @update:visible="standaloneTimerSheet = $event">
      <text class="sheet-label">计时模式</text>
      <view class="stimer-mode-row">
        <view :class="['stimer-mode-btn', { active: standaloneTimerMode === 'countup' }]" @click="standaloneTimerMode = 'countup'">
          <text class="stimer-mode-text">正计时</text>
        </view>
        <view :class="['stimer-mode-btn', { active: standaloneTimerMode === 'countdown' }]" @click="standaloneTimerMode = 'countdown'">
          <text class="stimer-mode-text">倒计时</text>
        </view>
      </view>
      <view v-if="standaloneTimerMode === 'countdown'" class="stimer-duration-row">
        <view
          v-for="(m, idx) in ([1, 3, 5, 10] as Array<number>)"
          :key="idx"
          :class="['stimer-duration-btn', { active: countdownMinutes === m }]"
          @click="countdownMinutes = m"
        >
          <text class="stimer-duration-text">{{ m }}分钟</text>
        </view>
      </view>
      <view class="stimer-display">
        <text class="stimer-time">{{ standaloneTimerDisplay }}</text>
      </view>
      <template #footer>
        <view class="stimer-controls">
          <view class="stimer-ctrl-btn" @click="resetStandaloneTimer">
            <text class="stimer-ctrl-text">重置</text>
          </view>
          <view :class="['stimer-ctrl-btn', 'stimer-ctrl-primary', { paused: standaloneRunning }]" @click="toggleStandaloneTimer">
            <text class="stimer-ctrl-text">{{ standaloneRunning ? '暂停' : '开始' }}</text>
          </view>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="noteSheet" size="large" title="培训笔记" @update:visible="noteSheet = $event">
      <view class="note-phase-tag">
        <text class="note-phase-tag-text">{{ currentPhaseName }}</text>
      </view>
      <textarea v-model="noteContent" class="note-input" placeholder="记录本环节要点..."></textarea>
      <view class="note-saved-list">
        <view class="note-saved-item" v-for="(note, idx) in liveStore.notes" :key="idx">
          <text class="note-saved-phase">{{ note['phaseName'] as string }}</text>
          <text class="note-saved-content">{{ note['content'] as string }}</text>
          <text class="note-saved-time">{{ note['createdAt'] as string }}</text>
        </view>
      </view>
      <template #footer>
        <view class="sheet-footer-btn sheet-footer-btn-primary" @click="saveNote">
          <text class="sheet-footer-btn-text">保存笔记</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="showToolbox" size="large" title="工具箱" @update:visible="showToolbox = $event">
      <view class="toolbox-grid">
        <view class="toolbox-item" v-for="(tool, idx) in allTools" :key="idx" @click="openToolFromToolbox(tool)">
          <view class="toolbox-item-icon-box">
            <AppIcon :name="tool['iconName'] as string" size="40rpx" />
          </view>
          <text class="toolbox-item-name">{{ tool['name'] }}</text>
        </view>
      </view>
    </HalfSheet>

    <ConfirmDialog
      :visible="showExitDialog"
      title="确认退出"
      content="退出后将结束当前培训会话，确定要退出吗？"
      confirmText="退出"
      cancelText="继续"
      @confirm="confirmExit"
      @cancel="cancelExit"
    ></ConfirmDialog>
  </view>
</template>

