<sub-page-layout
  page-class="settings-page"
  title="设置"
  scroll-class="settings-scroll"
  content-class="settings-body"
  bindback="goBack"
>
  <view wx:for="{{sections}}" wx:key="title" class="section-card">
    <view class="section-title">{{item.title}}</view>
    <view wx:for="{{item.items}}" wx:for-item="setting" wx:key="key" class="setting-row" data-key="{{setting.key}}" bindtap="toggleSetting">
      <view class="setting-info">
        <view class="setting-title">{{setting.title}}</view>
        <view class="setting-desc">{{setting.desc}}</view>
      </view>
      <view class="switch {{setting.enabled ? 'active' : ''}}"><view></view></view>
    </view>
  </view>
</sub-page-layout>
