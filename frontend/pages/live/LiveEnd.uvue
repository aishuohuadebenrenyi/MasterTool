<script setup>
import { computed, ref } from 'vue'
import { useLiveStore } from '../../stores/live'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import { getSafeAreaBottom } from '../../utils/viewport'

const liveStore = useLiveStore()
const safeAreaBottom = ref<number>(getSafeAreaBottom())
const endedSessionId = ref<string>('')

const planName = computed(() : string => liveStore.planName || '培训')
const dataSessionId = computed<string>(() => endedSessionId.value || (liveStore.sessionId as string) || '')

const participantCount = computed(() : number => liveStore.participants.length)

const durationMinutes = computed(() : string => {
  const d = liveStore.duration
  if (d > 0) {
    return d + '分钟'
  }
  if (liveStore.startTime) {
    const elapsed = Math.floor((Date.now() - liveStore.startTime) / 1000)
    const mins = Math.floor(elapsed / 60)
    return mins > 0 ? mins + '分钟' : elapsed + '秒'
  }
  return '0分钟'
})

function goFeedback() {
  const sid = dataSessionId.value
  uni.navigateTo({ url: sid ? `/pages/feedback/index?sessionId=${sid}` : '/pages/feedback/index' })
}

function goReview() {
  if (liveStore.planId) {
    uni.navigateTo({ url: `/pages/review/ReviewDetail?planId=${liveStore.planId}` })
  } else {
    uni.navigateTo({ url: '/pages/review/ReviewCenter' })
  }
}

function goDataDetail() {
  const sid = dataSessionId.value
  if (sid) {
    uni.navigateTo({ url: `/pages/mine/DataDetail?sessionId=${sid}` })
  } else {
    uni.navigateTo({ url: '/pages/mine/DataDetail' })
  }
}

function goHome() {
  liveStore.reset()
  uni.switchTab({ url: '/pages/home/index' })
}

onLoad((options) => {
  if (options != null && options['sessionId'] != null) {
    endedSessionId.value = (options['sessionId'] as string) || ''
  }
})
</script>

<template>
  <view class="page">
    <NavBar title="培训结束" backgroundColor="#F5F5F7" titleColor="#1A1A2E" backIconColor="#1A1A2E" @back="goHome" />
    <view class="end-container" :style="{ paddingBottom: (safeAreaBottom + 32) + 'px' }">
      <view class="end-icon-wrap">
        <AppIcon name="soundCheer" size="84rpx" />
      </view>

      <text class="end-title">培训已结束</text>
      <text class="end-subtitle">{{ planName }}</text>

      <view class="stats-card">
        <view class="stat-item">
          <text class="stat-value">{{ participantCount }}</text>
          <text class="stat-label">参与人数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{ durationMinutes }}</text>
          <text class="stat-label">培训时长</text>
        </view>
      </view>

      <view class="action-list">
        <view class="action-btn action-btn-primary" @click="goFeedback">
          <view class="action-inline-icon">
            <AppIcon name="toolNote" size="22rpx" />
            <text class="action-btn-text">收集反馈</text>
          </view>
        </view>
        <view class="action-btn action-btn-secondary" @click="goReview">
          <view class="action-inline-icon">
            <AppIcon name="phaseReflection" size="22rpx" />
            <text class="action-btn-text">开始复盘</text>
          </view>
        </view>
        <view class="action-btn action-btn-secondary" @click="goDataDetail">
          <view class="action-inline-icon">
            <AppIcon name="stateChart" size="22rpx" />
            <text class="action-btn-text">查看数据</text>
          </view>
        </view>
        <view class="action-btn action-btn-ghost" @click="goHome">
          <text class="action-btn-text-ghost">返回首页</text>
        </view>
      </view>
    </view>
  </view>
</template>

