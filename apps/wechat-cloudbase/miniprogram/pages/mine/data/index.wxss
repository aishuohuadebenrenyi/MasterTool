@import "../../../styles/subpage.wxss";

.data-page {
  min-height: 100vh;
  background: #F5F5F7;
}

.data-scroll {
  height: 100vh;
}

.data-body {
  padding: 212rpx 32rpx 64rpx;
}

.summary-card,
.metric-card,
.chart-card {
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.07);
}

.summary-card {
  padding: 28rpx 32rpx;
}

.summary-title {
  color: #1A1A2E;
  font-size: 32rpx;
  font-weight: 900;
}

.summary-desc {
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 25rpx;
}

.range-toggle {
  display: flex;
  gap: 16rpx;
  margin: 22rpx 0;
}

.range-chip {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #8E8E93;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.range-chip.active {
  background: #4A7CF7;
  color: #FFFFFF;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.metric-card {
  padding: 28rpx 18rpx;
  text-align: center;
}

.metric-value {
  color: #4A7CF7;
  font-size: 36rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 23rpx;
}

.chart-card {
  margin-top: 22rpx;
  padding: 28rpx 32rpx;
}

.chart-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F5;
}

.chart-row:last-child {
  border-bottom: 0;
}

.chart-title {
  color: #1A1A2E;
  font-size: 29rpx;
  font-weight: 900;
}

.chart-empty {
  margin-top: 10rpx;
  color: #8E8E93;
  font-size: 25rpx;
}

.distribution-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.distribution-name {
  width: 150rpx;
  color: #1A1A2E;
  font-size: 25rpx;
  font-weight: 700;
}

.distribution-bar {
  flex: 1;
  height: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #F0F3FA;
}

.distribution-fill {
  height: 16rpx;
  border-radius: 8rpx;
  background: #4A7CF7;
}

.distribution-count {
  width: 54rpx;
  color: #8E8E93;
  font-size: 24rpx;
  text-align: right;
}
