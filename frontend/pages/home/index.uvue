<script setup>
import { ref, computed, onMounted, onUnmounted, watch } from 'vue'
import { usePlanStore } from '../../stores/plan'
import { useUserStore } from '../../stores/user'
import HalfSheet from '../../components/HalfSheet.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import { PLAN_TYPES } from '../../utils/constants'
import { calcNavBarInfo } from '../../utils/navbar'
import { getDesktopMaxWidth, getSafeAreaBottom } from '../../utils/viewport'

const planStore = usePlanStore()
const userStore = useUserStore()

const navBarInfo = calcNavBarInfo()
const statusBarHeight = navBarInfo['statusBarHeight'] as number
const contentTopOffset = navBarInfo['contentTopOffset'] as number
const navHorizontalPadding = navBarInfo['navHorizontalPadding'] as number
const rightSafeWidth = navBarInfo['rightSafeWidth'] as number
const homeHeaderHeight = contentTopOffset + 120
const safeAreaBottom = ref<number>(getSafeAreaBottom())
const pageMaxWidth = ref<number>(getDesktopMaxWidth())

const displayName = computed(() => userStore.displayName)

const greetingText = computed(() => {
  const hour = new Date().getHours()
  if (hour < 12) return '早上好'
  if (hour < 18) return '下午好'
  return '晚上好'
})

const dateText = computed(() => {
  const now = new Date()
  const month = now.getMonth() + 1
  const day = now.getDate()
  const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
  return `${month}月${day}日 ${weekdays[now.getDay()]}`
})

const reviewCount = computed(() => planStore.deliveredPlans.length)

const todos = computed(() => {
  const items : Array<UTSJSONObject> = []
  if (planStore.confirmedPlans.length > 0) {
    items.push({ iconSrc: '/static/icons/home-start.svg', label: `${planStore.confirmedPlans.length} 个方案待开课`, action: 'confirmed' })
  }
  if (planStore.deliveredPlans.length > 0) {
    items.push({ iconSrc: '/static/icons/home-review.svg', label: `${planStore.deliveredPlans.length} 场待复盘`, action: 'review' })
  }
  if (planStore.draftPlans.length > 0) {
    items.push({ iconName: 'stateDocument', label: `${planStore.draftPlans.length} 个草稿方案`, action: 'draft' })
  }
  return items
})

const showPlanSelect = ref<boolean>(false)
const showQuickCreate = ref<boolean>(false)
const showPrepConfirm = ref<boolean>(false)
const selectedPlanId = ref<string>('')

const flowTemplates : Array<UTSJSONObject> = [
  { id: 'corporate', iconName: 'typeCorporate', name: '企业培训', tag: '5段式', desc: '开场→活动→复盘→提炼→承诺', tools: ['签到', '计时器', '分组', '积分', '抽签'] },
  { id: 'teambuilding', iconName: 'typeTeam', name: '团建活动', tag: '三段式', desc: '破冰→团队挑战→轻松复盘', tools: ['签到', '分组', '积分', '音乐'] },
  { id: 'improv_show', iconName: 'typeShow', name: '即兴演出', tag: '游戏轮', desc: '暖场→即兴表演→观众互动→谢幕', tools: ['签到', '计时器', '抽签', '评分'] },
  { id: 'improv_training', iconName: 'typeTraining', name: '即兴训练', tag: '自由组合', desc: '热身→技能训练→综合练习', tools: ['签到', '计时器', '分组', '抽签'] }
]

const selectedTemplate = ref<UTSJSONObject | null>(null)
const trainingName = ref<string>('')
const peopleCount = ref<string>('')

const prepPeopleCount = ref<string>('')
const groupMethod = ref<string>('按人数均分')
const teamCount = ref<string>('待分组')
const scoreMode = ref<string>('简化模式')
const checkInMethod = ref<string>('扫码签到')

const showConfigEdit = ref<boolean>(false)
const configEditTitle = ref<string>('')
const configEditKey = ref<string>('')
const configEditOptions : Array<string> = []

const prepToolTags : Array<UTSJSONObject> = [
  { iconName: 'toolCheckin', name: '签到' },
  { iconName: 'toolGroup', name: '分组' },
  { iconName: 'toolScore', name: '积分' },
  { iconName: 'toolTimer', name: '计时' },
  { iconName: 'toolRandom', name: '抽签' },
  { iconName: 'soundTheme', name: '音乐' }
]

const filteredToolTags = computed(() => {
  if (!selectedTemplate.value) return [] as Array<UTSJSONObject>
  const tools = selectedTemplate.value['tools'] as Array<string>
  return prepToolTags.filter((tag : UTSJSONObject) => {
    const tagName = tag['name'] as string
    return tools.some((tool : string) => {
      return tool.indexOf(tagName) !== -1 || tagName.indexOf(tool) !== -1
    })
  })
})

function openPlanSelect() {
  showPlanSelect.value = true
}

function closePlanSelect() {
  showPlanSelect.value = false
}

function selectFromMyPlans() {
  showPlanSelect.value = false
  uni.switchTab({ url: '/pages/prepare/index' })
}

function selectTemplate(tpl : UTSJSONObject) {
  selectedTemplate.value = tpl
  trainingName.value = (tpl['name'] as string) || ''
  peopleCount.value = ''
  showPlanSelect.value = false
  setTimeout(() => {
    showQuickCreate.value = true
  }, 350)
}

function closeQuickCreate() {
  showQuickCreate.value = false
  selectedTemplate.value = null
  trainingName.value = ''
  peopleCount.value = ''
}

function submitQuickCreate() {
  if (!trainingName.value) return
  selectedPlanId.value = ''
  prepPeopleCount.value = peopleCount.value || '0'
  teamCount.value = '待分组'
  showQuickCreate.value = false
  setTimeout(() => {
    showPrepConfirm.value = true
  }, 350)
}

function closePrepConfirm() {
  showPrepConfirm.value = false
}

function openConfigEdit(key : string) {
  configEditKey.value = key
  if (key === 'checkin') {
    configEditTitle.value = '签到方式'
    configEditOptions.splice(0, configEditOptions.length, '扫码签到', '手动签到', '混合签到')
  } else if (key === 'group') {
    configEditTitle.value = '分组方式'
    configEditOptions.splice(0, configEditOptions.length, '按人数均分', '自由分组', '随机分组')
  } else if (key === 'score') {
    configEditTitle.value = '积分模式'
    configEditOptions.splice(0, configEditOptions.length, '简化模式', '详细模式', '无积分')
  }
  showConfigEdit.value = true
}

function closeConfigEdit() {
  showConfigEdit.value = false
}

function isOptionSelected(opt : string) : boolean {
  if (configEditKey.value === 'checkin') return checkInMethod.value === opt
  if (configEditKey.value === 'group') return groupMethod.value === opt
  if (configEditKey.value === 'score') return scoreMode.value === opt
  return false
}

function selectConfigOption(opt : string) {
  if (configEditKey.value === 'checkin') checkInMethod.value = opt
  else if (configEditKey.value === 'group') groupMethod.value = opt
  else if (configEditKey.value === 'score') scoreMode.value = opt
  closeConfigEdit()
}

function getTemplatePhases(key : string) : Array<UTSJSONObject> {
  if (key === (PLAN_TYPES['CORPORATE'] as string)) {
    return [
      { name: '开场连接', time: 15, color: '#FF6B35', iconName: 'phaseOpening' },
      { name: '主题导入', time: 20, color: '#007AFF', iconName: 'phaseTopic' },
      { name: '深度探索', time: 40, color: '#5856D6', iconName: 'phaseExplore' },
      { name: '实践应用', time: 30, color: '#34C759', iconName: 'phasePractice' },
      { name: '总结收束', time: 15, color: '#FF9500', iconName: 'phaseSummary' }
    ] as Array<UTSJSONObject>
  }
  if (key === (PLAN_TYPES['TEAMBUILDING'] as string)) {
    return [
      { name: '破冰热身', time: 20, color: '#FF6B35', iconName: 'phaseWarmup' },
      { name: '团队挑战', time: 60, color: '#007AFF', iconName: 'phasePractice' },
      { name: '分享庆祝', time: 20, color: '#34C759', iconName: 'phaseSummary' }
    ] as Array<UTSJSONObject>
  }
  if (key === (PLAN_TYPES['IMPROV_SHOW'] as string)) {
    return [
      { name: '暖场互动', time: 10, color: '#FF6B35', iconName: 'phaseWarmup' },
      { name: '即兴表演', time: 40, color: '#5856D6', iconName: 'phasePerformance' },
      { name: '观众互动', time: 15, color: '#007AFF', iconName: 'phaseAudience' },
      { name: '谢幕总结', time: 5, color: '#34C759', iconName: 'phaseClosing' }
    ] as Array<UTSJSONObject>
  }
  return [
    { name: '热身练习', time: 10, color: '#FF6B35', iconName: 'phaseWarmup' },
    { name: '技能训练', time: 30, color: '#007AFF', iconName: 'phaseSkill' },
    { name: '综合练习', time: 30, color: '#5856D6', iconName: 'phaseSimulation' }
  ] as Array<UTSJSONObject>
}

async function startLive() {
  showPrepConfirm.value = false
  try {
    let planId = selectedPlanId.value
    if (!planId && selectedTemplate.value != null) {
      const draft = await planStore.createPlan({
        name: trainingName.value,
        type: selectedTemplate.value['id'] as string,
        people: Number(prepPeopleCount.value || peopleCount.value || '0'),
        phases: getTemplatePhases(selectedTemplate.value['id'] as string),
        prepConfig: {
          headcount: Number(prepPeopleCount.value || peopleCount.value || '0'),
          checkinMode: checkInMethod.value,
          groupMode: groupMethod.value,
          groupCount: teamCount.value,
          scoreMode: scoreMode.value
        }
      } as UTSJSONObject)
      planId = draft['id'] as string
      await planStore.confirmPlan(planId)
    }
    if (!planId) {
      uni.showToast({ title: '缺少方案信息', icon: 'none' })
      return
    }
    uni.navigateTo({ url: `/pages/live/index?planId=${planId}` })
  } catch (_e : unknown) {
    uni.showToast({ title: '开课准备失败', icon: 'none' })
  }
}

function goReviewCenter() {
  uni.navigateTo({ url: '/pages/review/ReviewCenter' })
}

function handleTodoClick(action : string) {
  if (action === 'confirmed') {
    const confirmedPlan = planStore.confirmedPlans.length > 0 ? planStore.confirmedPlans[0] : null
    if (confirmedPlan) {
      selectedPlanId.value = confirmedPlan['id'] as string
      selectedTemplate.value = null
      trainingName.value = (confirmedPlan['name'] as string) || ''
      prepPeopleCount.value = String(confirmedPlan['people'] || 0)
      const prepConfig = (confirmedPlan['prepConfig'] as UTSJSONObject) || {} as UTSJSONObject
      checkInMethod.value = (prepConfig['checkinMode'] as string) || '扫码签到'
      groupMethod.value = (prepConfig['groupMode'] as string) || '按人数均分'
      teamCount.value = String(prepConfig['groupCount'] || '待分组')
      scoreMode.value = (prepConfig['scoreMode'] as string) || '简化模式'
      showPrepConfirm.value = true
    }
  } else if (action === 'review') {
    goReviewCenter()
  } else if (action === 'draft') {
    const draftPlan = planStore.draftPlans.length > 0 ? planStore.draftPlans[0] : null
    if (draftPlan) {
      uni.navigateTo({ url: `/pages/plan/PlanEdit?id=${draftPlan['id'] as string}` })
    } else {
      uni.switchTab({ url: '/pages/prepare/index' })
    }
  }
}

onMounted(() => {
  planStore.fetchPlans()
})

watch(() => showPlanSelect.value || showQuickCreate.value || showPrepConfirm.value || showConfigEdit.value, (visible : boolean) => {
  if (visible) {
    uni.hideTabBar({ animation: false })
  } else {
    uni.showTabBar({ animation: false })
  }
})

onUnmounted(() => {
  uni.showTabBar({ animation: false })
})
</script>

<template>
  <view class="page">
    <view class="nav-bar-fixed" :style="{ minHeight: homeHeaderHeight + 'px', paddingTop: contentTopOffset + 'px', paddingLeft: navHorizontalPadding + 'px', paddingRight: rightSafeWidth + 'px' }">
      <view class="greeting-bar" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
        <view class="greeting-left">
          <view class="avatar-small">
            <text class="avatar-text">{{ displayName.charAt(0) }}</text>
          </view>
          <text class="greeting-name">{{ displayName }}，{{ greetingText }}</text>
        </view>
        <text class="greeting-date">{{ dateText }}</text>
      </view>
    </view>
    <view :style="{ height: homeHeaderHeight + 'px' }"></view>

    <view class="scene-cards" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="scene-card-primary" @click="openPlanSelect">
        <view class="scene-card-decor"></view>
        <AppIcon class="scene-card-icon-image" src="/static/icons/home-start.svg" size="112rpx" />
        <text class="scene-card-title-primary">我要开课</text>
        <text class="scene-card-status-primary">开始一场培训</text>
      </view>
      <view class="scene-card-secondary" @click="goReviewCenter">
        <AppIcon class="scene-card-icon-sm-image" src="/static/icons/home-review.svg" size="64rpx" />
        <view class="scene-card-text-group">
          <text class="scene-card-title-secondary">我要复盘</text>
          <text class="scene-card-status-secondary" v-if="reviewCount > 0">{{ reviewCount }}场待复盘</text>
          <text class="scene-card-status-secondary" v-else>暂无待复盘</text>
        </view>
      </view>
    </view>

    <view class="section-header" v-if="todos.length > 0" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <text class="section-title">待处理</text>
    </view>
    <view class="todo-list" v-if="todos.length > 0" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="todo-item" v-for="(item, index) in todos" :key="index" @click="handleTodoClick(item['action'] as string)">
        <AppIcon v-if="item['iconName'] || item['iconSrc']" class="todo-icon" :name="item['iconName'] as string" :src="item['iconSrc'] as string" size="36rpx" />
        <text class="todo-text">{{ item['label'] }}</text>
        <AppIcon name="stateChevronRight" size="24rpx" />
      </view>
    </view>

    <HalfSheet :visible="showPlanSelect" title="选择流程模板" @update:visible="showPlanSelect = $event">
      <view class="my-plan-option" @click="selectFromMyPlans">
        <view class="my-plan-icon-box">
          <AppIcon name="stateDocument" size="36rpx" />
        </view>
        <view class="my-plan-info">
          <text class="my-plan-title">从我的方案</text>
          <text class="my-plan-desc">选择已有方案直接开课</text>
        </view>
        <AppIcon name="stateChevronRight" size="24rpx" />
      </view>
      <view class="template-section-label">
        <text class="template-section-text">流程模板</text>
      </view>
      <view class="template-card" v-for="(tpl, idx) in flowTemplates" :key="idx" @click="selectTemplate(tpl)">
        <view class="template-card-icon-box">
          <AppIcon :name="tpl['iconName'] as string" size="44rpx" />
        </view>
        <view class="template-card-info">
          <view class="template-card-name-row">
            <text class="template-card-name">{{ tpl['name'] }}</text>
            <view class="template-card-badge">
              <text class="template-card-badge-text">{{ tpl['tag'] }}</text>
            </view>
          </view>
          <text class="template-card-desc">{{ tpl['desc'] }}</text>
        </view>
        <AppIcon name="stateChevronRight" size="24rpx" />
      </view>
    </HalfSheet>

    <HalfSheet :visible="showQuickCreate" title="快速创建" @update:visible="showQuickCreate = $event">
      <view class="form-group" v-if="selectedTemplate">
        <text class="form-label">选择模板</text>
        <view class="template-badge">
          <AppIcon :name="selectedTemplate['iconName'] as string" size="28rpx" />
          <text class="template-badge-text">{{ selectedTemplate['name'] }}</text>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">培训名称</text>
        <input class="form-input" v-model="trainingName" placeholder="请输入培训名称" />
      </view>
      <view class="form-group">
        <text class="form-label">预计人数</text>
        <input class="form-input" v-model="peopleCount" type="number" placeholder="请输入参与人数" />
      </view>
      <template #footer>
        <view class="submit-btn" @click="submitQuickCreate">
          <text class="submit-btn-text">创建并准备</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="showPrepConfirm" title="准备确认" @update:visible="showPrepConfirm = $event">
      <view class="prep-plan-info" v-if="selectedTemplate">
        <text class="prep-plan-name">{{ trainingName }}</text>
        <view class="prep-plan-tags">
          <view class="prep-plan-tag">
            <view class="prep-plan-tag-inner">
              <AppIcon :name="selectedTemplate['iconName'] as string" size="24rpx" />
              <text class="prep-plan-tag-text">{{ selectedTemplate['name'] }}</text>
            </view>
          </view>
          <view class="prep-plan-tag prep-plan-tag-people">
            <view class="prep-plan-tag-inner">
              <AppIcon name="statePeople" size="24rpx" />
              <text class="prep-plan-tag-text">{{ prepPeopleCount }}人</text>
            </view>
          </view>
        </view>
      </view>

      <view class="prep-section">
        <view class="prep-section-header">
          <text class="prep-section-title">签到配置</text>
        </view>
        <view class="prep-edit-row" @click="openConfigEdit('checkin')">
          <text class="prep-edit-label">签到方式</text>
          <view class="prep-edit-right">
            <text class="prep-edit-value">{{ checkInMethod }}</text>
            <AppIcon name="stateChevronRight" size="20rpx" />
          </view>
        </view>
      </view>

      <view class="prep-section">
        <view class="prep-section-header">
          <text class="prep-section-title">分组配置</text>
        </view>
        <view class="prep-edit-row" @click="openConfigEdit('group')">
          <text class="prep-edit-label">分组方式</text>
          <view class="prep-edit-right">
            <text class="prep-edit-value">{{ groupMethod }}</text>
            <AppIcon name="stateChevronRight" size="20rpx" />
          </view>
        </view>
      </view>

      <view class="prep-section">
        <view class="prep-section-header">
          <text class="prep-section-title">积分配置</text>
        </view>
        <view class="prep-edit-row" @click="openConfigEdit('score')">
          <text class="prep-edit-label">积分模式</text>
          <view class="prep-edit-right">
            <text class="prep-edit-value">{{ scoreMode }}</text>
            <AppIcon name="stateChevronRight" size="20rpx" />
          </view>
        </view>
      </view>

      <view class="prep-section" v-if="selectedTemplate">
        <view class="prep-section-header">
          <text class="prep-section-title">工具配置</text>
        </view>
        <view class="prep-tools-card">
          <view class="prep-tool-tag" v-for="(tool, idx) in filteredToolTags" :key="idx">
            <view class="prep-tool-tag-inner">
              <AppIcon :name="tool['iconName'] as string" size="22rpx" />
              <text class="prep-tool-tag-text">{{ tool['name'] }}</text>
            </view>
          </view>
        </view>
      </view>

      <template #footer>
        <view class="submit-btn" @click="startLive">
          <text class="submit-btn-text">一键开始</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="showConfigEdit" :title="configEditTitle" @update:visible="showConfigEdit = $event">
      <view class="config-option" v-for="(opt, idx) in configEditOptions" :key="idx" @click="selectConfigOption(opt)">
        <text class="config-option-text">{{ opt }}</text>
        <AppIcon v-if="isOptionSelected(opt)" name="stateCheck" size="20rpx" />
      </view>
    </HalfSheet>
  </view>
</template>

<style scoped>
.page {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding: 0 32rpx;
}
.nav-bar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #F5F5F7;
}
.nav-bar-content {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.greeting-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  width: 100%;
  margin: 0 auto;
}
.greeting-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}
.avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #4A7CF7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.greeting-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.greeting-date {
  font-size: 26rpx;
  color: #8E8E93;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.scene-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
}
.scene-card-primary {
  background: linear-gradient(135deg, #4A7CF7, #6B9BFF);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  position: relative;
  overflow: hidden;
}
.scene-card-decor {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(255, 255, 255, 0.1);
}
.scene-card-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.scene-card-icon-image {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
}
.scene-card-title-primary {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}
.scene-card-status-primary {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}
.scene-card-secondary {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.08);
}
.scene-card-icon-sm {
  font-size: 56rpx;
}
.scene-card-icon-sm-image {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.scene-card-text-group {
  display: flex;
  flex-direction: column;
}
.scene-card-title-secondary {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
