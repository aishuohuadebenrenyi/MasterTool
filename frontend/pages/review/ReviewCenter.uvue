<script setup>
import { ref, computed, onMounted } from 'vue'
import { usePlanStore } from '../../stores/plan'
import { PLAN_TYPE_LABELS, PLAN_STATUS } from '../../utils/constants'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'

const planStore = usePlanStore()

const reviewFilter = ref<string>('全部')
const reviewFilters = ['全部', '待复盘', '已复盘'] as string[]

const filteredPlans = computed(() => {
  let list = [...planStore.deliveredPlans, ...planStore.reviewedPlans] as Array<UTSJSONObject>
  if (reviewFilter.value === '待复盘') {
    list = list.filter(p => (p['status'] as string) !== (PLAN_STATUS['REVIEWED'] as string))
  } else if (reviewFilter.value === '已复盘') {
    list = list.filter(p => (p['status'] as string) === (PLAN_STATUS['REVIEWED'] as string))
  }
  return list
})

function getTypeLabel(type : string) : string {
  return (PLAN_TYPE_LABELS[type] as string) || '未知类型'
}

function isReviewed(plan : UTSJSONObject) : boolean {
  return (plan['status'] as string) === (PLAN_STATUS['REVIEWED'] as string)
}

function goBack() {
  uni.navigateBack({})
}

function goReviewDetail(planId : string) {
  uni.navigateTo({ url: `/pages/review/ReviewDetail?planId=${planId}` })
}

function startReview(planId : string) {
  uni.navigateTo({ url: `/pages/review/ReviewDetail?planId=${planId}` })
}

onMounted(() => {
  planStore.fetchPlans()
})
</script>

<template>
  <view class="page">
    <NavBar title="复盘中心" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack" />

    <view class="filter-bar">
      <view
        class="filter-tab"
        :class="{ 'filter-tab-active': reviewFilter === item }"
        v-for="(item, idx) in reviewFilters"
        :key="idx"
        @click="reviewFilter = item"
      >
        <text class="filter-tab-text" :class="{ 'filter-tab-text-active': reviewFilter === item }">{{ item }}</text>
      </view>
    </view>

    <view class="page-content" v-if="filteredPlans.length > 0">
      <view
        class="review-card"
        v-for="plan in filteredPlans"
        :key="plan['id'] as string"
      >
        <view class="review-card-header">
          <text class="review-name">{{ plan['name'] as string }}</text>
          <view :class="['review-status-badge', isReviewed(plan) ? 'review-status-done' : 'review-status-pending']">
            <text :class="['review-status-text', isReviewed(plan) ? 'review-status-text-done' : 'review-status-text-pending']">{{ isReviewed(plan) ? '已复盘' : '待复盘' }}</text>
          </view>
        </view>
        <view class="review-card-body">
          <view class="review-meta-row">
            <AppIcon name="stateCalendar" size="18rpx" />
            <text class="review-meta-text">{{ plan['date'] as string || '未指定日期' }}</text>
          </view>
          <view class="review-meta-row">
            <AppIcon name="stateTag" size="18rpx" />
            <text class="review-meta-text">{{ getTypeLabel(plan['type'] as string) }}</text>
          </view>
        </view>
        <view class="review-card-footer" v-if="!isReviewed(plan)">
          <view class="btn-review" @click="startReview(plan['id'] as string)">
            <text class="btn-review-text">开始复盘</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" v-else>
      <AppIcon name="stateDocument" size="60rpx" />
      <text class="empty-title">暂无需要复盘的内容</text>
      <text class="empty-subtitle">完成培训后可在此进行复盘</text>
    </view>
  </view>
</template>

