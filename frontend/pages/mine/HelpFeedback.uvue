<script setup>
import { ref } from 'vue'
import * as userApi from '../../api/user'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'

const faqList = ref<Array<UTSJSONObject>>([
  { question: '如何创建新的培训方案？', answer: '在备课页面点击右上角的"+"按钮，选择培训类型并填写基本信息即可创建新的培训方案。', expanded: false },
  { question: '如何使用手势控制功能？', answer: '在培训现场页面，右滑推进到下一步，左滑回退到上一步，双击屏幕可启动延时计时。可在设置中开启或关闭各项手势。', expanded: false },
  { question: '培训数据如何统计？', answer: '系统会自动记录每次培训的参与人数、满意度评分和NPS数据，您可以在"数据详情"页面查看趋势图表和统计信息。', expanded: false },
  { question: '如何导出培训记录？', answer: '在培训记录页面，点击右上角的导出按钮，选择需要导出的记录和格式，即可生成文件并分享。', expanded: false },
  { question: '如何修改个人信息？', answer: '在"我的"页面点击头像旁边的"编辑"按钮，即可修改昵称、头像等个人信息。' }
] as Array<UTSJSONObject>)

const feedbackText = ref<string>('')
const contactText = ref<string>('')
const submitting = ref<boolean>(false)

function toggleFaq(index : number) {
  const item = faqList.value[index]
  item['expanded'] = !item['expanded']
}

async function submitFeedback() {
  if (feedbackText.value.trim() === '') return
  submitting.value = true
  try {
    await userApi.submitUserFeedback({
      content: feedbackText.value.trim(),
      contact: contactText.value.trim(),
      category: 'help_feedback'
    } as UTSJSONObject)
    uni.showToast({ title: '感谢您的反馈', icon: 'success' })
    feedbackText.value = ''
    contactText.value = ''
  } finally {
    submitting.value = false
  }
}
</script>

<template>
  <view class="page">
    <NavBar title="帮助与反馈" @back="uni.navigateBack()" />

    <scroll-view class="content" scroll-y>
      <view class="section-card">
        <text class="section-title">常见问题</text>
        <view
          v-for="(item, index) in faqList"
          :key="index"
          class="faq-item"
        >
          <view class="faq-question" @click="toggleFaq(index)">
            <text class="faq-question-text">{{ item['question'] }}</text>
            <view :class="['faq-arrow', item['expanded'] ? 'faq-arrow-up' : '']">
              <AppIcon name="stateChevronRight" size="18rpx" />
            </view>
          </view>
          <view v-if="item['expanded']" class="faq-answer">
            <text class="faq-answer-text">{{ item['answer'] }}</text>
          </view>
        </view>
      </view>

      <view class="section-card">
        <text class="section-title">意见反馈</text>
        <view class="feedback-form">
          <input
            class="feedback-input"
            v-model="contactText"
            placeholder="选填：联系方式，便于我们跟进"
            maxlength="100"
          />
          <textarea
            class="feedback-textarea"
            v-model="feedbackText"
            placeholder="请输入您的意见或建议..."
            :maxlength="500"
          />
          <view class="feedback-footer">
            <text class="feedback-count">{{ feedbackText.length }}/500</text>
            <view :class="['feedback-submit', submitting ? 'feedback-submit-disabled' : '']" @click="submitFeedback">
              <text class="feedback-submit-text">{{ submitting ? '提交中...' : '提交' }}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

