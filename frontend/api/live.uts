import { get, post } from './request'

export function startLiveSession(data : UTSJSONObject) : Promise<UTSJSONObject> {
  return post('/live/start', data, { showLoading: true, loadingText: '正在开课...' })
}

export function endLiveSession(sessionId : string) : Promise<UTSJSONObject> {
  return post('/live/end', { sessionId }, { showLoading: true, loadingText: '正在结束...' })
}

export function checkin(sessionId : string | null, data : UTSJSONObject) : Promise<UTSJSONObject> {
  return post('/live/checkin', { sessionId, ...data }, { showError: false })
}

export function getCheckinList(sessionId : string) : Promise<UTSJSONObject> {
  return get('/live/checkin/list', { sessionId })
}

export function createGroup(sessionId : string | null, data : UTSJSONObject) : Promise<UTSJSONObject> {
  return post('/live/group', { sessionId, ...data })
}

export function updateScore(sessionId : string | null, data : UTSJSONObject) : Promise<UTSJSONObject> {
  return post('/live/score', { sessionId, ...data })
}

export function randomPick(sessionId : string | null, data : UTSJSONObject) : Promise<UTSJSONObject> {
  return post('/live/pick', { sessionId, ...data })
}
