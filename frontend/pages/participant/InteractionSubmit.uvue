<script setup>
import { ref, computed } from 'vue'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import * as interactionApi from '../../api/interaction'
import { getDesktopMaxWidth } from '../../utils/viewport'
import { showSuccess, showInfo } from '../../utils/toast'

const pageMaxWidth = getDesktopMaxWidth()
const interactionId = ref<string>('')
const joinCode = ref<string>('')
const interaction = ref<UTSJSONObject>({} as UTSJSONObject)
const loading = ref<boolean>(true)
const submitting = ref<boolean>(false)
const errorMessage = ref<string>('')
const content = ref<string>('')
const selectedOption = ref<number>(-1)
const name = ref<string>('')

const interactionType = computed<string>(() => (interaction.value['type'] as string) || '')
const title = computed<string>(() => (interaction.value['title'] as string) || '互动提交')
const options = computed<Array<UTSJSONObject>>(() => (interaction.value['options'] as Array<UTSJSONObject>) || [] as Array<UTSJSONObject>)
const isOpen = computed<boolean>(() => ((interaction.value['status'] as string) || 'open') === 'open')
const submitText = computed<string>(() => submitting.value ? '提交中...' : '提交')
const inputPlaceholder = computed<string>(() => {
  if (interactionType.value === 'promise') return '写下你的行动承诺'
  return '输入一个关键词'
})
const typeIcon = computed<string>(() => {
  if (interactionType.value === 'vote') return 'stateChart'
  if (interactionType.value === 'promise') return 'statePromise'
  return 'stateCloud'
})

onLoad((optionsParam) => {
  if (optionsParam != null) {
    interactionId.value = (optionsParam['interactionId'] as string) || ''
    joinCode.value = (optionsParam['code'] as string) || ''
  }
  loadDetail()
})

function goBack() {
  uni.navigateBack()
}

async function loadDetail() {
  if (!interactionId.value || !joinCode.value) {
    loading.value = false
    errorMessage.value = '互动入口无效'
    return
  }
  loading.value = true
  errorMessage.value = ''
  try {
    interaction.value = await interactionApi.getInteractionDetail(interactionId.value, joinCode.value)
  } catch (e : unknown) {
    errorMessage.value = e instanceof Error ? e.message : '互动加载失败'
  } finally {
    loading.value = false
  }
}

function chooseOption(index : number) {
  if (!isOpen.value) return
  selectedOption.value = index
}

async function submit() {
  if (submitting.value || !isOpen.value) return
  const type = interactionType.value
  if (type === 'vote' && selectedOption.value < 0) {
    showInfo('请选择一个选项')
    return
  }
  const trimmed = content.value.trim()
  if (type !== 'vote' && !trimmed) {
    showInfo('请输入内容')
    return
  }
  submitting.value = true
  try {
    await interactionApi.submitInteraction({
      interactionId: interactionId.value,
      code: joinCode.value,
      content: trimmed,
      optionIndex: selectedOption.value,
      name: name.value.trim(),
      anonymous: !name.value.trim()
    } as UTSJSONObject)
    showSuccess('提交成功')
    content.value = ''
    selectedOption.value = -1
  } catch (_e : unknown) {
  } finally {
    submitting.value = false
  }
}
</script>

<template>
  <view class="page app-secondary-page">
    <NavBar :title="title" backgroundColor="#FFFFFF" titleColor="#111827" backIconColor="#333333" @back="goBack" />

    <view class="content app-secondary-page-content" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view v-if="loading" class="state-card">
        <text class="state-text">正在加载互动...</text>
      </view>

      <view v-else-if="errorMessage" class="state-card">
        <AppIcon name="stateWarning" size="44rpx" />
        <text class="state-title">入口不可用</text>
        <text class="state-text">{{ errorMessage }}</text>
      </view>

      <view v-else class="submit-card">
        <view class="submit-header">
          <view class="submit-icon">
            <AppIcon :name="typeIcon" size="42rpx" />
          </view>
          <view class="submit-title-group">
            <text class="submit-title">{{ title }}</text>
            <text class="submit-desc">{{ isOpen ? '请完成本次互动提交' : '互动已结束' }}</text>
          </view>
        </view>

        <view v-if="interactionType === 'vote'" class="vote-options">
          <view
            v-for="(item, idx) in options"
            :key="idx"
            :class="['vote-option', { active: selectedOption === idx }]"
            @click="chooseOption(idx)"
          >
            <text class="vote-option-label">{{ item['label'] as string }}</text>
            <AppIcon v-if="selectedOption === idx" name="stateCheck" size="28rpx" />
          </view>
        </view>

        <view v-else class="form-group">
          <textarea
            class="submit-textarea"
            v-model="content"
            :placeholder="inputPlaceholder"
            placeholder-class="input-placeholder"
            :maxlength="interactionType === 'promise' ? 200 : 80"
          />
        </view>

        <view class="form-group">
          <input class="name-input" v-model="name" placeholder="昵称，可不填" placeholder-class="input-placeholder" />
        </view>

        <view :class="['submit-btn', { disabled: submitting || !isOpen }]" @click="submit">
          <text class="submit-btn-text">{{ submitText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<style lang="scss" scoped>
.page {
  min-height: 100vh;
  background-color: #F5F6FA;
}

.content {
  margin: 0 auto;
  padding: 28rpx;
}

.state-card,
.submit-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.06);
}

.state-card {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.state-text {
  font-size: 28rpx;
  color: #8E8E93;
  text-align: center;
}

.submit-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 32rpx;
}

.submit-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background-color: #EEF3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.submit-title-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.submit-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.submit-desc {
  font-size: 26rpx;
  color: #8E8E93;
}

.vote-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.vote-option {
  min-height: 96rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  border: 2rpx solid transparent;
  padding: 0 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.vote-option.active {
  background-color: #EEF3FF;
  border-color: #4A7CF7;
}

.vote-option-label {
  font-size: 30rpx;
  color: #1A1A2E;
  font-weight: 600;
}

.form-group {
  margin-bottom: 24rpx;
}

.submit-textarea {
  width: 100%;
  min-height: 220rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  padding: 22rpx;
  font-size: 30rpx;
  color: #1A1A2E;
  box-sizing: border-box;
}

.name-input {
  height: 88rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #1A1A2E;
}

.input-placeholder {
  color: #B8BCC8;
}

.submit-btn {
  height: 92rpx;
  border-radius: 20rpx;
  background-color: #4A7CF7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  opacity: 0.48;
}

.submit-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
</style>
