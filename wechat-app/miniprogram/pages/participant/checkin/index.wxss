.checkin-page {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 176rpx 32rpx 48rpx;
}

.participant-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: 176rpx;
  box-sizing: border-box;
  padding: 88rpx 32rpx 0;
  background: #F5F6FA;
}

.participant-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #3A3F4B;
  font-size: 50rpx;
  line-height: 1;
}

.participant-title {
  position: absolute;
  right: 128rpx;
  left: 128rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  text-align: center;
}

.checkin-panel {
  width: 100%;
  padding: 48rpx 32rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 900;
  color: #151827;
  text-align: center;
}

.subtitle {
  margin-top: 12rpx;
  color: #8A8F99;
  font-size: 28rpx;
  text-align: center;
}

.input {
  height: 96rpx;
  box-sizing: border-box;
  margin: 48rpx 0 28rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E8EBF2;
  border-radius: 20rpx;
  background: #fff;
  font-size: 32rpx;
}

.disabled {
  opacity: 0.7;
}
