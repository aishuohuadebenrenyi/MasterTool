<script setup>
import { ref, computed, onMounted } from 'vue'
import { useReviewStore } from '../../stores/review'
import { usePlanStore } from '../../stores/plan'
import { PLAN_STATUS, getPlanTypeLabel } from '../../utils/constants'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import { showSuccess, showError } from '../../utils/toast'

const reviewStore = useReviewStore()
const planStore = usePlanStore()

const planId = ref<string>('')
const reviewId = ref<string>('')
const currentMethod = ref<string>('ORID')
const currentIndex = ref<number>(0)
const reviewNotes = ref<Array<string>>([])
const feedbackStats = ref<UTSJSONObject>({} as UTSJSONObject)
const feedbackList = ref<Array<UTSJSONObject>>([])

const REVIEW_QUESTIONS : UTSJSONObject = {
  'ORID': [
    'O-客观：刚才的活动中，你观察到了什么？',
    'R-感受：这让你有什么感受？',
    'I-思考：这让你想到了什么？有什么启发？',
    'D-决定：接下来你会怎么做？'
  ] as Array<string>,
  '4F': [
    'Facts-事实：发生了什么事？',
    'Feelings-感受：你有什么感受？',
    'Findings-发现：你发现了什么？',
    'Future-未来：未来你会怎么做？'
  ] as Array<string>,
  'SSC': [
    'S-Stop：有什么需要停止做的？',
    'S-Start：有什么需要开始做的？',
    'C-Continue：有什么需要继续做的？'
  ] as Array<string>
}

const METHOD_OPTIONS : Array<string> = ['ORID', '4F', 'SSC']
const METHOD_TO_API : UTSJSONObject = {
  'ORID': 'orid',
  '4F': '4f',
  'SSC': 'ssc'
}
const API_TO_METHOD : UTSJSONObject = {
  'orid': 'ORID',
  '4f': '4F',
  'ssc': 'SSC'
}

const plan = computed<UTSJSONObject | null>(() => planStore.currentPlan)

const isReviewed = computed<boolean>(() => {
  if (plan.value == null) return false
  return (plan.value!['status'] as string) === PLAN_STATUS['REVIEWED'] as string
})

const planName = computed<string>(() => {
  if (plan.value == null) return '培训方案'
  return (plan.value!['name'] as string) || '培训方案'
})

const planTypeLabel = computed<string>(() => {
  if (plan.value == null) return ''
  const t = plan.value!['type'] as string
  return getPlanTypeLabel(t)
})

const planPeople = computed<string>(() => {
  if (plan.value == null) return '0'
  const p = plan.value!['people']
  if (p == null) return '0'
  return String(p)
})

const planDate = computed<string>(() => {
  if (plan.value == null) return ''
  return (plan.value!['date'] as string) || ''
})

const planDuration = computed<string>(() => {
  if (plan.value == null) return '0min'
  const d = plan.value!['duration']
  if (d == null) return '0min'
  const mins = Number(d)
  const h = Math.floor(mins / 60)
  const m = mins % 60
  if (h > 0 && m > 0) return h + 'h' + m + 'min'
  if (h > 0) return h + 'h'
  return m + 'min'
})

const phaseCount = computed<number>(() => {
  if (plan.value == null) return 0
  const phases = plan.value!['phases']
  if (phases == null) return 0
  return (phases as Array<UTSJSONObject>).length
})

const completedPhases = computed<number>(() => {
  if (isReviewed.value) return phaseCount.value
  return Math.max(1, Math.floor(phaseCount.value * 0.6))
})

const progressPct = computed<number>(() => {
  if (phaseCount.value === 0) return 0
  return Math.round(completedPhases.value / phaseCount.value * 100)
})

const questions = computed<Array<string>>(() => {
  const qs = REVIEW_QUESTIONS[currentMethod.value] as Array<string>
  return qs || []
})

const currentQuestion = computed<string>(() => {
  const qs = questions.value
  if (qs.length === 0) return ''
  return qs[currentIndex.value] || ''
})

const isLastQuestion = computed<boolean>(() => {
  return currentIndex.value >= questions.value.length - 1
})

const avgSatisfaction = computed<string>(() => {
  const v = feedbackStats.value['avgSatisfaction']
  if (v == null) return '4.6'
  return Number(v).toFixed(1)
})

const feedbackCount = computed<string>(() => {
  const v = feedbackStats.value['count']
  if (v == null) return '0'
  return String(v)
})

const npsScore = computed<string>(() => {
  const v = feedbackStats.value['nps']
  if (v == null) return '0'
  return String(v)
})

const fiveStarRate = computed<string>(() => {
  const v = feedbackStats.value['fiveStarRate']
  if (v == null) return '0%'
  return Math.round(Number(v) * 100) + '%'
})

const keywords = ref<Array<string>>(['团队协作', '专业', '互动好', '节奏快'])

const feedbackQuotes = computed<Array<string>>(() => {
  const result : Array<string> = []
  const list = feedbackList.value
  const count = Math.min(list.length, 3)
  for (let i = 0; i < count; i++) {
    const text = list[i]['text'] as string
    if (text != null && text.length > 0) {
      result.push(text)
    }
  }
  if (result.length === 0) {
    result.push('非常棒的培训体验，收获很大！')
    result.push('整体不错，但时间可以再充裕一些')
    result.push('培训师很专业，互动环节设计得很好')
  }
  return result
})

function saveCurrentNote(noteText : string) {
  if (currentIndex.value < reviewNotes.value.length) {
    reviewNotes.value[currentIndex.value] = noteText
  } else {
    while (reviewNotes.value.length <= currentIndex.value) {
      reviewNotes.value.push('')
    }
    reviewNotes.value[currentIndex.value] = noteText
  }
}

function switchMethod(method : string) {
  currentMethod.value = method
  if (currentIndex.value >= questions.value.length) {
    currentIndex.value = 0
  }
}

function prevQuestion() {
  if (currentIndex.value > 0) {
    currentIndex.value--
  }
}

function nextQuestion() {
  if (isLastQuestion.value) {
    completeReview()
    return
  }
  currentIndex.value++
}

async function completeReview() {
  if (plan.value == null || reviewId.value.length === 0) return
  try {
    await reviewStore.saveReview(reviewId.value, {
      method: METHOD_TO_API[currentMethod.value] as string,
      reviewNotes: reviewNotes.value,
      status: 'reviewed',
      isCompleted: true
    } as UTSJSONObject)
    await planStore.fetchPlanDetail(plan.value!['id'] as string)
    showSuccess('复盘完成')
    setTimeout(() => {
      uni.navigateBack({})
    }, 1500)
  } catch (e : unknown) {
    showError('保存失败')
  }
}

function goBack() {
  uni.navigateBack({})
}

function goFeedback() {
  if (plan.value != null) {
    const sessionId = plan.value!['sessionId'] as string
    if (sessionId != null && sessionId.length > 0) {
      uni.navigateTo({ url: `/pages/feedback/index?sessionId=${sessionId}` })
    } else {
      uni.navigateTo({ url: '/pages/feedback/index' })
    }
  } else {
    uni.navigateTo({ url: '/pages/feedback/index' })
  }
}

onMounted(async () => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = (currentPage as any).$page.options || (currentPage as any).options || {}
  const id = options.planId || options.id || ''
  planId.value = id as string

  if (planId.value.length > 0) {
    await planStore.fetchPlanDetail(planId.value)
    const sessionId = planStore.currentPlan?.['sessionId'] as string
    if (sessionId != null && sessionId.length > 0) {
      try {
        const { getFeedbackStats, getFeedbackList } = await import('../../api/feedback')
        const stats = await getFeedbackStats(sessionId)
        feedbackStats.value = stats
        const listData = await getFeedbackList(sessionId)
        feedbackList.value = (listData['list'] as Array<UTSJSONObject>) || []
      } catch (_e : unknown) {
        feedbackStats.value = {} as UTSJSONObject
        feedbackList.value = []
      }
    }

    try {
      const review = await reviewStore.startReview({
        planId: planId.value,
        planName: planStore.currentPlan?.['name'] || '',
        sessionId
      } as UTSJSONObject)
      reviewId.value = (review['id'] as string) || ''
      const savedMethod = (review['method'] as string) || (planStore.currentPlan?.['reviewMethod'] as string) || ''
      const savedNotes = (review['reviewNotes'] as Array<string>) || (planStore.currentPlan?.['reviewNotes'] as Array<string>) || [] as Array<string>
      if (savedMethod != null && savedMethod.length > 0) {
        currentMethod.value = (API_TO_METHOD[savedMethod] as string) || savedMethod
      }
      if (savedNotes != null) {
        reviewNotes.value = savedNotes
      }
    } catch (_e : unknown) {
      if (isReviewed.value && planStore.currentPlan != null) {
        const savedMethod = planStore.currentPlan!['reviewMethod'] as string
        const savedNotes = planStore.currentPlan!['reviewNotes'] as Array<string>
        if (savedMethod != null && savedMethod.length > 0) {
          currentMethod.value = (API_TO_METHOD[savedMethod] as string) || savedMethod
        }
        if (savedNotes != null) {
          reviewNotes.value = savedNotes
        }
      }
    }
  }
})
</script>

<template>
  <view class="page">
    <NavBar title="复盘详情" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack" />

    <scroll-view class="page-scroll" scroll-y>
      <view class="page-content">
        <view class="review-detail-summary">
          <view class="review-summary-card">
            <text class="review-summary-title">{{ planName }}</text>
            <view class="review-summary-meta">
              <text class="meta-text">{{ planTypeLabel }}</text>
              <text class="meta-dot">·</text>
              <view class="review-inline-icon">
                <AppIcon name="statePeople" size="26rpx" />
                <text class="meta-text">{{ planPeople }}人</text>
              </view>
              <text class="meta-dot">·</text>
              <view class="review-inline-icon">
                <AppIcon name="stateCalendar" size="26rpx" />
                <text class="meta-text">{{ planDate }}</text>
              </view>
            </view>
            <view class="review-summary-meta" style="margin-top: 6rpx">
              <view class="review-inline-icon">
                <AppIcon name="stateDuration" size="26rpx" />
                <text class="meta-text">{{ planDuration }}</text>
              </view>
              <text class="meta-dot">·</text>
              <view class="review-inline-icon">
                <AppIcon name="stateChart" size="26rpx" />
                <text class="meta-text">环节 {{ completedPhases }}/{{ phaseCount }} 完成</text>
              </view>
            </view>
            <view class="review-phase-progress">
              <view class="review-phase-bar" :style="{ width: progressPct + '%' }"></view>
            </view>
          </view>
        </view>

        <view class="review-detail-feedback">
          <view class="review-feedback-card">
            <view class="review-feedback-header">
              <view class="review-inline-icon">
                <AppIcon name="stateChart" size="28rpx" />
                <text class="review-feedback-section-title">数据回顾</text>
              </view>
              <view v-if="!isReviewed" class="review-inline-icon review-feedback-link" @click="goFeedback">
                <text>查看完整反馈</text>
                <AppIcon name="stateChevronRight" size="18rpx" />
              </view>
            </view>
            <view class="review-feedback-row">
              <view class="review-feedback-item">
                <text class="review-feedback-value">{{ avgSatisfaction }}</text>
                <text class="review-feedback-label">满意度</text>
              </view>
              <view class="review-feedback-item">
                <text class="review-feedback-value">{{ feedbackCount }}</text>
                <text class="review-feedback-label">反馈数</text>
              </view>
              <view class="review-feedback-item">
                <text class="review-feedback-value">{{ npsScore }}</text>
                <text class="review-feedback-label">NPS</text>
              </view>
              <view class="review-feedback-item">
                <text class="review-feedback-value">{{ fiveStarRate }}</text>
                <text class="review-feedback-label">5星占比</text>
              </view>
            </view>
            <view class="review-feedback-keywords">
              <text class="review-kw" v-for="(kw, idx) in keywords" :key="idx">{{ kw }}</text>
            </view>
            <view class="review-feedback-quotes">
              <view class="review-feedback-quote" v-for="(quote, idx) in feedbackQuotes" :key="idx">
                <text class="quote-text">"{{ quote }}"</text>
              </view>
            </view>
          </view>
        </view>

        <view class="review-detail-guide" v-if="!isReviewed">
          <view class="review-inline-icon">
            <AppIcon name="phaseReflection" size="28rpx" />
            <text class="review-guide-header">结构化反思</text>
          </view>
          <view class="review-method-bar">
            <view
              v-for="(method, idx) in METHOD_OPTIONS"
              :key="idx"
              :class="['method-option', { active: currentMethod === method }]"
              @click="switchMethod(method)"
            >
              <text :class="['method-option-text', { active: currentMethod === method }]">{{ method }}</text>
            </view>
          </view>
          <view class="flip-card-container">
            <text class="flip-card-num">{{ currentIndex + 1 }}/{{ questions.length }}</text>
            <text class="flip-card-question">{{ currentQuestion }}</text>
            <textarea
              class="flip-card-input"
              :value="reviewNotes[currentIndex] || ''"
              placeholder="记录你的思考..."
              @input="saveCurrentNote(($event as InputEvent).detail.value as string)"
            />
          </view>
          <view class="flip-card-nav">
            <view
              :class="['nav-btn', 'nav-btn-prev', { disabled: currentIndex === 0 }]"
              @click="prevQuestion"
            >
              <view class="review-inline-icon">
                <AppIcon name="stateBack" size="18rpx" />
                <text class="nav-btn-text">上一题</text>
              </view>
            </view>
            <view
              :class="['nav-btn', 'nav-btn-next', { active: isLastQuestion }]"
              @click="nextQuestion"
            >
              <view class="review-inline-icon">
                <text class="nav-btn-text-next">{{ isLastQuestion ? '完成' : '下一题' }}</text>
                <AppIcon v-if="!isLastQuestion" name="stateChevronRight" size="18rpx" />
              </view>
            </view>
          </view>
        </view>

        <view class="reviewed-notes-section" v-if="isReviewed">
          <view class="review-inline-icon">
            <AppIcon name="toolNote" size="28rpx" />
            <text class="reviewed-notes-title">复盘记录</text>
          </view>
          <view class="reviewed-note-item" v-for="(note, idx) in reviewNotes" :key="idx">
            <view class="reviewed-note-index">
              <text class="reviewed-note-index-text">{{ idx + 1 }}</text>
            </view>
            <text class="reviewed-note-text">{{ note || '未填写' }}</text>
          </view>
          <view class="reviewed-notes-empty" v-if="reviewNotes.length === 0">
            <text class="empty-note-text">暂无复盘笔记</text>
          </view>
        </view>

        <view class="complete-review-btn" v-if="!isReviewed" @click="completeReview">
          <view class="review-inline-icon">
            <AppIcon name="stateCheck" size="20rpx" />
            <text class="complete-review-text">完成复盘</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

