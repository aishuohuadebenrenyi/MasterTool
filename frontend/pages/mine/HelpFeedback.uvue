  color: #1A1A2E;
}
.faq-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  transform: rotate(90deg);
  transition: transform 0.3s;
}
.faq-arrow-up {
  transform: rotate(-90deg);
}
.faq-answer {
  padding: 0 0 20rpx;
}
.faq-answer-text {
  font-size: 26rpx;
