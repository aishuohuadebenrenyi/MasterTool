{
  "name": "wechat-app",
  "private": true,
  "scripts": {
    "lint": "eslint \"miniprogram/**/*.js\" \"cloudfunctions/**/*.js\"",
    "format": "prettier --write \"miniprogram/**/*.{js,json,wxml,wxss}\" \"cloudfunctions/**/*.js\"",
    "format:check": "prettier --check \"miniprogram/**/*.{js,json,wxml,wxss}\" \"cloudfunctions/**/*.js\"",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit",
    "syntax-check": "node ../wechat-app-support/tests/verify-wechat-app.js",
    "verify": "npm run lint && npm run syntax-check",
    "verify:all": "npm run lint && npm test && npm run syntax-check"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.3"
  }
}
