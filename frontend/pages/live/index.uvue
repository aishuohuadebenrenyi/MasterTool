      <view class="group-method-row">
        <view :class="['group-method-btn', { active: groupMethod === 'average' }]" @click="groupMethod = 'average'">
          <text class="group-method-text">按人数均分</text>
        </view>
        <view :class="['group-method-btn', { active: groupMethod === 'random' }]" @click="groupMethod = 'random'">
          <text class="group-method-text">随机分组</text>
        </view>
      </view>
      <text class="sheet-label">队伍数量</text>
