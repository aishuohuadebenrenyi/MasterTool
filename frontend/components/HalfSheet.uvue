<script setup>
import { ref, watch } from 'vue'

const props = defineProps({
  visible: {
    type: Boolean,
    default: false
  },
  title: {
    type: String,
    default: ''
  },
  height: {
    type: String,
    default: '60vh'
  }
})

const emit = defineEmits(['update:visible', 'close'])

const showOverlay = ref<boolean>(false)
const showContent = ref<boolean>(false)

watch(() => props.visible, (val) => {
  if (val) {
    showOverlay.value = true
    setTimeout(() => { showContent.value = true }, 50)
  } else {
    showContent.value = false
    setTimeout(() => { showOverlay.value = false }, 300)
  }
})

function close() {
  emit('update:visible', false)
  emit('close')
}
</script>

<template>
  <view v-if="showOverlay" class="half-sheet-overlay" @click="close">
    <view :class="['half-sheet-content', { active: showContent }]" :style="{ height }" @click.stop>
      <view class="sheet-handle"></view>
      <view v-if="title" class="sheet-header">
        <text class="sheet-title">{{ title }}</text>
      </view>
      <view class="sheet-body">
        <slot></slot>
      </view>
    </view>
  </view>
</template>

<style lang="scss" scoped>
.half-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.half-sheet-content {
  width: 100%;
  background: $bg-primary;
  border-radius: $radius-xl $radius-xl 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;

  &.active {
    transform: translateY(0);
  }
}
.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: $bg-tertiary;
  border-radius: $radius-round;
  margin: $spacing-sm auto;
}
.sheet-header {
  padding: $spacing-sm $spacing-md;
  border-bottom: 1rpx solid $divider-color;
}
.sheet-title {
  font-size: $font-size-lg;
  font-weight: 600;
  color: $text-primary;
}
.sheet-body {
  padding: $spacing-md;
  overflow-y: auto;
}
</style>
