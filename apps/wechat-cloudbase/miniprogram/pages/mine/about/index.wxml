<view class="sub-page">
  <view class="sub-nav">
    <view class="sub-back" bindtap="goBack">‹</view>
    <view class="sub-title">关于</view>
  </view>

  <view class="about-hero sub-card">
    <view class="app-mark">
      <image class="app-mark-icon" src="/static/icons/icon-tab-home-active.png" mode="aspectFit" />
    </view>
    <view class="app-name">{{appName}}</view>
    <view class="app-version">版本 {{version}}</view>
    <view class="app-desc">{{description}}</view>
  </view>

  <view class="sub-card about-list">
    <view class="list-row" bindtap="openPrivacy">
      <view class="row-main">
        <view class="row-title">隐私政策</view>
        <view class="row-desc">查看数据收集和使用说明</view>
      </view>
      <image class="about-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
    <view class="list-row" bindtap="openTerms">
      <view class="row-main">
        <view class="row-title">服务条款</view>
        <view class="row-desc">查看服务使用说明</view>
      </view>
      <image class="about-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="about-footer">培训师工具箱</view>
</view>
