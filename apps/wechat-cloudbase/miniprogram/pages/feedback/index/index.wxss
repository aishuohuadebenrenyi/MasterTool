@import "../../../styles/subpage.wxss";

.feedback-page {
  min-height: 100vh;
  background: #F5F5F7;
  color: #1A1A2E;
}

.feedback-page .sub-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  height: 176rpx;
  box-sizing: border-box;
  padding: 88rpx 32rpx 0;
  background: #F5F5F7;
}

.feedback-scroll {
  height: 100vh;
}

.feedback-body {
  padding: 212rpx 32rpx 64rpx;
}

.entry-card,
.setting-card,
.list-card,
.stat-card {
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.07);
}

.entry-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 28rpx;
}

.entry-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 18rpx;
  border-radius: 30rpx;
  background: #F4F7FF;
}

.entry-icon {
  width: 54rpx;
  height: 54rpx;
}

.entry-title {
  color: #1A1A2E;
  font-size: 32rpx;
  font-weight: 900;
}

.entry-code-image {
  width: 320rpx;
  height: 320rpx;
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.entry-path {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: #8E8E93;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
  word-break: break-all;
}

.entry-actions {
  display: flex;
  gap: 18rpx;
  width: 100%;
  margin-top: 24rpx;
}

.entry-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
}

.entry-btn.primary {
  background: #4A7CF7;
  color: #FFFFFF;
}

.entry-btn.secondary {
  background: #F3F5FA;
  color: #4A5568;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.stat-card {
  padding: 28rpx 20rpx;
  text-align: center;
}

.stat-value {
  color: #4A7CF7;
  font-size: 38rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.setting-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 28rpx 32rpx;
}

.setting-title {
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: 900;
}

.setting-desc {
  margin-top: 6rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.switch {
  width: 88rpx;
  height: 50rpx;
  padding: 4rpx;
  border-radius: 25rpx;
  background: #D8DDE8;
  box-sizing: border-box;
}

.switch view {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.switch.active {
  background: #4A7CF7;
}

.switch.active view {
  transform: translateX(38rpx);
}

.list-card {
  margin-top: 22rpx;
  padding: 28rpx 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: 900;
}

.feedback-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F0F5;
}

.feedback-item:last-child {
  border-bottom: 0;
}

.feedback-content {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.55;
}

.feedback-meta {
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 22rpx;
}
