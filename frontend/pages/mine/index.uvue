<script setup>
import { computed, onMounted, ref } from 'vue'
import { useUserStore } from '../../stores/user'
import { calcNavBarInfo } from '../../utils/navbar'
import { getDesktopMaxWidth } from '../../utils/viewport'
import AppIcon from '../../components/AppIcon.uvue'

const userStore = useUserStore()

const navBarInfo = calcNavBarInfo()
const statusBarHeight = navBarInfo['statusBarHeight'] as number
const contentTopOffset = navBarInfo['contentTopOffset'] as number
const navHorizontalPadding = navBarInfo['navHorizontalPadding'] as number
const rightSafeWidth = navBarInfo['rightSafeWidth'] as number
const profileHeaderHeight = contentTopOffset + 132
const pageMaxWidth = ref<number>(getDesktopMaxWidth())

const nickname = computed(() : string => userStore.displayName)
const totalSessions = computed(() : number => userStore.stats?.['totalSessions'] || 0)
const avgSatisfaction = computed(() : string => userStore.stats?.['avgSatisfaction'] || '0')
const totalParticipants = computed(() : number => userStore.stats?.['totalParticipants'] || 0)

onMounted(() => {
  if (userStore.isLoggedIn) {
    userStore.fetchStats()
  }
})
</script>

