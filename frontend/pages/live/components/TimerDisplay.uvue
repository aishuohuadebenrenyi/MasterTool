<script setup>
defineProps({
  time: {
    type: String,
    default: '00:00'
  },
  progress: {
    type: Number,
    default: 0
  },
  isRunning: {
    type: Boolean,
    default: false
  }
})

defineEmits(['start', 'pause', 'reset'])
</script>

<template>
  <view class="timer-display">
    <text class="timer-time" :class="{ active: isRunning }">{{ time }}</text>
    <view class="timer-progress">
      <view class="progress-bar" :style="{ width: progress + '%' }"></view>
    </view>
  </view>
</template>

