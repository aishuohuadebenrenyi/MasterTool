import { defineStore } from 'pinia'
import { ref, computed } from 'vue'
import * as userApi from '../api/user'
import { STORAGE_KEYS } from '../utils/constants'
import * as storage from '../utils/storage'

export const useUserStore = defineStore('user', () => {
  const token = ref<string>('')
  const userInfo = ref<UTSJSONObject | null>(null)
  const stats = ref<UTSJSONObject | null>(null)
  const loading = ref<boolean>(false)
  const error = ref<string>('')

  const isLoggedIn = computed<boolean>(() => !!token.value)
  const displayName = computed<string>(() => (userInfo.value?.['nickname'] || userInfo.value?.['name'] || '培训师') as string)

  async function login(loginData : UTSJSONObject) {
    try {
      loading.value = true
      const data = await userApi.login(loginData)
      token.value = data['token'] as string
      userInfo.value = data['user'] as UTSJSONObject | null
      storage.set(STORAGE_KEYS['TOKEN'] as string, data['token'])
      storage.set(STORAGE_KEYS['USER_INFO'] as string, data['user'])
      error.value = ''
      return data
    } catch (e : unknown) {
      const msg = e instanceof Error ? e.message : '登录失败'
      error.value = msg
      throw e
    } finally {
      loading.value = false
    }
  }

  async function loginWithWechat() {
    const loginFn = (uni as unknown as UTSJSONObject)['login'] as ((options : UTSJSONObject) => void) | null
    if (loginFn == null) {
      return login({ code: 'dev_test', nickname: '培训师' } as UTSJSONObject)
    }
    return new Promise<UTSJSONObject>((resolve, reject) => {
      loginFn({
        provider: 'weixin',
        success: (res : UTSJSONObject) => {
          const code = (res['code'] as string) || ''
          if (!code) {
            reject(new Error('微信登录失败，请稍后重试'))
            return
          }
          login({ code, nickname: '培训师' } as UTSJSONObject).then(resolve).catch(reject)
        },
        fail: () => {
          reject(new Error('微信登录失败，请稍后重试'))
        }
      } as UTSJSONObject)
    })
  }

  async function fetchProfile() {
    try {
      loading.value = true
      const data = await userApi.getUserProfile()
      userInfo.value = data
      error.value = ''
      return data
    } catch (e : unknown) {
      const msg = e instanceof Error ? e.message : '获取用户信息失败'
      error.value = msg
      console.log('[userStore.fetchProfile]', msg)
      return null
    } finally {
      loading.value = false
    }
  }

  async function updateProfile(profileData : UTSJSONObject) {
    try {
      loading.value = true
      const data = await userApi.updateUserProfile(profileData)
      userInfo.value = { ...userInfo.value, ...data }
      storage.set(STORAGE_KEYS['USER_INFO'] as string, userInfo.value)
      error.value = ''
      return data
    } catch (e : unknown) {
      const msg = e instanceof Error ? e.message : '更新用户信息失败'
      error.value = msg
      throw e
    } finally {
      loading.value = false
    }
  }

  async function fetchStats() {
    try {
      loading.value = true
      const data = await userApi.getUserStats()
      stats.value = data
      error.value = ''
      return data
    } catch (e : unknown) {
      const msg = e instanceof Error ? e.message : '获取统计数据失败'
      error.value = msg
      stats.value = {
        totalSessions: 0,
        avgSatisfaction: '0.0',
        totalParticipants: 0
      } as UTSJSONObject
      console.log('[userStore.fetchStats]', msg)
      return stats.value
    } finally {
      loading.value = false
    }
  }

  function logout() {
    token.value = ''
    userInfo.value = null
    stats.value = null
    storage.remove(STORAGE_KEYS['TOKEN'] as string)
    storage.remove(STORAGE_KEYS['USER_INFO'] as string)
  }

  function restoreSession() {
    try {
      const savedToken = storage.get(STORAGE_KEYS['TOKEN'] as string)
      const savedUser = storage.get(STORAGE_KEYS['USER_INFO'] as string)
      if (savedToken) {
        token.value = savedToken
        if (savedUser) {
          try {
            userInfo.value = JSON.parse(savedUser) as UTSJSONObject
          } catch {
            userInfo.value = null
          }
        }
      }
    } catch {
    }
  }

  return {
    token,
    userInfo,
    stats,
    loading,
    error,
    isLoggedIn,
    displayName,
    login,
    loginWithWechat,
    fetchProfile,
    updateProfile,
    fetchStats,
    logout,
    restoreSession
  }
})
