          </view>
        </view>
        <view class="interact-entry">
          <view class="interact-entry-icon">
            <AppIcon name="stateQr" size="34rpx" />
          </view>
          <view class="interact-entry-info">
            <text class="interact-entry-title">参与者扫码或打开入口提交</text>
            <text class="interact-entry-path">{{ interactionLoading ? '正在生成入口...' : interactionPath }}</text>
          </view>
          <view class="interact-entry-code">
            <text class="interact-entry-code-text">{{ interactionJoinCode }}</text>
          </view>
        </view>
        <view class="interact-input-row">
          <input class="interact-input" v-model="wordcloudInput" placeholder="输入参与者关键词" placeholder-class="input-placeholder" />
          <view class="interact-add-btn" @click="addWordcloudItem">
            <text class="interact-add-text">添加</text>
          </view>
        </view>
        <view v-if="wordcloudItems.length === 0" class="interact-placeholder">
          <text class="interact-placeholder-text">等待参与者提交，也可由培训师手动补录</text>
        </view>
        <view v-else class="wordcloud-list">
          <view class="wordcloud-chip" v-for="(item, idx) in wordcloudItems" :key="idx">
            <text class="wordcloud-word">{{ item['word'] as string }}</text>
            <text class="wordcloud-count">{{ item['count'] as number }}</text>
          </view>
        </view>
      </view>
      <view v-if="interactType === 'vote'" class="interact-detail">
        <view class="interact-detail-header">
          <view class="section-title-row">
            <AppIcon name="stateChart" size="28rpx" />
            <text class="interact-detail-title">投票互动</text>
          </view>
          <view class="interact-back" @click="leaveInteractDetail">
            <text class="interact-back-text">返回</text>
          </view>
        </view>
        <view class="interact-entry">
          <view class="interact-entry-icon">
            <AppIcon name="stateQr" size="34rpx" />
          </view>
          <view class="interact-entry-info">
            <text class="interact-entry-title">参与者扫码或打开入口投票</text>
            <text class="interact-entry-path">{{ interactionLoading ? '正在生成入口...' : interactionPath }}</text>
          </view>
          <view class="interact-entry-code">
            <text class="interact-entry-code-text">{{ interactionJoinCode }}</text>
          </view>
        </view>
        <view class="interact-input-row">
          <input class="interact-input" v-model="voteOptionInput" placeholder="新增投票选项" placeholder-class="input-placeholder" />
          <view class="interact-add-btn" @click="addVoteOption">
            <text class="interact-add-text">添加</text>
          </view>
        </view>
        <view class="vote-list">
          <view class="vote-item" v-for="(item, idx) in voteOptions" :key="idx">
            <text class="vote-label">{{ item['label'] as string }}</text>
            <view class="vote-controls">
              <view class="vote-btn" @click="changeVote(idx, -1)">
                <text class="vote-btn-text">−</text>
              </view>
              <text class="vote-count">{{ item['count'] as number }}</text>
              <view class="vote-btn vote-btn-plus" @click="changeVote(idx, 1)">
                <text class="vote-btn-text">+</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view v-if="interactType === 'promise'" class="interact-detail">
        <view class="interact-detail-header">
          <view class="section-title-row">
            <AppIcon name="statePromise" size="28rpx" />
            <text class="interact-detail-title">承诺互动</text>
          </view>
          <view class="interact-back" @click="leaveInteractDetail">
            <text class="interact-back-text">返回</text>
          </view>
        </view>
        <view class="interact-entry">
          <view class="interact-entry-icon">
            <AppIcon name="stateQr" size="34rpx" />
          </view>
          <view class="interact-entry-info">
            <text class="interact-entry-title">参与者扫码或打开入口填写承诺</text>
            <text class="interact-entry-path">{{ interactionLoading ? '正在生成入口...' : interactionPath }}</text>
          </view>
          <view class="interact-entry-code">
            <text class="interact-entry-code-text">{{ interactionJoinCode }}</text>
          </view>
        </view>
        <view class="interact-input-row">
          <input class="interact-input" v-model="promiseInput" placeholder="记录一个行动承诺" placeholder-class="input-placeholder" />
          <view class="interact-add-btn" @click="addPromiseItem">
            <text class="interact-add-text">添加</text>
          </view>
        </view>
        <view v-if="promiseItems.length === 0" class="interact-placeholder">
          <text class="interact-placeholder-text">等待参与者提交，也可由培训师手动补录</text>
        </view>
        <view v-else class="promise-list">
          <view class="promise-item" v-for="(item, idx) in promiseItems" :key="idx">
            <text class="promise-index">{{ idx + 1 }}</text>
            <text class="promise-text">{{ item }}</text>
          </view>
        </view>
      </view>
    </HalfSheet>

    <HalfSheet :visible="soundSheet" size="standard" title="音效面板" @update:visible="soundSheet = $event">
      <view class="sound-grid">
        <view
          v-for="(sound, idx) in soundList"
          :key="idx"
          :class="['sound-btn', { active: activeSound === (sound['key'] as string) }]"
          @click="playSound(sound['key'] as string)"
        >
          <AppIcon :name="sound['iconName'] as string" size="34rpx" />
          <text class="sound-btn-name">{{ sound['name'] as string }}</text>
        </view>
      </view>
    </HalfSheet>

    <HalfSheet :visible="standaloneTimerSheet" size="large" title="独立计时" @update:visible="standaloneTimerSheet = $event">
      <text class="sheet-label">计时模式</text>
      <view class="stimer-mode-row">
        <view :class="['stimer-mode-btn', { active: standaloneTimerMode === 'countup' }]" @click="standaloneTimerMode = 'countup'">
          <text class="stimer-mode-text">正计时</text>
        </view>
        <view :class="['stimer-mode-btn', { active: standaloneTimerMode === 'countdown' }]" @click="standaloneTimerMode = 'countdown'">
          <text class="stimer-mode-text">倒计时</text>
        </view>
      </view>
      <view v-if="standaloneTimerMode === 'countdown'" class="stimer-duration-row">
        <view
          v-for="(m, idx) in ([1, 3, 5, 10] as Array<number>)"
          :key="idx"
          :class="['stimer-duration-btn', { active: countdownMinutes === m }]"
          @click="countdownMinutes = m"
        >
          <text class="stimer-duration-text">{{ m }}分钟</text>
        </view>
      </view>
      <view class="stimer-display">
        <text class="stimer-time">{{ standaloneTimerDisplay }}</text>
      </view>
      <template #footer>
        <view class="stimer-controls">
          <view class="stimer-ctrl-btn" @click="resetStandaloneTimer">
            <text class="stimer-ctrl-text">重置</text>
          </view>
          <view :class="['stimer-ctrl-btn', 'stimer-ctrl-primary', { paused: standaloneRunning }]" @click="toggleStandaloneTimer">
            <text class="stimer-ctrl-text">{{ standaloneRunning ? '暂停' : '开始' }}</text>
          </view>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="noteSheet" size="large" title="培训笔记" @update:visible="noteSheet = $event">
      <view class="note-phase-tag">
        <text class="note-phase-tag-text">{{ currentPhaseName }}</text>
      </view>
      <textarea v-model="noteContent" class="note-input" placeholder="记录本环节要点..."></textarea>
      <view class="note-saved-list">
        <view class="note-saved-item" v-for="(note, idx) in liveStore.notes" :key="idx">
          <text class="note-saved-phase">{{ note['phaseName'] as string }}</text>
          <text class="note-saved-content">{{ note['content'] as string }}</text>
          <text class="note-saved-time">{{ note['createdAt'] as string }}</text>
        </view>
      </view>
      <template #footer>
        <view class="sheet-footer-btn sheet-footer-btn-primary" @click="saveNote">
          <text class="sheet-footer-btn-text">保存笔记</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="showToolbox" size="large" title="工具箱" @update:visible="showToolbox = $event">
      <view class="toolbox-grid">
        <view class="toolbox-item" v-for="(tool, idx) in allTools" :key="idx" @click="openToolFromToolbox(tool)">
          <view class="toolbox-item-icon-box">
            <AppIcon :name="tool['iconName'] as string" size="40rpx" />
          </view>
          <text class="toolbox-item-name">{{ tool['name'] }}</text>
        </view>
      </view>
    </HalfSheet>

    <ConfirmDialog
      :visible="showExitDialog"
      title="确认退出"
      content="退出后将结束当前培训会话，确定要退出吗？"
      confirmText="退出"
      cancelText="继续"
      @confirm="confirmExit"
      @cancel="cancelExit"
    ></ConfirmDialog>
  </view>
</template>

