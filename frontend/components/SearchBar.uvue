<script setup>
import { ref } from 'vue'
import AppIcon from './AppIcon.uvue'

const props = defineProps({
  placeholder: {
    type: String,
    default: '搜索'
  },
  value: {
    type: String,
    default: ''
  }
})

const emit = defineEmits(['update:value', 'search', 'clear'])

const keyword = ref<string>(props.value)

function onInput(e) {
  keyword.value = e.detail.value
  emit('update:value', keyword.value)
}

function onSearch() {
  emit('search', keyword.value)
}

function onClear() {
  keyword.value = ''
  emit('update:value', '')
  emit('clear')
}
</script>

<template>
  <view class="search-bar">
    <view class="search-input-wrap">
      <AppIcon name="stateSearch" size="28rpx" />
      <input
        class="search-input"
        :value="keyword"
        :placeholder="placeholder"
        placeholder-class="search-placeholder"
        confirm-type="search"
        @input="onInput"
        @confirm="onSearch"
      />
      <view v-if="keyword" class="clear-icon" @click="onClear">
        <AppIcon name="stateClose" size="20rpx" />
      </view>
    </view>
  </view>
</template>

<style lang="scss" scoped>
.search-bar {
  padding: $spacing-sm $spacing-md;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: $bg-tertiary;
  border-radius: 44rpx;
  padding: 0 28rpx;
  min-height: 88rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}
.search-icon {
  margin-right: $spacing-xs;
}
.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: $text-primary;
}
.search-placeholder {
  color: $text-tertiary;
}
.clear-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>
