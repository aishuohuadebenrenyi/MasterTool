<script setup>
import { ref, watch, computed, useSlots } from 'vue'
import { getDesktopMaxWidth, getSafeAreaBottom, getViewportHeight } from '../utils/viewport'
import AppIcon from './AppIcon.uvue'

const props = defineProps({
  visible: {
    type: Boolean,
    default: false
  },
  size: {
    type: String,
    default: 'standard'
  },
  title: {
    type: String,
    default: ''
  },
  height: {
    type: String,
    default: ''
  },
  showClose: {
    type: Boolean,
    default: true
  },
  showHandle: {
    type: Boolean,
    default: true
  },
  closeOnOverlay: {
    type: Boolean,
    default: true
  },
  bodyPadding: {
    type: String,
    default: '24rpx 32rpx'
  },
  footerPadding: {
    type: String,
    default: '20rpx 32rpx'
  }
})

const emit = defineEmits(['update:visible', 'close'])
const slots = useSlots()

const showOverlay = ref<boolean>(false)
const showContent = ref<boolean>(false)
const safeAreaBottom = ref<number>(getSafeAreaBottom())
const viewportHeight = ref<number>(getViewportHeight())
const maxWidth = getDesktopMaxWidth()

const resolvedHeight = computed<string>(() => {
  if (props.height) {
    return props.height
  }
  let ratio = 0.72
  let minHeight = 420

  if (props.size === 'compact') {
    ratio = 0.52
    minHeight = 320
  } else if (props.size === 'large') {
    ratio = 0.86
    minHeight = 520
  }

  const preferred = Math.round(viewportHeight.value * ratio)
  const targetHeight = Math.max(preferred, minHeight)
  const limited = Math.min(targetHeight, viewportHeight.value - 24)
  return Math.max(limited, 240) + 'px'
})

const hasFooter = computed<boolean>(() => slots.footer != null)

watch(() => props.visible, (val) => {
  if (val) {
    safeAreaBottom.value = getSafeAreaBottom()
    viewportHeight.value = getViewportHeight()
    showOverlay.value = true
    setTimeout(() => { showContent.value = true }, 50)
  } else {
    showContent.value = false
    setTimeout(() => { showOverlay.value = false }, 300)
  }
})

function close() {
  emit('update:visible', false)
  emit('close')
}

function handleOverlayClick() {
  if (!props.closeOnOverlay) return
  close()
}
</script>

<template>
  <view v-if="showOverlay" class="half-sheet-overlay" @click="handleOverlayClick">
    <view
      :class="['half-sheet-content', { active: showContent }]"
      :style="{ height: resolvedHeight, maxWidth: maxWidth > 0 ? maxWidth + 'px' : 'none' }"
      @click.stop
    >
      <view v-if="showHandle" class="sheet-handle"></view>
      <view v-if="title || showClose || slots.headerRight" class="sheet-header">
        <text v-if="title" class="sheet-title">{{ title }}</text>
        <view v-else class="sheet-title-placeholder"></view>
        <view class="sheet-header-right">
          <slot name="headerRight"></slot>
          <view v-if="showClose" class="sheet-close" @click="close">
            <AppIcon name="stateClose" size="24rpx" />
          </view>
        </view>
      </view>
      <view class="sheet-body-shell">
        <scroll-view class="sheet-body" scroll-y :style="{ padding: bodyPadding }">
          <slot></slot>
          <view v-if="!hasFooter && safeAreaBottom > 0" class="sheet-body-safe" :style="{ height: safeAreaBottom + 'px' }"></view>
        </scroll-view>
      </view>
      <view v-if="hasFooter" class="sheet-footer" :style="{ padding: footerPadding, paddingBottom: 'calc(' + safeAreaBottom + 'px + 20rpx)' }">
        <slot name="footer"></slot>
      </view>
    </view>
  </view>
</template>

<style scoped>
.half-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.38);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.half-sheet-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 -8rpx 40rpx rgba(15, 23, 42, 0.12);
}
.half-sheet-content.active {
  transform: translateY(0);
}
.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: #D6D8DE;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}
.sheet-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.sheet-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}
.sheet-title-placeholder {
  flex: 1;
}
.sheet-header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.sheet-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #F4F5F8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-body-shell {
  flex: 1;
  min-height: 0;
  background-color: #FFFFFF;
}
.sheet-body {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background-color: #FFFFFF;
}
.sheet-body-safe {
  flex-shrink: 0;
}
.sheet-footer {
  flex-shrink: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  box-sizing: border-box;
}
</style>
