function callUniInfoMethod(name : string) : UTSJSONObject | null {
  try {
    const fn = (uni as unknown as UTSJSONObject)[name] as (() => UTSJSONObject) | null
    if (fn != null) {
      return fn()
    }
  } catch (_e : unknown) {}
  return null
}

export function getRuntimeInfo() : UTSJSONObject {
  const appBaseInfo = callUniInfoMethod('getAppBaseInfo')
  const deviceInfo = callUniInfoMethod('getDeviceInfo')

  return {
    platform: (deviceInfo?.['uniPlatform'] as string) || (appBaseInfo?.['uniPlatform'] as string) || '',
    host: (appBaseInfo?.['hostName'] as string) || '',
    deviceBrand: (deviceInfo?.['brand'] as string) || '',
    deviceModel: (deviceInfo?.['model'] as string) || ''
  } as UTSJSONObject
}

export function isMpWeixinRuntime() : boolean {
  return (getRuntimeInfo()['platform'] as string) === 'mp-weixin'
}
