        <text class="group-result-name">{{ item['name'] as string }}</text>
        <text class="group-result-count">{{ item['count'] as number }}人</text>
      </view>
      <template #footer>
        <view class="sheet-footer-row">
          <view class="sheet-footer-btn sheet-footer-btn-secondary" @click="doGrouping()">
            <text class="sheet-footer-btn-text-secondary">生成分组</text>
          </view>
          <view class="sheet-footer-btn sheet-footer-btn-primary" @click="confirmGrouping">
            <text class="sheet-footer-btn-text">确认分组</text>
          </view>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="scoreSheet" size="large" title="积分管理" @update:visible="scoreSheet = $event">
      <text class="sheet-label">积分模式</text>
      <view class="score-mode-row">
        <view :class="['score-mode-btn', { active: scoreMode === 'simple' }]" @click="scoreMode = 'simple'">
          <text class="score-mode-text">简化模式</text>
        </view>
        <view :class="['score-mode-btn', { active: scoreMode === 'detailed' }]" @click="scoreMode = 'detailed'">
          <text class="score-mode-text">详细模式</text>
        </view>
      </view>
      <text class="sheet-label">队伍积分</text>
      <view v-if="!isGrouped" class="score-not-grouped">
        <text class="score-not-grouped-text">请先完成分组</text>
      </view>
      <view v-if="isGrouped" class="score-item" v-for="(item, idx) in teamScores" :key="idx">
        <view class="score-color-dot" :style="{ backgroundColor: item['color'] as string }"></view>
        <text class="score-name">{{ item['name'] as string }}</text>
        <text class="score-value">{{ item['score'] as number }}</text>
        <view class="score-btn-minus" @click="changeScore(idx, -1)">
          <text class="score-btn-text">−</text>
        </view>
        <view class="score-btn-plus" @click="changeScore(idx, 1)">
          <text class="score-btn-text">+</text>
        </view>
      </view>
      <template #footer>
        <view v-if="isGrouped" class="sheet-footer-btn sheet-footer-btn-danger sheet-footer-btn-contained" @click="resetScores">
          <text class="sheet-footer-btn-text">重置积分</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="pickSheet" size="standard" title="随机抽取" @update:visible="pickSheet = $event">
      <view class="pick-tabs">
        <view :class="['pick-tab', { active: pickTab === 'actor' }]" @click="pickTab = 'actor'">
          <text class="pick-tab-text">抽演员</text>
        </view>
        <view :class="['pick-tab', { active: pickTab === 'audience' }]" @click="pickTab = 'audience'">
          <text class="pick-tab-text">抽观众</text>
        </view>
        <view :class="['pick-tab', { active: pickTab === 'topic' }]" @click="pickTab = 'topic'">
          <text class="pick-tab-text">抽题目</text>
        </view>
      </view>
      <view v-if="pickTab !== 'topic'" class="pick-repeat-row" @click="allowRepeatPick = !allowRepeatPick">
        <view :class="['pick-switch', { active: allowRepeatPick }]">
