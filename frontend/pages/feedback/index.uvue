<script setup>
import { ref, computed, onMounted } from 'vue'
import { useLiveStore } from '../../stores/live'
import * as feedbackApi from '../../api/feedback'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'

const liveStore = useLiveStore()

const planId = ref<string>('')
const sessionId = ref<string>('')
const feedbackCount = ref<number>(0)
const avgSatisfaction = ref<string>('0.0')
const npsScore = ref<number>(0)
const responseRate = ref<string>('0%')
const allowAnonymous = ref<boolean>(true)
const loading = ref<boolean>(false)
const feedbackEntryPath = computed<string>(() => sessionId.value ? `/pages/participant/FeedbackSubmit?sessionId=${sessionId.value}` : '')

const satisfactionData = ref<Array<UTSJSONObject>>([
  { star: 1, count: 1, color: '#FF3B30' },
  { star: 2, count: 2, color: '#FF9500' },
  { star: 3, count: 3, color: '#FFCC00' },
  { star: 4, count: 5, color: '#34C759' },
  { star: 5, count: 8, color: '#4A7CF7' }
])

const feedbackList = ref<Array<UTSJSONObject>>([])

const maxCount = computed<number>(() => {
  let max = 0
  for (let i = 0; i < satisfactionData.value.length; i++) {
    const count = satisfactionData.value[i]['count'] as number
    if (count > max) {
      max = count
    }
  }
  return max
})

function goBack() {
  uni.navigateBack({})
}

function toggleAnonymous() {
  allowAnonymous.value = !allowAnonymous.value
}

function getStars(star : number) : Array<number> {
  const result : Array<number> = []
  for (let i = 0; i < star; i++) {
    result.push(i)
  }
  return result
}

function getBarHeight(count : number) : string {
  if (maxCount.value === 0) return '0rpx'
  const height = Math.max(8, (count / maxCount.value) * 200)
  return height + 'rpx'
}

async function loadData() {
  const sid = sessionId.value || (liveStore.sessionId as string) || ''
  if (!sid) {
    feedbackCount.value = 0
    avgSatisfaction.value = '0.0'
    npsScore.value = 0
    responseRate.value = '0%'
    feedbackList.value = []
    return
  }

  loading.value = true
  try {
    const stats = await feedbackApi.getFeedbackStats(sid)
    feedbackCount.value = (stats['count'] as number) || 0
    avgSatisfaction.value = String((stats['avgSatisfaction'] as number) || 0)
    npsScore.value = (stats['nps'] as number) || 0
    responseRate.value = (stats['responseRate'] as string) || '0%'

    const distribution = stats['satisfactionDistribution'] as Array<UTSJSONObject>
    if (distribution && distribution.length > 0) {
      const colors = ['#FF3B30', '#FF9500', '#FFCC00', '#34C759', '#4A7CF7']
      satisfactionData.value = distribution.map((item : UTSJSONObject, index : number) => ({
        ...item,
        color: colors[index] || '#4A7CF7'
      } as UTSJSONObject))
    }

    const listResult = await feedbackApi.getFeedbackList(sid)
    const items = listResult['list'] as Array<UTSJSONObject>
    feedbackList.value = (items || []).map((item : UTSJSONObject) => ({
      ...item,
      anonymous: (item['anonymous'] as boolean) || (item['isAnonymous'] as boolean) || false,
      author: (item['author'] as string) || (((item['anonymous'] as boolean) || (item['isAnonymous'] as boolean)) ? '匿名用户' : '参与者'),
      star: (item['star'] as number) || (item['rating'] as number) || (item['stars'] as number) || 0,
      text: (item['text'] as string) || (item['comment'] as string) || ''
    } as UTSJSONObject))
  } catch (e : unknown) {
    feedbackCount.value = 0
    avgSatisfaction.value = '0.0'
    npsScore.value = 0
    responseRate.value = '0%'
    feedbackList.value = []
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = (currentPage as any).$page.options || (currentPage as any).options || {}
  sessionId.value = (options.sessionId || liveStore.sessionId || '') as string
  planId.value = (options.planId || liveStore.planId || '') as string
  loadData()
})
</script>

<template>
  <view class="page">
    <NavBar title="反馈收集" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack" />

    <scroll-view class="page-scroll" scroll-y>
      <view class="page-content">
        <view class="feedback-guide">
          <view class="feedback-inline-icon">
            <AppIcon name="phaseSummary" size="24rpx" />
            <text class="feedback-guide-title">如何收集参与者反馈</text>
          </view>
          <text class="feedback-guide-step">1. 展示下方入口，参与者扫码或打开入口即可填写反馈</text>
          <text class="feedback-guide-step">2. 参与者可自主选择是否匿名提交</text>
          <text class="feedback-guide-step">3. 反馈数据实时汇总，自动生成统计</text>
        </view>

        <view class="feedback-qr-card">
          <view class="feedback-inline-icon">
            <AppIcon name="stateQr" size="24rpx" />
            <text class="feedback-qr-title">参与者反馈入口</text>
          </view>
          <view class="feedback-qr-placeholder">
            <text class="feedback-qr-text">{{ feedbackEntryPath || '暂无场次' }}</text>
          </view>
          <text class="feedback-qr-hint">正式二维码图片接入后，此处展示小程序码</text>
          <view class="feedback-qr-stats-row">
            <text class="feedback-qr-stats">已收集 </text>
            <text class="feedback-qr-stats-bold">{{ feedbackCount }}</text>
            <text class="feedback-qr-stats"> 份反馈 · 回收率 </text>
            <text class="feedback-qr-stats-bold">{{ responseRate }}</text>
          </view>
        </view>

        <view class="feedback-stats">
          <view class="fb-stat">
            <text class="fb-stat-num">{{ feedbackCount }}</text>
            <text class="fb-stat-label">已收集</text>
          </view>
          <view class="fb-stat">
            <text class="fb-stat-num">{{ avgSatisfaction }}</text>
            <text class="fb-stat-label">平均满意度</text>
          </view>
          <view class="fb-stat">
            <text class="fb-stat-num">{{ npsScore }}</text>
            <text class="fb-stat-label">NPS</text>
          </view>
          <view class="fb-stat">
            <text class="fb-stat-num">{{ responseRate }}</text>
            <text class="fb-stat-label">回收率</text>
          </view>
        </view>

        <view class="feedback-anonymous-toggle" @click="toggleAnonymous">
          <view class="feedback-inline-icon">
            <AppIcon :name="allowAnonymous ? 'stateCheckbox' : 'stateClose'" size="22rpx" />
            <text class="feedback-anonymous-label">允许匿名提交</text>
          </view>
          <view class="toggle-switch" :class="{ 'toggle-switch-active': allowAnonymous }">
            <view class="toggle-knob" :class="{ 'toggle-knob-active': allowAnonymous }"></view>
          </view>
        </view>

        <view class="section-header">
          <text class="section-title">满意度分布</text>
        </view>
        <view class="satisfaction-chart">
          <view class="chart-bar-group" v-for="(item, index) in satisfactionData" :key="index">
            <text class="chart-value">{{ item['count'] }}</text>
            <view class="chart-bar" :style="{ height: getBarHeight(item['count'] as number), backgroundColor: item['color'] as string }"></view>
            <text class="chart-label">{{ item['star'] }}分</text>
          </view>
        </view>

        <view class="section-header">
          <text class="section-title">反馈列表</text>
        </view>
        <view class="feedback-list">
          <view class="feedback-item" v-for="(item, index) in feedbackList" :key="index">
            <view class="feedback-item-header">
              <text class="feedback-author" :class="{ 'feedback-author-anonymous': item['anonymous'] as boolean }">{{ item['author'] as string }}</text>
              <view class="feedback-stars">
                <AppIcon v-for="starIndex in getStars(item['star'] as number)" :key="starIndex" name="stateFavorite" size="20rpx" />
              </view>
            </view>
            <text class="feedback-text">{{ item['text'] as string }}</text>
          </view>
        </view>
        <view class="bottom-spacer"></view>
      </view>
    </scroll-view>
  </view>
</template>

