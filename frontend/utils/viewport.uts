export function getSafeAreaBottom() : number {
  try {
    const windowInfoFn = (uni as unknown as UTSJSONObject)['getWindowInfo'] as (() => UTSJSONObject) | null
    if (windowInfoFn != null) {
      const windowInfo = windowInfoFn()
      const safeAreaInsets = windowInfo['safeAreaInsets'] as UTSJSONObject | null
      if (safeAreaInsets != null) {
        return (safeAreaInsets['bottom'] as number) || 0
      }
    }
  } catch (_e : unknown) {}

  return 0
}

export function getViewportHeight() : number {
  try {
    const windowInfoFn = (uni as unknown as UTSJSONObject)['getWindowInfo'] as (() => UTSJSONObject) | null
    if (windowInfoFn != null) {
      const windowInfo = windowInfoFn()
      return (windowInfo['windowHeight'] as number) || (windowInfo['screenHeight'] as number) || 812
    }
  } catch (_e : unknown) {}

  return 812
}

export function getViewportWidth() : number {
  try {
    const windowInfoFn = (uni as unknown as UTSJSONObject)['getWindowInfo'] as (() => UTSJSONObject) | null
    if (windowInfoFn != null) {
      const windowInfo = windowInfoFn()
      return (windowInfo['windowWidth'] as number) || (windowInfo['screenWidth'] as number) || 375
    }
  } catch (_e : unknown) {}

  return 375
}

export function getDesktopMaxWidth() : number {
  const width = getViewportWidth()
  if (width >= 1280) {
    return 960
  }
  if (width >= 960) {
    return 860
  }
  if (width >= 768) {
    return 720
  }
  return 0
}

export function getViewportLayoutInfo() : UTSJSONObject {
  const viewportWidth = getViewportWidth()
  const maxWidth = getDesktopMaxWidth()
  return {
    viewportWidth,
    viewportHeight: getViewportHeight(),
    safeAreaBottom: getSafeAreaBottom(),
    maxWidth,
    isDesktopEnhanced: maxWidth > 0
  } as UTSJSONObject
}
