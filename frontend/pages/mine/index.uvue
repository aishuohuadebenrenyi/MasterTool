          <text class="mine-stat-num">{{ totalSessions }}</text>
          <text class="mine-stat-label">培训场次</text>
        </view>
        <view class="mine-stat-divider"></view>
        <view class="mine-stat-item">
          <text class="mine-stat-num">{{ avgSatisfaction }}</text>
          <text class="mine-stat-label">平均满意度</text>
        </view>
        <view class="mine-stat-divider"></view>
        <view class="mine-stat-item">
          <text class="mine-stat-num">{{ totalParticipants }}</text>
          <text class="mine-stat-label">参与人数</text>
        </view>
      </view>
    </view>

    <view class="mine-menu-card" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="mine-menu-item" @click="uni.navigateTo({ url: '/pages/mine/TrainingRecords' })">
        <AppIcon class="mine-menu-icon-image" src="/static/icons/mine-records.svg" size="40rpx" />
