  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 16rpx;
}

.star-item {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.38;
}

.star-item.active {
  background-color: #FFF7E8;
  opacity: 1;
}

.nps-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.nps-item {
  width: 72rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: #F7F8FC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nps-item.active {
  background-color: #4A7CF7;
}

.nps-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #8E8E93;
}

.nps-item.active .nps-text {
  color: #FFFFFF;
}

.textarea {
  width: 100%;
  min-height: 190rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  padding: 22rpx;
  font-size: 28rpx;
  color: #1A1A2E;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.input {
  height: 86rpx;
  border-radius: 18rpx;
  background-color: #F7F8FC;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #1A1A2E;
}

.input-placeholder {
  color: #B8BCC8;
}

.anonymous-row {
  min-height: 92rpx;
  padding: 16rpx 0;
  margin-bottom: 22rpx;
}

.switch {
  width: 76rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background-color: #D8DDE8;
  padding: 4rpx;
  box-sizing: border-box;
  margin-left: 18rpx;
}

.switch.active {
  background-color: #4A7CF7;
}

.switch-dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background-color: #FFFFFF;
}

.switch.active .switch-dot {
  margin-left: 34rpx;
}

.error-text {
  font-size: 24rpx;
  color: #FF4D4F;
  margin-bottom: 18rpx;
  text-align: center;
}

.submit-btn {
  height: 92rpx;
  border-radius: 20rpx;
  background-color: #4A7CF7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  opacity: 0.48;
}

.submit-btn-text {
  font-size: 30rpx;
