<view class="page mine-page">
  <view class="card profile-card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-main">
      <view class="profile-title">{{displayName}}</view>
      <view class="profile-desc">{{roleText}}</view>
    </view>
    <view class="edit-button" bindtap="openProfileEdit">
      <text>编辑</text>
      <image class="edit-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="card stats-card">
    <view class="stat-item">
      <view class="stat-value">{{totalSessions}}</view>
      <view class="stat-label">培训场次</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value">{{avgSatisfaction}}</view>
      <view class="stat-label">平均满意度</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value">{{totalParticipants}}</view>
      <view class="stat-label">参与人数</view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-row {{filter === 'pendingReview' ? 'active' : ''}}" bindtap="goTrainingRecords">
      <image class="menu-icon-img" src="/static/icons/mine-records.png" mode="aspectFit" />
      <view class="menu-title">培训记录</view>
    </view>
    <view class="menu-row" bindtap="goDataDetail">
      <image class="menu-icon-img" src="/static/icons/mine-stats.png" mode="aspectFit" />
      <view class="menu-title">数据详情</view>
      <image class="menu-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-row" bindtap="goSettings">
      <image class="menu-icon-img" src="/static/icons/mine-settings.png" mode="aspectFit" />
      <view class="menu-title">设置</view>
      <image class="menu-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
    <view class="menu-row" bindtap="goHelp">
      <image class="menu-icon-img" src="/static/icons/mine-feedback.png" mode="aspectFit" />
      <view class="menu-title">帮助与反馈</view>
      <image class="menu-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
    <view class="menu-row" bindtap="goAbout">
      <image class="menu-icon-img" src="/static/icons/mine-about.png" mode="aspectFit" />
      <view class="menu-title">关于</view>
      <image class="menu-arrow" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
    </view>
  </view>

  <view wx:if="{{showProfileEdit}}" class="sheet-mask" catchtap="closeProfileEdit">
    <view class="half-sheet compact" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <view class="sheet-title">编辑资料</view>
        <view class="sheet-close" catchtap="closeProfileEdit">
          <image class="sheet-close-img" src="/static/icons/icon-state-close.png" mode="aspectFit" />
        </view>
      </view>
      <view class="sheet-body">
        <view class="profile-edit-form">
          <view class="profile-edit-label">昵称</view>
          <input class="profile-edit-input" value="{{editName}}" placeholder="请输入昵称" maxlength="20" bindinput="handleNameInput" />
        </view>
      </view>
      <view class="sheet-footer">
        <view class="profile-save-btn" bindtap="saveProfile">保存</view>
      </view>
    </view>
  </view>
</view>
