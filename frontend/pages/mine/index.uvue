<script setup>
import { computed, onMounted, ref } from 'vue'
import { useUserStore } from '../../stores/user'
import { calcNavBarInfo } from '../../utils/navbar'
import { getDesktopMaxWidth, rpxToPx } from '../../utils/viewport'
import AppIcon from '../../components/AppIcon.uvue'
import HalfSheet from '../../components/HalfSheet.uvue'

const userStore = useUserStore()

const navBarInfo = calcNavBarInfo()
const tabContentTopOffset = navBarInfo['tabContentTopOffset'] as number
const profileHeaderHeight = tabContentTopOffset + rpxToPx(148)
const pageMaxWidth = ref<number>(getDesktopMaxWidth())

const nickname = computed(() : string => userStore.displayName)
const roleText = computed(() : string => userStore.isLoggedIn ? '认证培训师' : '未登录')
const totalSessions = computed(() : number => userStore.stats?.['totalSessions'] || 0)
const avgSatisfaction = computed(() : string => userStore.stats?.['avgSatisfaction'] || '0')
const totalParticipants = computed(() : number => userStore.stats?.['totalParticipants'] || 0)
const showProfileEdit = ref<boolean>(false)
const editNickname = ref<string>('')

function openProfileEdit() {
  if (!userStore.isLoggedIn) {
    handleLogin()
    return
  }
  editNickname.value = nickname.value
  showProfileEdit.value = true
}

async function handleLogin() {
  try {
    await userStore.loginWithWechat()
    await userStore.fetchStats()
    uni.showToast({ title: '登录成功', icon: 'success' })
  } catch (e : unknown) {
    uni.showToast({ title: e instanceof Error ? e.message : '登录失败，请稍后重试', icon: 'none' })
  }
}

function goAuthed(url : string) {
  if (!userStore.isLoggedIn) {
    uni.showToast({ title: '请先登录后查看', icon: 'none' })
    return
  }
  uni.navigateTo({ url })
}

async function saveProfile() {
  const nextName = editNickname.value.trim()
  if (!nextName) {
    uni.showToast({ title: '请输入昵称', icon: 'none' })
    return
  }
  try {
    await userStore.updateProfile({ nickname: nextName } as UTSJSONObject)
    showProfileEdit.value = false
    uni.showToast({ title: '已保存', icon: 'success' })
  } catch (_e : unknown) {
    uni.showToast({ title: '保存失败，请稍后重试', icon: 'none' })
  }
}

onMounted(() => {
  if (userStore.isLoggedIn) {
    userStore.fetchStats()
  }
})
</script>

<template>
  <view class="page">
    <view class="nav-bar-fixed" :style="{ minHeight: profileHeaderHeight + 'px', paddingTop: tabContentTopOffset + 'px' }">
      <view class="mine-profile-row" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
        <view class="mine-avatar">
          <text class="mine-avatar-text">{{ nickname.charAt(0) }}</text>
        </view>
        <view class="mine-user-info">
          <text class="mine-user-name">{{ nickname }}</text>
          <text class="mine-user-role">{{ roleText }}</text>
        </view>
        <view class="mine-edit-btn" @click="userStore.isLoggedIn ? openProfileEdit() : handleLogin()">
          <text class="mine-edit-text">{{ userStore.isLoggedIn ? '编辑' : '登录' }}</text>
          <AppIcon name="stateChevronRight" size="16rpx" />
        </view>
      </view>
    </view>
    <view :style="{ height: profileHeaderHeight + 'px' }"></view>
    <view class="mine-profile-card" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="mine-profile-stats">
        <view class="mine-stat-item">
          <text class="mine-stat-num">{{ totalSessions }}</text>
          <text class="mine-stat-label">培训场次</text>
        </view>
        <view class="mine-stat-divider"></view>
        <view class="mine-stat-item">
          <text class="mine-stat-num">{{ avgSatisfaction }}</text>
          <text class="mine-stat-label">平均满意度</text>
        </view>
        <view class="mine-stat-divider"></view>
        <view class="mine-stat-item">
          <text class="mine-stat-num">{{ totalParticipants }}</text>
          <text class="mine-stat-label">参与人数</text>
        </view>
      </view>
    </view>

    <view class="mine-menu-card" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="mine-menu-item" @click="goAuthed('/pages/mine/TrainingRecords')">
        <AppIcon class="mine-menu-icon-image" src="/static/icons/mine-records.svg" size="40rpx" />
        <text class="mine-menu-label">培训记录</text>
        <AppIcon name="stateChevronRight" size="18rpx" />
      </view>
      <view class="mine-menu-item mine-menu-last" @click="goAuthed('/pages/mine/DataDetail')">
        <AppIcon class="mine-menu-icon-image" src="/static/icons/mine-stats.svg" size="40rpx" />
        <text class="mine-menu-label">数据详情</text>
        <AppIcon name="stateChevronRight" size="18rpx" />
      </view>
    </view>

    <view class="mine-menu-card" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
      <view class="mine-menu-item" @click="uni.navigateTo({ url: '/pages/mine/Settings' })">
        <AppIcon class="mine-menu-icon-image" src="/static/icons/mine-settings.svg" size="40rpx" />
        <text class="mine-menu-label">设置</text>
        <AppIcon name="stateChevronRight" size="18rpx" />
      </view>
      <view class="mine-menu-item" @click="uni.navigateTo({ url: '/pages/mine/HelpFeedback' })">
        <AppIcon class="mine-menu-icon-image" src="/static/icons/mine-feedback.svg" size="40rpx" />
        <text class="mine-menu-label">帮助与反馈</text>
        <AppIcon name="stateChevronRight" size="18rpx" />
      </view>
      <view class="mine-menu-item mine-menu-last" @click="uni.navigateTo({ url: '/pages/mine/About' })">
        <AppIcon class="mine-menu-icon-image" src="/static/icons/mine-about.svg" size="40rpx" />
        <text class="mine-menu-label">关于</text>
        <AppIcon name="stateChevronRight" size="18rpx" />
      </view>
    </view>

    <HalfSheet :visible="showProfileEdit" size="compact" title="编辑资料" @update:visible="showProfileEdit = $event">
      <view class="profile-edit-form">
        <text class="profile-edit-label">昵称</text>
        <input class="profile-edit-input" v-model="editNickname" placeholder="请输入昵称" placeholder-class="input-placeholder" maxlength="20" />
      </view>
      <template #footer>
        <view class="profile-save-btn" @click="saveProfile">
          <text class="profile-save-btn-text">保存</text>
        </view>
      </template>
    </HalfSheet>
  </view>
</template>

