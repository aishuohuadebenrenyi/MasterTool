<script setup>
import { ref, computed, onMounted } from 'vue'
import { usePlanStore } from '../../stores/plan'
import { getPlanTypeLabel } from '../../utils/constants'
import * as feedbackApi from '../../api/feedback'

const planStore = usePlanStore()

const activeFilter = ref<string>('全部')
const filters = ['全部', '企业培训', '团建活动', '即兴演出', '即兴培训']
const records = ref<Array<UTSJSONObject>>([])
const loading = ref<boolean>(false)

const filteredRecords = computed<Array<UTSJSONObject>>(() => {
  if (activeFilter.value === '全部') return records.value
  return records.value.filter((r : UTSJSONObject) => r['category'] === activeFilter.value)
})

function setFilter(f : string) {
  activeFilter.value = f
}

function formatDate(raw : string | null) : string {
  if (!raw) return '待更新'
  if (raw.indexOf('T') > -1) {
    return raw.split('T')[0]
  }
  return raw
}

async function buildRecord(plan : UTSJSONObject) : Promise<UTSJSONObject> {
  const sessionId = (plan['sessionId'] as string) || ''
  let satisfaction = '--'
  let nps = '--'
  if (sessionId.length > 0) {
    try {
      const stats = await feedbackApi.getFeedbackStats(sessionId)
      satisfaction = String((stats['avgSatisfaction'] as number) || 0)
      nps = String((stats['nps'] as number) || 0)
    } catch (_e : unknown) {
    }
  }
  return {
    id: plan['id'],
    title: plan['name'],
    category: getPlanTypeLabel(plan['type'] as string),
    date: formatDate((plan['date'] as string) || (plan['updatedAt'] as string) || (plan['createdAt'] as string)),
    participants: String(plan['people'] || 0),
    satisfaction,
    nps,
    status: plan['status']
  } as UTSJSONObject
}

async function loadRecords() {
  loading.value = true
  try {
    await planStore.fetchPlans()
    const plans = planStore.plans.filter((plan : UTSJSONObject) => {
      const status = plan['status'] as string
      return status === 'delivered' || status === 'reviewed'
    })
    const nextRecords : Array<UTSJSONObject> = []
    for (let i = 0; i < plans.length; i++) {
      nextRecords.push(await buildRecord(plans[i]))
    }
    records.value = nextRecords
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  loadRecords()
})
</script>

<template>
  <view class="page">
    <view class="navbar">
      <view class="navbar-back" @click="uni.navigateBack()">
        <text class="navbar-back-icon">‹</text>
      </view>
      <text class="navbar-title">培训记录</text>
      <view class="navbar-placeholder"></view>
    </view>

    <view class="filter-bar">
      <view
        v-for="f in filters"
        :key="f"
        :class="['filter-chip', activeFilter === f ? 'filter-chip-active' : '']"
        @click="setFilter(f)"
      >
        <text :class="['filter-chip-text', activeFilter === f ? 'filter-chip-text-active' : '']">{{ f }}</text>
      </view>
    </view>

    <scroll-view class="record-list" scroll-y>
      <view v-if="loading" class="empty-state">
        <text class="empty-state-text">正在加载培训记录...</text>
      </view>
      <view v-else-if="filteredRecords.length === 0" class="empty-state">
        <text class="empty-state-text">暂无符合条件的培训记录</text>
      </view>
      <view
        v-for="item in filteredRecords"
        :key="item['id']"
        class="record-card"
      >
        <view class="record-header">
          <text class="record-title">{{ item['title'] }}</text>
          <view class="record-category-tag">
            <text class="record-category-text">{{ item['category'] }}</text>
          </view>
        </view>
        <text class="record-date">{{ item['date'] }}</text>
        <view class="record-stats">
          <view class="record-stat">
            <text class="record-stat-value">{{ item['participants'] }}</text>
            <text class="record-stat-label">参与人数</text>
          </view>
          <view class="record-stat-divider"></view>
          <view class="record-stat">
            <text class="record-stat-value">{{ item['satisfaction'] }}</text>
            <text class="record-stat-label">满意度</text>
          </view>
          <view class="record-stat-divider"></view>
          <view class="record-stat">
            <text class="record-stat-value">{{ item['nps'] }}</text>
            <text class="record-stat-label">NPS</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

