<script setup>
import { computed } from 'vue'
import { calcNavBarInfo } from '../utils/navbar'
import { getDesktopMaxWidth } from '../utils/viewport'
import AppIcon from './AppIcon.uvue'

const props = defineProps({
  title: { type: String, default: '' },
  showBack: { type: Boolean, default: true },
  backgroundColor: { type: String, default: '#1A1A2E' },
  titleColor: { type: String, default: '#FFFFFF' },
  backIconColor: { type: String, default: '#FFFFFF' }
})

defineEmits(['back'])

const navBarInfo = calcNavBarInfo()
const statusBarHeight = navBarInfo['statusBarHeight'] as number
const navBarHeight = navBarInfo['navBarHeight'] as number
const contentHeight = navBarInfo['contentHeight'] as number
const leftSafeWidth = navBarInfo['leftSafeWidth'] as number
const rightSafeWidth = navBarInfo['rightSafeWidth'] as number
const capsuleMarginRight = navBarInfo['capsuleMarginRight'] as number
const contentTopOffset = navBarInfo['contentTopOffset'] as number
const maxWidth = getDesktopMaxWidth()

const backIconName = computed<string>(() => {
  return props.backIconColor === '#FFFFFF' ? 'stateBackLight' : 'stateBack'
})
</script>

<template>
  <view class="navbar" :style="{ backgroundColor }">
    <view class="navbar-statusbar" :style="{ height: statusBarHeight + 'px' }"></view>
    <view class="navbar-content-outer">
      <view class="navbar-content" :style="{ height: contentHeight + 'px', maxWidth: maxWidth > 0 ? maxWidth + 'px' : 'none' }">
      <view v-if="showBack" class="navbar-back" :style="{ minWidth: leftSafeWidth + 'px' }" @click="$emit('back')">
        <view class="back-icon-box" :style="{ marginLeft: capsuleMarginRight + 'px' }">
          <AppIcon :name="backIconName" size="36rpx" />
        </view>
      </view>
      <view v-else class="navbar-back-placeholder" :style="{ minWidth: leftSafeWidth + 'px' }"></view>
      <view class="navbar-title-wrap" :style="{ left: leftSafeWidth + 'px', right: rightSafeWidth + 'px' }">
        <text class="navbar-title" :style="{ color: titleColor }">{{ title }}</text>
      </view>
      <view class="navbar-right" :style="{ minWidth: rightSafeWidth + 'px', paddingRight: capsuleMarginRight + 'px' }">
        <slot name="right"></slot>
      </view>
      </view>
    </view>
  </view>
  <view :style="{ height: contentTopOffset + 'px' }"></view>
</template>

<style scoped>
.navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}
.navbar-statusbar {
}
.navbar-content-outer {
  width: 100%;
  display: flex;
  justify-content: center;
}
.navbar-content { width: 100%; display: flex; align-items: center; justify-content: space-between; position: relative; box-sizing: border-box; }
.navbar-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 100%;
  flex-shrink: 0;
  z-index: 1;
}
.back-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: rgba(255, 255, 255, 0.18);
  border-width: 2rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.navbar-back-placeholder {
  height: 100%;
  flex-shrink: 0;
}
.navbar-title-wrap {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
}
.navbar-right {
  flex-shrink: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
</style>
