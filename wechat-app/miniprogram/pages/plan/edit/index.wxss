.plan-edit-page {
  min-height: 100vh;
  background: #F5F5F7;
  color: #1A1A2E;
}

.edit-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: 184rpx;
  box-sizing: border-box;
  padding: 88rpx 32rpx 0;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F5;
}

.edit-back {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  color: #333333;
  font-size: 50rpx;
  line-height: 1;
}

.edit-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  color: #000000;
  font-size: 32rpx;
  font-weight: 900;
  text-align: center;
}

.preview-btn {
  margin-left: auto;
  margin-right: 152rpx;
  position: relative;
  z-index: 2;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: #EEF2FF;
  color: #4A7CF7;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.edit-scroll {
  height: 100vh;
}

.edit-content {
  padding: 212rpx 32rpx 180rpx;
}

.edit-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item.last {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-half {
  flex: 1;
  min-width: 0;
}

.form-label {
  margin-bottom: 16rpx;
  color: #8E8E93;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #E5E5EA;
  border-radius: 18rpx;
  background: #F8F9FE;
  color: #1A1A2E;
  font-size: 28rpx;
}

.number-input {
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  height: 88rpx;
  overflow: hidden;
  border: 1rpx solid #E5E5EA;
  border-radius: 18rpx;
  background: #F8F9FE;
}

.number-btn,
.number-value {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4A7CF7;
  font-size: 32rpx;
  font-weight: 900;
}

.number-value {
  background: #FFFFFF;
  color: #1A1A2E;
}

.type-tag {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #4A7CF7;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-title {
  color: #1A1A2E;
  font-size: 32rpx;
  font-weight: 900;
}

.section-action {
  color: #4A7CF7;
  font-size: 28rpx;
  font-weight: 800;
}

.phase-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 24rpx 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F8F9FE;
}

.phase-badge {
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
}

.phase-info {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.phase-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.phase-name {
  color: #1A1A2E;
  font-size: 29rpx;
  font-weight: 900;
}

.phase-source-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF1FF;
  color: #4A7CF7;
  font-size: 20rpx;
  font-weight: 800;
}

.phase-duration {
  margin-top: 6rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.phase-subtitle {
  margin-top: 10rpx;
  color: #5B6475;
  font-size: 22rpx;
}

.phase-activity-list {
  margin-top: 14rpx;
}

.phase-activity-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.phase-activity-main {
  flex: 1;
  min-width: 0;
}

.phase-activity-name {
  color: #1A1A2E;
  font-size: 25rpx;
  font-weight: 800;
}

.phase-activity-meta {
  margin-top: 6rpx;
  color: #8E8E93;
  font-size: 22rpx;
}

.phase-activity-remove {
  flex-shrink: 0;
  min-width: 84rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #FFF1F2;
  color: #E5484D;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.phase-activity-empty {
  margin-top: 14rpx;
  color: #A0A4AD;
  font-size: 24rpx;
}

.phase-actions {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  width: 196rpx;
  margin-left: 16rpx;
  margin-top: 66rpx;
}

.phase-actions-inline {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  width: 100%;
}

.phase-action {
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  background: #EEF2FF;
  color: #4A7CF7;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.phase-action.pick {
  min-width: 88rpx;
  background: #EAF1FF;
}

.phase-action.disabled {
  opacity: 0.35;
}

.phase-delete-btn {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  z-index: 2;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #FFF1F2;
  color: #E5484D;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.phase-total {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #F0F0F5;
  color: #8E8E93;
  font-size: 26rpx;
}

.phase-empty {
  min-height: 160rpx;
  color: #8E8E93;
  font-size: 28rpx;
  line-height: 160rpx;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.bottom-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-align: center;
}

.bottom-btn.secondary {
  background: #4A7CF7;
}

.bottom-btn.tertiary {
  background: #E9ECF4;
  color: #4A5568;
}

.bottom-btn.primary {
  background: #34C759;
}

.bottom-btn.disabled {
  opacity: 0.58;
}

.sheet-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.38);
}

.half-sheet {
  width: 100%;
  max-height: 82vh;
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
  background: #FFFFFF;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 4rpx;
  background: #D6D8DE;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 900;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F4F5F8;
  color: #9A9EA8;
  font-size: 32rpx;
  line-height: 64rpx;
  text-align: center;
}

.sheet-body {
  padding: 24rpx 32rpx;
}

.phase-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.phase-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 128rpx;
  border-radius: 20rpx;
  background: #F6F7FB;
}

.phase-type-item.active {
  background: #EAF0FF;
  color: #4A7CF7;
}

.phase-type-icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 10rpx;
}

.phase-type-name {
  font-size: 26rpx;
  font-weight: 800;
}

.popup-form {
  margin-top: 24rpx;
}

.popup-label {
  margin-top: 20rpx;
}

.sheet-footer {
  padding: 20rpx 32rpx calc(38rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F0F0;
}

.sheet-primary {
  height: 84rpx;
  border-radius: 20rpx;
  background: #4A7CF7;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 84rpx;
  text-align: center;
}

.activity-picker-list {
  margin-top: 20rpx;
}

.activity-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
}

.activity-picker-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.activity-picker-name {
  color: #1A1A2E;
  font-size: 28rpx;
  font-weight: 900;
}

.activity-picker-meta {
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 24rpx;
  line-height: 1.5;
}

.activity-picker-action {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #EAF1FF;
  color: #4A7CF7;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.activity-picker-empty {
  padding: 56rpx 0;
  color: #A0A4AD;
  font-size: 26rpx;
  text-align: center;
}
