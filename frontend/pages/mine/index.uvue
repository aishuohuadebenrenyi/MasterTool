        <text class="mine-menu-label">数据详情</text>
        <AppIcon name="stateChevronRight" size="18rpx" />
      </view>
    </view>

    <view class="mine-menu-card" :style="{ maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }">
