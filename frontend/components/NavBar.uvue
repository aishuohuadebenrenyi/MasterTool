  width: 76rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
}
.back-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
