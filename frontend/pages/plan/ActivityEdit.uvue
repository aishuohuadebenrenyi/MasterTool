<script setup>
import { ref } from 'vue'
import { useActivityStore } from '../../stores/activity'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'

const activityStore = useActivityStore()

const form = ref<UTSJSONObject>({
  name: '',
  scenes: [] as Array<string>,
  difficulty: '',
  participants: '',
  duration: '',
  objective: '',
  rules: '',
  reviewQuestions: '',
  leaderTips: ''
})

const categories = ref<Array<string>>(['团队融合', '协作沟通', '领导力', '创新思维', '情绪管理'])
const difficulties = ref<Array<string>>(['简单', '中等', '困难'])
const isEditing = ref<boolean>(false)
const editingId = ref<string>('')

function toggleScene(tag : string) {
  const currentScenes = form.value['scenes'] as Array<string>
  const idx = currentScenes.indexOf(tag)
  if (idx === -1) {
    currentScenes.push(tag)
  } else {
    currentScenes.splice(idx, 1)
  }
}

function selectDifficulty(tag : string) {
  form.value['difficulty'] = tag
}

function isSceneSelected(tag : string) : boolean {
  const currentScenes = form.value['scenes'] as Array<string>
  return currentScenes.indexOf(tag) !== -1
}

function isDifficultySelected(tag : string) : boolean {
  return (form.value['difficulty'] as string) === tag
}

async function handleSave() {
  if (!(form.value['name'] as string).trim()) {
    uni.showToast({ title: '请输入活动名称', icon: 'none' })
    return
  }
  try {
    if (isEditing.value && editingId.value) {
      await activityStore.updateActivity(editingId.value, { ...form.value })
    } else {
      await activityStore.createActivity({ ...form.value })
    }
    uni.navigateBack()
  } catch (e : unknown) {
    uni.showToast({ title: '保存失败', icon: 'none' })
  }
}

async function handleDelete() {
  if (!isEditing.value || !editingId.value) return
  uni.showModal({
    title: '确认删除',
    content: '删除后无法恢复',
    success: async (res) => {
      if (res.confirm) {
        try {
          await activityStore.deleteActivity(editingId.value)
          uni.navigateBack()
        } catch (e : unknown) {
          uni.showToast({ title: '删除失败', icon: 'none' })
        }
      }
    }
  })
}

function goBack() {
  uni.navigateBack()
}
</script>

<template>
  <view class="page">
    <NavBar :title="isEditing ? '编辑活动' : '新增活动'" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack" />

    <scroll-view class="form-scroll" scroll-y>
      <view class="form-body">
        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">活动名称</text>
            <text class="form-required">*</text>
          </view>
          <input class="form-input" v-model="form['name']" placeholder="请输入活动名称" placeholder-class="input-placeholder" />
        </view>

        <view class="form-group">
          <text class="form-label">培训场景</text>
          <view class="tag-list">
            <view
              v-for="(tag, index) in categories"
              :key="index"
              class="tag-item"
              :class="{ 'tag-active': isSceneSelected(tag) }"
              @click="toggleScene(tag)"
            >
              <text class="tag-text" :class="{ 'tag-text-active': isSceneSelected(tag) }">{{ tag }}</text>
            </view>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">难度</text>
          <view class="tag-list">
            <view
              v-for="(tag, index) in difficulties"
              :key="index"
              class="tag-item"
              :class="{ 'tag-active': isDifficultySelected(tag) }"
              @click="selectDifficulty(tag)"
            >
              <text class="tag-text" :class="{ 'tag-text-active': isDifficultySelected(tag) }">{{ tag }}</text>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="form-group form-group-half">
            <text class="form-label">人数范围</text>
            <input class="form-input" v-model="form['participants']" placeholder="如：8-20人" placeholder-class="input-placeholder" />
          </view>
          <view class="form-group form-group-half">
            <text class="form-label">时长</text>
            <input class="form-input" v-model="form['duration']" placeholder="如：30min" placeholder-class="input-placeholder" />
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">学习目标</text>
          <input class="form-input" v-model="form['objective']" placeholder="请输入学习目标" placeholder-class="input-placeholder" />
        </view>

        <view class="form-group">
          <text class="form-label">规则说明</text>
          <textarea class="form-textarea" v-model="form['rules']" placeholder="请输入规则说明" placeholder-class="input-placeholder" :rows="4" />
        </view>

        <view class="form-group">
          <text class="form-label">复盘引导问题</text>
          <textarea class="form-textarea" v-model="form['reviewQuestions']" placeholder="请输入复盘引导问题" placeholder-class="input-placeholder" :rows="3" />
        </view>

        <view class="form-group">
          <text class="form-label">带领者Tips</text>
          <textarea class="form-textarea" v-model="form['leaderTips']" placeholder="请输入带领者Tips" placeholder-class="input-placeholder" :rows="3" />
        </view>

        <view class="save-btn" @click="handleSave">
          <text class="save-btn-text">保存活动</text>
        </view>

        <view class="delete-btn" v-if="isEditing" @click="handleDelete">
          <view class="action-inline-icon">
            <AppIcon name="stateDelete" size="22rpx" />
            <text class="delete-btn-text">删除活动</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

