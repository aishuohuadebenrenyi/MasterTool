export function getIconPath(name : string) : string {
  const path = (ICON_PATHS[name] as string) || ''
  return getCompatibleAssetPath(path)
}

export function getCompatibleAssetPath(path : string) : string {
  if (!path) {
    return ''
  }
  if (!isMpWeixinRuntime()) {
    return path
  }
  if (path.endsWith('.svg')) {
    return path.substring(0, path.length - 4) + '.png'
  }
  return path
}
