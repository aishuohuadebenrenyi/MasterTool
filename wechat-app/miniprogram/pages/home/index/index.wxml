<view class="page home-page">
  <view class="home-header">
    <view class="user-left">
      <view class="avatar">{{avatarText}}</view>
      <view class="greeting">{{greetingText}}</view>
    </view>
    <view class="date-text">{{currentDate}}</view>
  </view>

  <view class="hero" bindtap="handleStartTraining">
    <view class="hero-copy">
      <view class="hero-title">我要开课</view>
      <view class="hero-subtitle">开始一场培训</view>
    </view>
    <view class="hero-visual">
      <image class="hero-icon" src="/static/icons/icon-phase-opening.png" mode="aspectFit" />
    </view>
    <view class="hero-deco"></view>
  </view>

  <view class="card quick-card" bindtap="handleReview">
    <view class="quick-icon-wrap">
      <image class="quick-icon-img" src="/static/icons/home-review.png" mode="aspectFit" />
    </view>
    <view>
      <view class="quick-title">我要复盘</view>
      <view class="quick-desc">{{pendingReviewDesc}}</view>
    </view>
  </view>

  <view wx:if="{{hasTodoItems}}" class="section-title">待处理</view>

  <view wx:if="{{hasTodoItems}}" class="todo-list">
    <view wx:if="{{summary.pendingStartCount > 0}}" class="card todo-item" bindtap="handlePendingStart">
      <view class="todo-icon-wrap">
        <image class="todo-icon-img" src="/static/icons/icon-phase-opening.png" mode="aspectFit" />
      </view>
      <view class="todo-text">{{summary.pendingStartCount}} 个方案待开课</view>
      <view class="todo-arrow">›</view>
    </view>
    <view wx:if="{{summary.draftPlanCount > 0}}" class="card todo-item" bindtap="handleDraftPlans">
      <view class="todo-icon-wrap">
        <image class="todo-icon-img" src="/static/icons/icon-state-document.png" mode="aspectFit" />
      </view>
      <view class="todo-text">{{summary.draftPlanCount}} 个草稿方案</view>
      <view class="todo-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{showPlanSelect}}" class="sheet-mask" catchtap="closePlanSelect">
    <view class="half-sheet compact" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <view class="sheet-title">选择开课入口</view>
        <view class="sheet-close" catchtap="closePlanSelect">
          <image class="sheet-close-img" src="/static/icons/icon-state-close.png" mode="aspectFit" />
        </view>
      </view>
      <scroll-view class="sheet-body" scroll-y>
        <view class="my-plan-option" catchtap="selectFromMyPlans">
          <view class="my-plan-icon-box">
            <image class="option-icon" src="/static/icons/icon-state-document.png" mode="aspectFit" />
          </view>
          <view class="my-plan-info">
            <view class="my-plan-title">从我的方案</view>
            <view class="my-plan-desc">直接进入备课页，优先筛选已确认方案</view>
          </view>
          <image class="option-chevron" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
        </view>

        <view class="template-section-label">从公共模板新建方案</view>
        <view
          wx:for="{{flowTemplates}}"
          wx:key="_id"
          class="template-card"
          data-id="{{item._id}}"
          catchtap="selectTemplate"
        >
          <view class="template-card-icon-box">
            <image class="template-card-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <view class="template-card-info">
            <view class="template-card-name-row">
              <view class="template-card-name">{{item.name}}</view>
              <view class="template-card-badge">{{item.tag}}</view>
            </view>
            <view class="template-card-desc">{{item.flowText}}</view>
          </view>
          <image class="option-chevron" src="/static/icons/icon-state-chevron-right.png" mode="aspectFit" />
        </view>
      </scroll-view>
    </view>
  </view>
</view>
