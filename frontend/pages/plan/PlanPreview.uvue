<script setup>
import { ref, computed } from 'vue'
import { usePlanStore } from '../../stores/plan'
import { PLAN_TYPE_LABELS, PLAN_STATUS_LABELS } from '../../utils/constants'
import NavBar from '../../components/NavBar.uvue'

const planStore = usePlanStore()

const viewMode = ref<string>('trainer')
const planId = ref<string>('')

const plan = computed(() => planStore.currentPlan)

const planName = computed<string>(() => (plan.value?.['name'] as string) || '')
const planType = computed<string>(() => {
  const type = plan.value?.['type'] as string
  return (PLAN_TYPE_LABELS[type] as string) || type || ''
})
const planTypeIcon = computed<string>(() => {
  const type = plan.value?.['type'] as string
  const icons : UTSJSONObject = {
    'improv_training': '🎭',
    'team_building': '🤝',
    'workshop': '🔧',
    'lecture': '📚',
    'custom': '⚙️'
  }
  return (icons[type] as string) || '📋'
})
const planPeople = computed<string>(() => plan.value?.['people'] != null ? String(plan.value['people']) : '')
const planClient = computed<string>(() => (plan.value?.['client'] as string) || '')
const planDuration = computed<number>(() => (plan.value?.['duration'] as number) || 0)
const planStatus = computed<string>(() => {
  const status = plan.value?.['status'] as string
  return (PLAN_STATUS_LABELS[status] as string) || status || ''
})
const planStatusClass = computed<string>(() => {
  const status = plan.value?.['status'] as string
  return status ? 'status-' + status : ''
})
const planDate = computed<string>(() => (plan.value?.['date'] as string) || '')
const planScene = computed<string>(() => (plan.value?.['scene'] as string) || '')
const phases = computed<Array<UTSJSONObject>>(() => (plan.value?.['phases'] as Array<UTSJSONObject>) || [])

const totalDuration = computed<number>(() => {
  if (planDuration.value > 0) return planDuration.value
  let total = 0
  for (let i = 0; i < phases.value.length; i++) {
    total += (phases.value[i]['duration'] as number) || 0
  }
  return total
})

const phaseColors : Array<string> = ['#4A7CF7', '#34C759', '#FF9500', '#AF52DE', '#FF2D55', '#5AC8FA']
const phaseIcons : Array<string> = ['🎬', '❄️', '🎯', '📝', '🔄', '💡']

function getPhaseColor(index : number) : string {
  return phaseColors[index % phaseColors.length]
}

function getPhaseIcon(index : number) : string {
  return phaseIcons[index % phaseIcons.length]
}

function getPhasePercent(duration : number) : string {
  if (totalDuration.value === 0) return '0'
  return Math.round((duration / totalDuration.value) * 100).toString()
}

function getPhaseDuration(phase : UTSJSONObject) : number {
  return (phase['duration'] as number) || 0
}

onLoad((options) => {
  if (options != null && options['id'] != null) {
    planId.value = options['id'] as string
    planStore.fetchPlanDetail(options['id'] as string)
  }
})

function goBack() {
  uni.navigateBack()
}

function switchView(mode : string) {
  viewMode.value = mode
}

function formatDuration(minutes : number) : string {
  if (minutes < 60) return `${minutes}分钟`
  const h = Math.floor(minutes / 60)
  const m = minutes % 60
  return m > 0 ? `${h}小时${m}分钟` : `${h}小时`
}
</script>

<template>
  <view class="page">
    <NavBar title="方案预览" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack" />

    <view class="content">
      <view class="toggle-bar">
        <view class="toggle-wrapper">
          <view
            class="toggle-item"
            :class="{ 'toggle-active': viewMode === 'trainer' }"
            @click="switchView('trainer')"
          >
            <text class="toggle-text" :class="{ 'toggle-text-active': viewMode === 'trainer' }">培训师视角</text>
          </view>
          <view
            class="toggle-item"
            :class="{ 'toggle-active': viewMode === 'client' }"
            @click="switchView('client')"
          >
            <text class="toggle-text" :class="{ 'toggle-text-active': viewMode === 'client' }">客户视角</text>
          </view>
        </view>
      </view>

      <view class="export-btn-disabled">
        <text class="export-btn-text">📄 导出方案文档（即将上线）</text>
      </view>

      <view class="summary-card">
        <text class="summary-name">{{ planName }}</text>
        <view class="summary-meta-row">
          <text class="summary-meta-text">{{ planTypeIcon }} {{ planType }}</text>
          <text class="summary-meta-dot" v-if="planPeople">·</text>
          <text class="summary-meta-text" v-if="planPeople">👥 {{ planPeople }}人</text>
          <text class="summary-meta-dot" v-if="planDate">·</text>
          <text class="summary-meta-text" v-if="planDate">📅 {{ planDate }}</text>
        </view>
        <view class="summary-meta-row">
          <text class="summary-meta-text">⏱ {{ formatDuration(totalDuration) }}</text>
          <text class="summary-meta-dot">·</text>
          <text class="summary-meta-text">📋 {{ phases.length }}个环节</text>
          <text class="summary-meta-dot">·</text>
          <view :class="['status-tag', planStatusClass]">
            <text class="status-tag-text">{{ planStatus }}</text>
          </view>
        </view>
        <view class="summary-tags" v-if="planType || planScene">
          <view class="tag-item" v-if="planType">
            <text class="tag-text">{{ planType }}</text>
          </view>
          <view class="tag-item tag-scene" v-if="planScene">
            <text class="tag-text tag-scene-text">{{ planScene }}</text>
          </view>
        </view>
      </view>

      <view class="timeline-section" v-if="phases.length > 0">
        <view class="timeline-header">
          <text class="timeline-title">🔄 环节流程（总时长 {{ totalDuration }} 分钟）</text>
        </view>
        <view class="timeline">
          <view class="timeline-item" v-for="(phase, index) in phases" :key="index">
            <view class="timeline-left">
              <view class="timeline-dot" :style="{ backgroundColor: getPhaseColor(index) }"></view>
              <view class="timeline-line" v-if="index < phases.length - 1"></view>
            </view>
            <view class="timeline-right">
              <view class="timeline-phase-header">
                <text class="timeline-phase-name">{{ getPhaseIcon(index) }} {{ phase['name'] }}</text>
                <text class="timeline-phase-duration">{{ getPhaseDuration(phase) }}分钟 · {{ getPhasePercent(getPhaseDuration(phase)) }}%</text>
              </view>
              <view class="timeline-progress-bg">
                <view class="timeline-progress-fill" :style="{ width: getPhasePercent(getPhaseDuration(phase)) + '%', backgroundColor: getPhaseColor(index) }"></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-phases" v-else>
        <text class="empty-phases-text">暂无环节安排</text>
      </view>
    </view>
  </view>
</template>

