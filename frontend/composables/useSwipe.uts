import { ref } from 'vue'

type SwipeOptions = {
  threshold ?: number
  onSwipeLeft ?: () => void
  onSwipeRight ?: () => void
}

export function useSwipe(options : SwipeOptions = {} as SwipeOptions) {
  const { threshold = 80, onSwipeLeft, onSwipeRight } = options

  const startX = ref<number>(0)
  const startY = ref<number>(0)
  const offsetX = ref<number>(0)
  const isSwiping = ref<boolean>(false)
  const direction = ref<string>('')

  function onTouchStart(e : any) {
    const touch = e.touches?.[0] || e
    startX.value = touch.clientX
    startY.value = touch.clientY
    offsetX.value = 0
    isSwiping.value = true
    direction.value = ''
  }

  function onTouchMove(e : any) {
    if (!isSwiping.value) return
    const touch = e.touches?.[0] || e
    const deltaX = touch.clientX - startX.value
    const deltaY = Math.abs(touch.clientY - startY.value)

    if (deltaY > Math.abs(deltaX)) {
      isSwiping.value = false
      offsetX.value = 0
      return
    }

    if (deltaX < 0) {
      direction.value = 'left'
      offsetX.value = Math.max(deltaX, -threshold * 1.5)
    } else if (deltaX > 0) {
      direction.value = 'right'
      offsetX.value = Math.min(deltaX, threshold * 1.5)
    }
  }

  function onTouchEnd() {
    if (!isSwiping.value) return
    isSwiping.value = false

    if (Math.abs(offsetX.value) >= threshold) {
      if (direction.value === 'left') {
        offsetX.value = -threshold
        onSwipeLeft?.()
      } else if (direction.value === 'right') {
        offsetX.value = 0
        onSwipeRight?.()
      }
    } else {
      offsetX.value = 0
      direction.value = ''
    }
  }

  function resetSwipe() {
    offsetX.value = 0
    direction.value = ''
    isSwiping.value = false
  }

  return {
    offsetX,
    isSwiping,
    direction,
    onTouchStart,
    onTouchMove,
    onTouchEnd,
    resetSwipe
  }
}
