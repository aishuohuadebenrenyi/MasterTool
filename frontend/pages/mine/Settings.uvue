<script setup>
import { computed, onMounted } from 'vue'
import { useConfigStore } from '../../stores/config'
import NavBar from '../../components/NavBar.uvue'

const configStore = useConfigStore()

const swipeNext = computed<boolean>(() => configStore.swipeNextEnabled)
const swipePrev = computed<boolean>(() => configStore.swipePrevEnabled)
const doubleTapDelay = computed<boolean>(() => configStore.doubleTapDelayEnabled)
const timerSound = computed<boolean>(() => configStore.soundEnabled)
const autoSave = computed<boolean>(() => configStore.autoSaveNotes)

function toggleSwipeNext() {
  configStore.toggleSwipeNext()
}
function toggleSwipePrev() {
  configStore.toggleSwipePrev()
}
function toggleDoubleTapDelay() {
  configStore.toggleDoubleTapDelay()
}
function toggleTimerSound() {
  configStore.toggleSound()
}
function toggleAutoSave() {
  configStore.toggleAutoSave()
}

onMounted(() => {
  configStore.restoreConfig()
})
</script>

<template>
  <view class="page">
    <NavBar title="设置" @back="uni.navigateBack()" />

    <scroll-view class="content" scroll-y>
      <view class="section-card">
        <text class="section-title">手势控制</text>
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-label">左滑推进</text>
            <text class="setting-desc">向左滑动推进到下一步</text>
          </view>
          <view :class="['toggle', swipeNext ? 'toggle-on' : 'toggle-off']" @click="toggleSwipeNext">
            <view class="toggle-thumb"></view>
          </view>
        </view>
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-label">右滑回退</text>
            <text class="setting-desc">向右滑动回退到上一步</text>
          </view>
          <view :class="['toggle', swipePrev ? 'toggle-on' : 'toggle-off']" @click="toggleSwipePrev">
            <view class="toggle-thumb"></view>
          </view>
        </view>
        <view class="setting-item setting-item-last">
          <view class="setting-info">
            <text class="setting-label">双击延时</text>
            <text class="setting-desc">双击屏幕启动延时计时</text>
          </view>
          <view :class="['toggle', doubleTapDelay ? 'toggle-on' : 'toggle-off']" @click="toggleDoubleTapDelay">
            <view class="toggle-thumb"></view>
          </view>
        </view>
      </view>

      <view class="section-card">
        <text class="section-title">其他</text>
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-label">计时器声音</text>
            <text class="setting-desc">倒计时结束时播放提示音</text>
          </view>
          <view :class="['toggle', timerSound ? 'toggle-on' : 'toggle-off']" @click="toggleTimerSound">
            <view class="toggle-thumb"></view>
          </view>
        </view>
        <view class="setting-item setting-item-last">
          <view class="setting-info">
            <text class="setting-label">自动保存</text>
            <text class="setting-desc">自动保存培训记录和进度</text>
          </view>
          <view :class="['toggle', autoSave ? 'toggle-on' : 'toggle-off']" @click="toggleAutoSave">
            <view class="toggle-thumb"></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

