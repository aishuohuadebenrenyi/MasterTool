<script setup>
import { ref, computed } from 'vue'
import { usePlanStore } from '../../stores/plan'
import { PLAN_STATUS, getPlanTypeLabel, normalizePlanType } from '../../utils/constants'
import NavBar from '../../components/NavBar.uvue'
import HalfSheet from '../../components/HalfSheet.uvue'
import AppIcon from '../../components/AppIcon.uvue'

const planStore = usePlanStore()

const planId = ref('')
const planName = ref('')
const planType = ref('')
const planPeople = ref('')
const planClient = ref('')
const planStatus = ref('')
const phases = ref<Array<UTSJSONObject>>([])
const addPhaseVisible = ref(false)
const newPhaseName = ref('')
const newPhaseDuration = ref('10')
const saving = ref(false)

const typeOptions = ['企业培训', '团建活动', '即兴演出', '即兴训练', '自定义']

const phaseTypeList = [
  { name: '计时练习', iconName: 'toolTimer' },
  { name: '随机抽取', iconName: 'toolRandom' },
  { name: '场景模拟', iconName: 'phaseSimulation' },
  { name: '反思分享', iconName: 'phaseReflection' },
  { name: '自定义环节', iconName: 'phaseCustom' }
] as Array<UTSJSONObject>

const badgeColors = ['#4A7CF7', '#34C759', '#FF9500', '#AF52DE', '#FF3B30', '#5AC8FA', '#FFCC00', '#8E8E93']

const isDraft = computed(() => {
  return !planStatus.value || planStatus.value === PLAN_STATUS['DRAFT'] as string
})

const isConfirmed = computed(() => {
  return planStatus.value === PLAN_STATUS['CONFIRMED'] as string
})

const isReadonly = computed(() => {
  return planStatus.value === PLAN_STATUS['DELIVERED'] as string || planStatus.value === PLAN_STATUS['REVIEWED'] as string
})

const totalDuration = computed(() => {
  let total = 0
  for (let i = 0; i < phases.value.length; i++) {
    total += (phases.value[i]['duration'] as number) || 0
  }
  return total
})

const planTypeLabel = computed<string>(() => getPlanTypeLabel(planType.value))

onLoad((options) => {
  if (options != null && options['id'] != null) {
    planId.value = options['id'] as string
    loadPlan(options['id'] as string)
  }
})

async function loadPlan(id : string) {
  try {
    const data = await planStore.fetchPlanDetail(id)
    if (data != null) {
      planName.value = (data['name'] as string) || ''
      planType.value = normalizePlanType((data['type'] as string) || '')
      planPeople.value = data['people'] != null ? String(data['people']) : ''
      planClient.value = (data['client'] as string) || ''
      planStatus.value = (data['status'] as string) || ''
      phases.value = (data['phases'] as Array<UTSJSONObject>) || []
    }
  } catch (e) {}
}

function decrementPeople() {
  const current = parseInt(planPeople.value) || 0
  if (current > 0) {
    planPeople.value = String(current - 1)
  }
}

function incrementPeople() {
  const current = parseInt(planPeople.value) || 0
  planPeople.value = String(current + 1)
}

function goBack() {
  uni.navigateBack()
}

async function goPreview() {
  if (!planId.value) {
    await doSave(PLAN_STATUS['DRAFT'] as string)
  }
  if (planId.value) {
    uni.navigateTo({ url: `/pages/plan/PlanPreview?id=${planId.value}` })
  }
}

function showAddPhase() {
  newPhaseName.value = ''
  newPhaseDuration.value = '10'
  addPhaseVisible.value = true
}

function hideAddPhase() {
  addPhaseVisible.value = false
}

function selectPhaseType(item : UTSJSONObject) {
  newPhaseName.value = item['name'] as string
}

function confirmAddPhase() {
  if (!newPhaseName.value) return
  phases.value.push({
    name: newPhaseName.value,
    duration: parseInt(newPhaseDuration.value) || 10,
    type: newPhaseName.value
  } as UTSJSONObject)
  addPhaseVisible.value = false
}

function removePhase(index : number) {
  phases.value.splice(index, 1)
}

function moveUp(index : number) {
  if (index <= 0) return
  const item = phases.value[index]
  phases.value.splice(index, 1)
  phases.value.splice(index - 1, 0, item)
}

function moveDown(index : number) {
  if (index >= phases.value.length - 1) return
  const item = phases.value[index]
  phases.value.splice(index, 1)
  phases.value.splice(index + 1, 0, item)
}

function getBadgeColor(index : number) : string {
  return badgeColors[index % badgeColors.length]
}

function buildPlanData(status : string) : UTSJSONObject {
  return {
    name: planName.value,
    type: normalizePlanType(planType.value),
    people: parseInt(planPeople.value) || 0,
    client: planClient.value,
    phases: phases.value,
    duration: totalDuration.value,
    status: status
  } as UTSJSONObject
}

async function doSave(status : string) {
  const data = buildPlanData(status)
  if (planId.value) {
    await planStore.updatePlan(planId.value, data)
  } else {
    const result = await planStore.createPlan(data)
    planId.value = (result['id'] as string) || ''
  }
}

async function saveDraft() {
  if (saving.value) return
  saving.value = true
  try {
    await doSave(PLAN_STATUS['DRAFT'] as string)
    uni.showToast({ title: '已保存草稿', icon: 'success' })
    setTimeout(() => { uni.navigateBack() }, 500)
  } catch (e) {
    uni.showToast({ title: '保存失败', icon: 'none' })
  } finally {
    saving.value = false
  }
}

async function confirmPlanAction() {
  if (saving.value) return
  if (!planName.value) {
    uni.showToast({ title: '请输入方案名称', icon: 'none' })
    return
  }
  saving.value = true
  try {
    await doSave(PLAN_STATUS['CONFIRMED'] as string)
    if (planId.value) {
      await planStore.confirmPlan(planId.value)
    }
    planStatus.value = PLAN_STATUS['CONFIRMED'] as string
    uni.showToast({ title: '方案已确认', icon: 'success' })
  } catch (e) {
    uni.showToast({ title: '确认失败', icon: 'none' })
  } finally {
    saving.value = false
  }
}

function startTraining() {
  if (planId.value) {
    uni.navigateTo({ url: `/pages/live/index?planId=${planId.value}` })
  }
}
</script>

<template>
  <view class="page">
    <NavBar title="方案编辑" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack">
      <template #right>
        <view class="nav-action" @click="goPreview">
          <text class="nav-action-text">预览</text>
        </view>
      </template>
    </NavBar>

    <view class="content">
      <view class="card">
        <view class="form-item">
          <text class="form-label">方案名称</text>
          <input class="form-input" v-model="planName" placeholder="请输入方案名称" :disabled="isReadonly" />
        </view>
        <view class="form-row">
          <view class="form-item form-item-half">
            <text class="form-label">参与人数</text>
            <view class="number-input">
              <view class="number-btn" @click="!isReadonly && decrementPeople()">
                <text class="number-btn-text">−</text>
              </view>
              <input class="number-field" type="number" v-model="planPeople" :disabled="isReadonly" />
              <view class="number-btn" @click="!isReadonly && incrementPeople()">
                <text class="number-btn-text">+</text>
              </view>
            </view>
          </view>
          <view class="form-item form-item-half">
            <text class="form-label">客户名称</text>
            <input class="form-input" v-model="planClient" placeholder="请输入客户名称" :disabled="isReadonly" />
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">方案类型</text>
          <view class="tag-row" v-if="planType">
            <view class="tag-item tag-active">
              <text class="tag-text tag-text-active">{{ planTypeLabel }}</text>
            </view>
          </view>
          <view class="tag-row" v-else>
            <text class="tag-empty">未设置</text>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="section-header">
          <text class="section-title">环节设置</text>
          <text class="section-action" @click="showAddPhase" v-if="!isReadonly">+ 添加环节</text>
        </view>
        <view class="phase-list" v-if="phases.length > 0">
          <view class="phase-item" v-for="(phase, index) in phases" :key="index">
            <view class="phase-badge" :style="{ backgroundColor: getBadgeColor(index) }">
              <text class="phase-badge-text">{{ index + 1 }}</text>
            </view>
            <view class="phase-info">
              <text class="phase-name">{{ phase['name'] }}</text>
              <text class="phase-duration">{{ phase['duration'] }}分钟</text>
            </view>
            <view class="phase-actions" v-if="!isReadonly">
              <view :class="['phase-action-btn', { disabled: index === 0 }]" @click="moveUp(index)">
                <view class="phase-action-icon phase-action-up">
                  <AppIcon name="stateChevronRight" size="18rpx" />
                </view>
              </view>
              <view :class="['phase-action-btn', { disabled: index === phases.length - 1 }]" @click="moveDown(index)">
                <view class="phase-action-icon phase-action-down">
                  <AppIcon name="stateChevronRight" size="18rpx" />
                </view>
              </view>
              <view class="phase-action-btn phase-action-delete" @click="removePhase(index)">
                <AppIcon name="stateClose" size="18rpx" />
              </view>
            </view>
          </view>
        </view>
        <view class="phase-empty" v-else>
          <text class="phase-empty-text">暂无环节，点击上方添加</text>
        </view>
        <view class="phase-total" v-if="phases.length > 0">
          <text class="phase-total-text">共 {{ phases.length }} 个环节，预计 {{ totalDuration }} 分钟</text>
        </view>
      </view>
    </view>

    <view class="bottom-bar" v-if="!isReadonly">
      <view class="btn-confirm" @click="confirmPlanAction" v-if="isDraft">
        <text class="btn-confirm-text">确认方案</text>
      </view>
      <view class="btn-start" @click="startTraining" v-if="isDraft || isConfirmed">
        <text class="btn-start-text">开始培训</text>
      </view>
    </view>

    <HalfSheet :visible="addPhaseVisible" size="standard" title="添加环节" @update:visible="addPhaseVisible = $event">
      <view class="popup-grid">
        <view
          class="popup-grid-item"
          :class="{ 'popup-grid-item-active': newPhaseName === (item['name'] as string) }"
          v-for="(item, idx) in phaseTypeList"
          :key="idx"
          @click="selectPhaseType(item)"
        >
          <AppIcon :name="item['iconName'] as string" size="36rpx" />
          <text class="popup-grid-label" :class="{ 'popup-grid-label-active': newPhaseName === (item['name'] as string) }">{{ item['name'] }}</text>
        </view>
      </view>
      <view class="popup-form">
        <view class="popup-form-item">
          <text class="popup-form-label">环节名称</text>
          <input class="popup-form-input" v-model="newPhaseName" placeholder="请输入或选择环节类型" />
        </view>
        <view class="popup-form-item">
          <text class="popup-form-label">时长(分钟)</text>
          <input class="popup-form-input" type="number" v-model="newPhaseDuration" placeholder="10" />
        </view>
      </view>
      <template #footer>
        <view class="popup-btn" @click="confirmAddPhase">
          <text class="popup-btn-text">确认添加</text>
        </view>
      </template>
    </HalfSheet>
  </view>
</template>

