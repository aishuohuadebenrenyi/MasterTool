  <view class="page">
    <view class="nav-bar-fixed" :style="{ minHeight: profileHeaderHeight + 'px', paddingTop: contentTopOffset + 'px', paddingLeft: navHorizontalPadding + 'px', paddingRight: rightSafeWidth + 'px' }">
