@import "../../../styles/subpage.wxss";

.settings-page {
  min-height: 100vh;
  background: #F5F5F7;
}

.settings-scroll {
  height: 100vh;
}

.settings-body {
  padding: 212rpx 24rpx 64rpx;
}

.section-card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  margin-bottom: 16rpx;
  color: #8E8E93;
  font-size: 26rpx;
  font-weight: 800;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F0F5;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.setting-title {
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: 800;
}

.setting-desc {
  margin-top: 6rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.switch {
  width: 88rpx;
  height: 50rpx;
  margin-left: 22rpx;
  padding: 4rpx;
  border-radius: 25rpx;
  background: #D8DDE8;
  box-sizing: border-box;
}

.switch view {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.switch.active {
  background: #4A7CF7;
}

.switch.active view {
  transform: translateX(38rpx);
}

.binding-desc,
.binding-expire {
  color: #8E8E93;
  font-size: 24rpx;
  line-height: 1.6;
}

.binding-action {
  margin-top: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #4A7CF7;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

.binding-code {
  margin-top: 18rpx;
  color: #1A1A2E;
  font-family: monospace;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.binding-expire {
  margin-top: 8rpx;
}
