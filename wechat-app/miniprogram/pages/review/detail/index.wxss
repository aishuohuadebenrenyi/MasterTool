@import "../../../styles/subpage.wxss";

.review-page {
  min-height: 100vh;
  background: #F5F5F7;
}

.review-scroll {
  height: 100vh;
}

.review-body {
  padding: 212rpx 32rpx 64rpx;
}

.summary-card,
.review-card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.07);
}

.review-state-card {
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  background: #EEF4FF;
}

.section-title {
  margin-bottom: 18rpx;
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: 900;
}

.quote-item {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #4A7CF7;
  border-radius: 12rpx;
  background: #F6F7FB;
  color: #8A8F99;
  font-size: 25rpx;
  line-height: 1.45;
}

.framework-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.framework-tab {
  height: 72rpx;
  border-radius: 16rpx;
  background: #F1F3F7;
  color: #8A8F99;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.framework-tab.active {
  background: #4A7CF7;
  color: #FFFFFF;
}

.question-card {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: inset 0 0 0 1rpx #EEF0F5;
}

.question-index {
  color: #8A8F99;
  font-size: 24rpx;
}

.question-title {
  margin-top: 18rpx;
  color: #1A1A2E;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.answer-input {
  width: 100%;
  min-height: 210rpx;
  margin-top: 28rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #F8F9FE;
  color: #1A1A2E;
  font-size: 28rpx;
}

.two-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 22rpx;
}

.two-actions .primary-btn,
.two-actions .secondary-btn {
  margin-top: 0;
}

.finish-btn {
  height: 88rpx;
  border-radius: 20rpx;
  background: #34C759;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-align: center;
}

.review-state-meta {
  color: #4A7CF7;
  font-size: 24rpx;
  font-weight: 800;
}

.review-activity-summary {
  margin-top: 16rpx;
  white-space: pre-wrap;
  color: #4B5563;
  font-size: 24rpx;
  line-height: 1.6;
}

.phase-activity-block {
  margin-top: 18rpx;
}

.phase-activity-title {
  color: #1A1A2E;
  font-size: 26rpx;
  font-weight: 800;
}

.phase-activity-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.phase-activity-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #F4F7FF;
  color: #4A7CF7;
  font-size: 22rpx;
  font-weight: 700;
}

.phase-activity-empty {
  margin-top: 10rpx;
  color: #8A8F99;
  font-size: 24rpx;
}

.completed-review-content {
  white-space: pre-wrap;
  color: #1A1A2E;
  font-size: 28rpx;
  line-height: 1.7;
}
