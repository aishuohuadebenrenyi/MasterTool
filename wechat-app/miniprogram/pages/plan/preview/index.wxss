.preview-page {
  min-height: 100vh;
  background: #F5F5F7;
  color: #1A1A2E;
}

.preview-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: 176rpx;
  box-sizing: border-box;
  padding: 88rpx 32rpx 0;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F5;
}

.preview-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #3A3F4B;
  font-size: 50rpx;
  line-height: 1;
}

.preview-title {
  position: absolute;
  right: 128rpx;
  left: 128rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  text-align: center;
}

.preview-scroll {
  height: 100vh;
}

.preview-content {
  padding: 200rpx 32rpx 64rpx;
}

.view-switch {
  margin-bottom: 22rpx;
}

.switch-track {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #E9ECF4;
}

.switch-item {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  color: #8A8F99;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.switch-item.active {
  background: #FFFFFF;
  color: #1A1A2E;
  box-shadow: 0 6rpx 18rpx rgba(31, 36, 51, 0.08);
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 82rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #4A7CF7;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 28rpx rgba(31, 36, 51, 0.05);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.preview-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 36rpx rgba(31, 36, 51, 0.07);
}

.note-title {
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: 900;
}

.note-desc {
  margin-top: 12rpx;
  color: #8A8F99;
  font-size: 26rpx;
  line-height: 1.55;
}

.plan-name {
  color: #111827;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.meta-item {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #F7F8FC;
}

.meta-label {
  color: #8A8F99;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #1A1A2E;
  font-size: 28rpx;
  font-weight: 900;
}

.summary-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.status-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #EAF0FF;
  color: #4A7CF7;
  font-size: 24rpx;
  font-weight: 900;
}

.customer-name {
  color: #8A8F99;
  font-size: 24rpx;
}

.timeline-title {
  margin-bottom: 28rpx;
  color: #1A1A2E;
  font-size: 30rpx;
  font-weight: 900;
}

.timeline-item {
  display: flex;
  min-height: 138rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  margin-top: 8rpx;
  border-radius: 50%;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  margin-top: 8rpx;
  background: #E8E8ED;
}

.timeline-main {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
}

.phase-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.phase-name {
  flex: 1;
  min-width: 0;
  color: #1A1A2E;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.phase-duration {
  flex-shrink: 0;
  color: #8A8F99;
  font-size: 24rpx;
  line-height: 1.35;
}

.phase-activity-panel {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F7F8FC;
}

.phase-activity-title {
  color: #4A7CF7;
  font-size: 22rpx;
  font-weight: 800;
}

.phase-activity-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.phase-activity-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #EAF1FF;
  color: #4A7CF7;
  font-size: 22rpx;
  font-weight: 700;
}

.progress-bg {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #F0F0F0;
}

.progress-fill {
  height: 12rpx;
  border-radius: 999rpx;
}

.phase-note {
  margin-top: 12rpx;
  color: #8A8F99;
  font-size: 24rpx;
  line-height: 1.5;
}
