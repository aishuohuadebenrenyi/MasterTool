<script setup>
import { ref, computed } from 'vue'
import { useActivityStore } from '../../stores/activity'
import { usePlanStore } from '../../stores/plan'
import { getActivitySceneLabel } from '../../utils/constants'
import NavBar from '../../components/NavBar.uvue'
import HalfSheet from '../../components/HalfSheet.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import { showSuccess, showError } from '../../utils/toast'

const activityStore = useActivityStore()
const planStore = usePlanStore()

const activityId = ref<string>('')
const activity = ref<UTSJSONObject | null>(null)
const isFavorite = ref<boolean>(false)
const expandRules = ref<boolean>(false)
const expandReview = ref<boolean>(false)
const expandTips = ref<boolean>(false)
const showAddToPlan = ref<boolean>(false)
const addToPlanStep = ref<number>(1)
const selectedPlanId = ref<string>('')
const selectedPlan = ref<UTSJSONObject | null>(null)

const activityName = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['name'] as string) || ''
})

const categoryLabel = computed(() : string => {
  if (activity.value == null) return ''
  const category = activity.value['category'] as string
  if (!category) return ''
  return getActivitySceneLabel(category)
})

const scenes = computed(() : Array<string> => {
  if (activity.value == null) return []
  const s = activity.value['scenes'] as Array<string> | null
  return s != null ? s.map((scene : string) : string => getActivitySceneLabel(scene)) : []
})

const riskLevel = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['riskLevel'] as string) || ''
})

const difficultyLabel = computed(() : string => {
  if (activity.value == null) return ''
  const d = activity.value['difficulty'] as string
  if (d === 'low' || d === '简单') return '简单'
  if (d === 'medium' || d === '中等') return '中等'
  if (d === 'hard' || d === '困难') return '困难'
  return d || ''
})

const intensityLabel = computed(() : string => {
  if (activity.value == null) return ''
  const i = activity.value['intensity'] as string
  if (i === 'low') return '低'
  if (i === 'medium') return '中'
  if (i === 'high') return '高'
  return i || ''
})

const participants = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['participants'] as string) || ''
})

const duration = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['duration'] as string) || ''
})

const objective = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['objective'] as string) || ''
})

const rules = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['rules'] as string) || ''
})

const reviewQuestions = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['reviewQuestions'] as string) || ''
})

const leaderTips = computed(() : string => {
  if (activity.value == null) return ''
  return (activity.value['leaderTips'] as string) || ''
})

const availablePlans = computed<Array<UTSJSONObject>>(() => {
  return planStore.plans.filter(p => {
    const status = p['status'] as string
    return status === 'draft' || status === 'confirmed'
  })
})

const selectedPlanPhases = computed<Array<UTSJSONObject>>(() => {
  if (!selectedPlan.value) return [] as Array<UTSJSONObject>
  return (selectedPlan.value!['phases'] as Array<UTSJSONObject>) || [] as Array<UTSJSONObject>
})

onLoad((options) => {
  if (options != null && options['id'] != null) {
    activityId.value = options['id'] as string
    loadActivity(options['id'] as string)
  }
})

async function loadActivity(id : string) {
  try {
    const data = await activityStore.fetchActivityDetail(id)
    if (data != null) {
      activity.value = data
      isFavorite.value = (data['isFavorite'] as boolean) || false
    }
  } catch (e) {}
}

function goBack() {
  uni.navigateBack()
}

async function handleToggleFavorite() {
  if (!activityId.value) return
  try {
    await activityStore.toggleFavorite(activityId.value)
    isFavorite.value = !isFavorite.value
  } catch (e) {
    showError('操作失败')
  }
}

function handleAddToPlan() {
  addToPlanStep.value = 1
  selectedPlanId.value = ''
  selectedPlan.value = null
  showAddToPlan.value = true
}

function selectPlanForAdd(plan : UTSJSONObject) {
  selectedPlanId.value = plan['id'] as string
  selectedPlan.value = plan
  addToPlanStep.value = 2
}

function backToPlanList() {
  addToPlanStep.value = 1
}

function selectPhaseForAdd(phaseIndex : number) {
  showAddToPlan.value = false
  showSuccess('已添加到方案')
}
</script>

<template>
  <view class="page">
    <NavBar title="活动详情" backgroundColor="#FFFFFF" titleColor="#000000" backIconColor="#333333" @back="goBack" />

    <scroll-view class="content-scroll" scroll-y>
      <view class="content">
        <view class="card header-card">
          <text class="activity-name">{{ activityName }}</text>
          <view class="header-tags">
            <view class="scene-tag" v-for="(scene, idx) in scenes" :key="idx">
              <text class="scene-tag-text">{{ scene }}</text>
            </view>
            <view class="difficulty-badge" v-if="difficultyLabel">
              <text class="difficulty-text">{{ difficultyLabel }}</text>
            </view>
            <view class="risk-tag" v-if="riskLevel">
              <view class="detail-inline-icon">
                <AppIcon name="stateWarning" size="26rpx" />
                <text class="risk-tag-text">{{ riskLevel }}风险</text>
              </view>
            </view>
          </view>
          <view class="header-meta">
            <view class="detail-inline-icon">
              <AppIcon name="statePeople" size="26rpx" />
              <text class="header-meta-text">{{ participants }}</text>
            </view>
            <text class="header-meta-dot">·</text>
            <view class="detail-inline-icon">
              <AppIcon name="stateDuration" size="26rpx" />
              <text class="header-meta-text">{{ duration }}</text>
            </view>
          </view>
        </view>

        <view class="card" v-if="objective">
          <text class="card-title">学习目标</text>
          <text class="card-body">{{ objective }}</text>
        </view>

        <view class="card expandable-card" v-if="rules">
          <view class="expandable-header" @click="expandRules = !expandRules">
            <view class="detail-inline-icon">
              <AppIcon name="stateDocument" size="26rpx" />
              <text class="expandable-title">规则说明</text>
            </view>
            <view :class="['expandable-arrow', { 'expandable-arrow-open': expandRules }]">
              <AppIcon name="stateChevronRight" size="18rpx" />
            </view>
          </view>
          <view class="expandable-body" v-if="expandRules">
            <text class="card-body">{{ rules }}</text>
          </view>
        </view>

        <view class="card expandable-card" v-if="reviewQuestions">
          <view class="expandable-header" @click="expandReview = !expandReview">
            <view class="detail-inline-icon">
              <AppIcon name="phaseReflection" size="26rpx" />
              <text class="expandable-title">复盘引导</text>
            </view>
            <view :class="['expandable-arrow', { 'expandable-arrow-open': expandReview }]">
              <AppIcon name="stateChevronRight" size="18rpx" />
            </view>
          </view>
          <view class="expandable-body" v-if="expandReview">
            <text class="card-body">{{ reviewQuestions }}</text>
          </view>
        </view>

        <view class="card expandable-card" v-if="leaderTips">
          <view class="expandable-header" @click="expandTips = !expandTips">
            <view class="detail-inline-icon">
              <AppIcon name="phaseSummary" size="26rpx" />
              <text class="expandable-title">带领者Tips</text>
            </view>
            <view :class="['expandable-arrow', { 'expandable-arrow-open': expandTips }]">
              <AppIcon name="stateChevronRight" size="18rpx" />
            </view>
          </view>
          <view class="expandable-body" v-if="expandTips">
            <text class="card-body">{{ leaderTips }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="bottom-bar">
      <view class="fav-btn" @click="handleToggleFavorite">
        <AppIcon :name="isFavorite ? 'stateFavorite' : 'stateFavoriteOutline'" size="28rpx" />
      </view>
      <view class="add-btn" @click="handleAddToPlan">
        <view class="detail-inline-icon">
          <AppIcon name="stateDocument" size="24rpx" />
          <text class="add-btn-text">添加到方案</text>
        </view>
      </view>
    </view>

    <HalfSheet :visible="showAddToPlan" size="standard" :title="addToPlanStep === 1 ? '选择方案' : '选择环节'" @update:visible="showAddToPlan = $event">
      <view v-if="addToPlanStep === 1">
        <view class="plan-select-card" v-for="plan in availablePlans" :key="plan['id']" @click="selectPlanForAdd(plan)">
          <text class="plan-select-name">{{ plan['name'] as string }}</text>
          <view class="plan-select-meta">
            <text class="plan-select-meta-text">{{ plan['client'] as string || '' }}</text>
            <text class="plan-select-meta-dot" v-if="plan['client']">·</text>
            <text class="plan-select-meta-text">{{ plan['people'] }}人</text>
          </view>
        </view>
        <view class="empty-plans" v-if="availablePlans.length === 0">
          <text class="empty-plans-text">暂无可添加的方案</text>
        </view>
      </view>
      <view v-if="addToPlanStep === 2">
        <view class="back-to-plans" @click="backToPlanList">
          <view class="detail-inline-icon">
            <AppIcon name="stateBack" size="24rpx" />
            <text class="back-to-plans-text">返回方案列表</text>
          </view>
        </view>
        <view class="phase-select-item" v-for="(phase, idx) in selectedPlanPhases" :key="idx" @click="selectPhaseForAdd(idx)">
          <view class="phase-select-badge" :style="{ backgroundColor: (phase['color'] as string) || '#4A7CF7' }">
            <text class="phase-select-badge-text">{{ idx + 1 }}</text>
          </view>
          <view class="phase-select-info">
            <view class="detail-inline-icon">
              <AppIcon v-if="phase['iconName']" :name="phase['iconName'] as string" size="24rpx" />
              <text class="phase-select-name">{{ phase['name'] as string }}</text>
            </view>
            <text class="phase-select-time">{{ phase['time'] as number || phase['duration'] as number || 0 }}分钟</text>
          </view>
        </view>
      </view>
    </HalfSheet>
  </view>
</template>

