import { getPlanTypeLabel } from './constants'

function asText(value : any, fallback : string = '') : string {
  if (value == null) return fallback
  const text = String(value).trim()
  return text || fallback
}

function getDuration(phase : UTSJSONObject) : number {
  return (phase['duration'] as number) || (phase['time'] as number) || 0
}

function line(label : string, value : string) : string {
  return value ? `- ${label}：${value}` : ''
}

export function getPlanDocumentFileName(plan : UTSJSONObject) : string {
  const name = asText(plan['name'], '培训方案').replace(/[\\/:*?"<>|]/g, '-')
  return `${name}.md`
}

export function buildPlanMarkdown(plan : UTSJSONObject, viewMode : string = 'trainer') : string {
  const name = asText(plan['name'], '未命名方案')
  const typeLabel = getPlanTypeLabel(plan['type'] as string)
  const phases = (plan['phases'] as Array<UTSJSONObject>) || [] as Array<UTSJSONObject>
  const client = asText(plan['client'] || plan['clientName'])
  const people = plan['people'] != null ? String(plan['people']) : ''
  const duration = plan['duration'] != null ? String(plan['duration']) : ''
  const isClient = viewMode === 'client'
  const rows : Array<string> = []

  rows.push(`# ${name}`)
  rows.push('')
  rows.push(`> 导出视角：${isClient ? '客户视角' : '培训师视角'}`)
  rows.push('')
  rows.push('## 基本信息')
  rows.push(line('方案类型', typeLabel))
  rows.push(line('客户名称', client))
  rows.push(line('参与人数', people ? `${people}人` : ''))
  rows.push(line('预计时长', duration ? `${duration}分钟` : ''))
  rows.push(line('环节数量', `${phases.length}个`))
  rows.push('')

  if (isClient) {
    rows.push('## 交付说明')
    rows.push('- 该版本面向客户沟通，重点呈现课程目标、节奏和参与体验。')
    rows.push('- 不包含培训师内部控场提醒、复盘提问脚本和临场操作细节。')
    rows.push('')
  } else {
    rows.push('## 带领者说明')
    rows.push('- 该版本面向培训师执行，保留时间控制、工具使用和现场提醒。')
    rows.push('- 可在培训前按客户背景继续补充复盘问题、材料和风险提示。')
    rows.push('')
  }

  rows.push(isClient ? '## 客户版流程概览' : '## 培训师执行流程')
  if (phases.length === 0) {
    rows.push('- 暂无环节安排')
  } else {
    for (let i = 0; i < phases.length; i++) {
      const phase = phases[i]
      const phaseName = asText(phase['name'], `环节${i + 1}`)
      const phaseDuration = getDuration(phase)
      rows.push(`${i + 1}. ${phaseName}${phaseDuration > 0 ? `（${phaseDuration}分钟）` : ''}`)
      if (isClient) {
        rows.push(`   - 参与体验：围绕「${phaseName}」完成体验、交流与沉淀。`)
      } else {
        rows.push(`   - 控场重点：确认目标、说明规则、观察参与状态并控制节奏。`)
        const reminders = (phase['reminders'] as Array<string>) || [] as Array<string>
        for (let j = 0; j < reminders.length; j++) {
          rows.push(`   - 提醒：${reminders[j]}`)
        }
      }
    }
  }

  rows.push('')
  rows.push('---')
  rows.push('由培训师工具箱导出')
  return rows.filter((item) => item !== '').join('\n')
}
