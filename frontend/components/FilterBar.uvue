<script setup>
defineProps({
  filters: {
    type: Array,
    default: () => []
  },
  activeIndex: {
    type: Number,
    default: 0
  }
})

defineEmits(['change'])
</script>

<template>
  <scroll-view class="filter-bar" scroll-x>
    <view
      v-for="(filter, index) in filters"
      :key="index"
      :class="['filter-item', { active: index === activeIndex }]"
      @click="$emit('change', index)"
    >
      <text class="filter-text">{{ filter.label }}</text>
    </view>
  </scroll-view>
</template>

<style lang="scss" scoped>
.filter-bar {
  display: flex;
  white-space: nowrap;
  padding: $spacing-sm $spacing-md;
}
.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-radius: $radius-round;
  background: $bg-tertiary;
  margin-right: $spacing-sm;

  &.active {
    background: rgba($brand-primary, 0.1);

    .filter-text {
      color: $brand-primary;
      font-weight: 600;
    }
  }
}
.filter-text {
  font-size: $font-size-sm;
  color: $text-secondary;
}
</style>
