<script setup>
import { computed } from 'vue'
import { calcNavBarInfo } from '../utils/navbar'
import { getDesktopMaxWidth } from '../utils/viewport'
import AppIcon from './AppIcon.uvue'

const props = defineProps({
  title: { type: String, default: '' },
  showBack: { type: Boolean, default: true },
  backgroundColor: { type: String, default: '#1A1A2E' },
  titleColor: { type: String, default: '#FFFFFF' },
  backIconColor: { type: String, default: '#FFFFFF' }
})

defineEmits(['back'])

const navBarInfo = calcNavBarInfo()
const statusBarHeight = navBarInfo['statusBarHeight'] as number
const navBarHeight = navBarInfo['navBarHeight'] as number
const contentHeight = navBarInfo['contentHeight'] as number
const leftSafeWidth = navBarInfo['leftSafeWidth'] as number
const rightSafeWidth = navBarInfo['rightSafeWidth'] as number
const navHorizontalPadding = navBarInfo['navHorizontalPadding'] as number
const contentTopOffset = navBarInfo['secondaryContentTopOffset'] as number
const contentRowTop = navBarInfo['contentRowTop'] as number
const contentRowHeight = navBarInfo['contentRowHeight'] as number
const maxWidth = getDesktopMaxWidth()
const backButtonInset = '32rpx'

const backIconName = computed<string>(() => {
  return props.backIconColor === '#FFFFFF' ? 'stateBackLight' : 'stateBack'
})
</script>

<template>
  <view class="navbar" :style="{ backgroundColor }">
    <view class="navbar-statusbar" :style="{ height: statusBarHeight + 'px' }"></view>
    <view class="navbar-content-outer">
      <view class="navbar-content" :style="{ height: contentHeight + 'px', maxWidth: maxWidth > 0 ? maxWidth + 'px' : 'none' }">
        <view class="navbar-row" :style="{ top: contentRowTop + 'px', height: contentRowHeight + 'px' }">
        <view v-if="showBack" class="navbar-back" :style="{ width: leftSafeWidth + 'px' }" @click="$emit('back')">
          <view class="back-icon-hit" :style="{ marginLeft: backButtonInset }">
            <view class="back-icon-box">
              <AppIcon :name="backIconName" preset="nav" />
            </view>
          </view>
        </view>
        <view class="navbar-title-wrap" :style="{ left: leftSafeWidth + 'px', right: rightSafeWidth + 'px' }">
          <text class="navbar-title" :style="{ color: titleColor }">{{ title }}</text>
        </view>
        <view class="navbar-right" :style="{ right: rightSafeWidth + 'px' }">
          <slot name="right"></slot>
        </view>
        </view>
      </view>
    </view>
  </view>
  <view :style="{ height: contentTopOffset + 'px' }"></view>
</template>

