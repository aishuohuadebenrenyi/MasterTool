  background-color: rgba(52, 199, 89, 0.1);
}
.review-status-text {
  font-size: 24rpx;
  font-weight: 500;
}
.review-status-text-pending {
  color: #FF9500;
}
.review-status-text-done {
  color: #34C759;
}
.review-card-body {
  margin-bottom: 20rpx;
}
.review-meta-row {
  margin-bottom: 8rpx;
}
.review-meta-text {
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.4;
}
.review-card-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top-width: 1rpx;
  border-top-style: solid;
  border-top-color: #F0F0F0;
}
.btn-review {
  min-height: 76rpx;
  padding: 0 36rpx;
  border-radius: 20rpx;
}
.btn-review-text {
