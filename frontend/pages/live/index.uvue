<script setup>
import { ref, computed, watch, onMounted, onUnmounted, getCurrentInstance } from 'vue'
import { useLiveStore } from '../../stores/live'
import { usePlanStore } from '../../stores/plan'
import { useConfigStore } from '../../stores/config'
import NavBar from '../../components/NavBar.uvue'
import ConfirmDialog from '../../components/ConfirmDialog.uvue'
import HalfSheet from '../../components/HalfSheet.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import TimerDisplay from './components/TimerDisplay.uvue'
import ToolButton from './components/ToolButton.uvue'
import * as noteApi from '../../api/note'
import * as interactionApi from '../../api/interaction'
import { calcNavBarInfo } from '../../utils/navbar'
import { getDesktopMaxWidth, getSafeAreaBottom, getViewportHeight } from '../../utils/viewport'

const liveStore = useLiveStore()
const planStore = usePlanStore()
const configStore = useConfigStore()
const navBarInfo = calcNavBarInfo()
const navBarHeight = navBarInfo['navBarHeight'] as number

const templateId = ref<string>('')
const peopleCount = ref<number>(30)

const showExitDialog = ref<boolean>(false)

const safeAreaBottom = ref<number>(getSafeAreaBottom())
const viewportHeight = ref<number>(getViewportHeight())
const pageMaxWidth = ref<number>(getDesktopMaxWidth())

const timerSeconds = ref<number>(0)
const timerRunning = ref<boolean>(false)
let timerInterval : number | null = null
let timerTapTimeout : number | null = null
const touchStartX = ref<number>(0)
const touchStartY = ref<number>(0)
const lastTouchTime = ref<number>(0)

const planName = computed<string>(() => liveStore.planName || (planStore.currentPlan ? (planStore.currentPlan['name'] as string) : '培训现场'))

const phases = computed<Array<UTSJSONObject>>(() => {
  const plan = planStore.currentPlan
  if (plan && plan['phases']) {
    return plan['phases'] as Array<UTSJSONObject>
  }
  return [
    { name: '开场' },
    { name: '破冰' },
    { name: '主体' },
    { name: '总结' }
  ] as Array<UTSJSONObject>
})

const currentPhaseIndex = computed<number>(() => liveStore.currentPhaseIndex)

const currentPhaseName = computed<string>(() => {
  const list = phases.value
  if (list.length === 0) return '准备中'
  const idx = currentPhaseIndex.value
  if (idx >= 0 && idx < list.length) {
    return (list[idx]['name'] as string) || '进行中'
  }
  return '进行中'
})

const reminders = computed<Array<string>>(() => {
  const list = phases.value
  const idx = currentPhaseIndex.value
  if (idx >= 0 && idx < list.length && list[idx]['reminders']) {
    return list[idx]['reminders'] as Array<string>
  }
  return ['注意时间控制', '关注参与者状态', '保持互动节奏']
})

const timerDisplay = computed<string>(() => {
  const mins = Math.floor(timerSeconds.value / 60)
  const secs = timerSeconds.value % 60
  const m = mins < 10 ? '0' + mins : '' + mins
  const s = secs < 10 ? '0' + secs : '' + secs
  return m + ':' + s
})

const timerProgress = computed<number>(() => {
  const total = phaseDurationSeconds.value
  if (total <= 0) return 0
  const elapsed = total - timerSeconds.value
  return Math.min((elapsed / total) * 100, 100)
})

const phaseDurationSeconds = computed<number>(() => {
  const list = phases.value
  const idx = currentPhaseIndex.value
  if (idx >= 0 && idx < list.length) {
    const phase = list[idx]
    if (phase['time']) {
      return (phase['time'] as number) * 60
    }
  }
  return 900
})

const canPrev = computed<boolean>(() => currentPhaseIndex.value > 0)
const canNext = computed<boolean>(() => currentPhaseIndex.value < phases.value.length - 1)

const quickTools = computed<Array<UTSJSONObject>>(() => {
  const tid = templateId.value || 'corporate'
  if (tid === 'teambuilding') {
    return [
      { key: 'checkin', iconName: 'toolCheckin', name: '签到' } as UTSJSONObject,
      { key: 'group', iconName: 'toolGroup', name: '分组' } as UTSJSONObject,
      { key: 'score', iconName: 'toolScore', name: '积分' } as UTSJSONObject,
      { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
    ]
  } else if (tid === 'improv_show') {
    return [
      { key: 'pick', iconName: 'toolRandom', name: '随机' } as UTSJSONObject,
      { key: 'timer', iconName: 'toolTimer', name: '计时' } as UTSJSONObject,
      { key: 'sound', iconName: 'toolSound', name: '音效' } as UTSJSONObject,
      { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
    ]
  } else if (tid === 'improv_training') {
    return [
      { key: 'pick', iconName: 'toolRandom', name: '随机' } as UTSJSONObject,
      { key: 'timer', iconName: 'toolTimer', name: '计时' } as UTSJSONObject,
      { key: 'note', iconName: 'toolNote', name: '笔记' } as UTSJSONObject,
      { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
    ]
  }
  return [
    { key: 'checkin', iconName: 'toolCheckin', name: '签到' } as UTSJSONObject,
    { key: 'group', iconName: 'toolGroup', name: '分组' } as UTSJSONObject,
    { key: 'score', iconName: 'toolScore', name: '积分' } as UTSJSONObject,
    { key: 'toolbox', iconName: 'toolToolbox', name: '工具箱' } as UTSJSONObject
  ]
})

const checkinSheet = ref<boolean>(false)
const groupSheet = ref<boolean>(false)
const scoreSheet = ref<boolean>(false)
const pickSheet = ref<boolean>(false)
const interactSheet = ref<boolean>(false)
const soundSheet = ref<boolean>(false)
const standaloneTimerSheet = ref<boolean>(false)
const noteSheet = ref<boolean>(false)
const showToolbox = ref<boolean>(false)

const allTools : Array<UTSJSONObject> = [
  { key: 'checkin', iconName: 'toolCheckin', name: '签到' } as UTSJSONObject,
  { key: 'group', iconName: 'toolGroup', name: '分组' } as UTSJSONObject,
  { key: 'score', iconName: 'toolScore', name: '积分' } as UTSJSONObject,
  { key: 'pick', iconName: 'toolRandom', name: '随机' } as UTSJSONObject,
  { key: 'interact', iconName: 'toolInteract', name: '互动' } as UTSJSONObject,
  { key: 'sound', iconName: 'toolSound', name: '音效' } as UTSJSONObject,
  { key: 'timer', iconName: 'toolTimer', name: '计时' } as UTSJSONObject,
  { key: 'note', iconName: 'toolNote', name: '笔记' } as UTSJSONObject
]

function closeToolbox() {
  showToolbox.value = false
}

function openToolFromToolbox(tool : UTSJSONObject) {
  showToolbox.value = false
  openTool(tool['key'] as string)
}

const manualCheckinName = ref<string>('')
const isLiveActionBusy = ref<boolean>(false)

const checkinCount = computed<number>(() => liveStore.participants.length)
const checkinEntryPath = computed<string>(() => liveStore.sessionId ? `/pages/participant/Checkin?sessionId=${liveStore.sessionId}` : '')
const recentCheckins = computed<Array<UTSJSONObject>>(() => {
  const items : Array<UTSJSONObject> = []
  const list = liveStore.participants
  const max = Math.min(list.length, 6)
  for (let i = 0; i < max; i++) {
    const item = list[i]
    items.push({
      name: (item['name'] as string) || '匿名参与者',
      time: formatCheckinTime((item['checkinTime'] as string) || (item['createdAt'] as string) || '')
    } as UTSJSONObject)
  }
  return items
})

const groupMethod = ref<string>('average')
const groupCount = ref<number>(4)
const groupResults = ref<Array<UTSJSONObject>>([])
const isGrouped = ref<boolean>(false)

const scoreMode = ref<string>('simple')
const teamScores = ref<Array<UTSJSONObject>>([])

const pickTab = ref<string>('actor')
const pickResult = ref<string>('')
const isPicking = ref<boolean>(false)
const allowRepeatPick = ref<boolean>(false)
const pickedParticipantIds = ref<Array<string>>([])

const interactType = ref<string>('')
const interactionSessions = ref<UTSJSONObject>({} as UTSJSONObject)
const interactionLoading = ref<boolean>(false)
const wordcloudInput = ref<string>('')
const wordcloudItems = ref<Array<UTSJSONObject>>([])
const voteOptionInput = ref<string>('')
const voteOptions = ref<Array<UTSJSONObject>>([
  { label: '选项 A', count: 0 } as UTSJSONObject,
  { label: '选项 B', count: 0 } as UTSJSONObject
])
const promiseInput = ref<string>('')
const promiseItems = ref<Array<string>>([])
let interactionStatsTimer : number | null = null

const activeInteraction = computed<UTSJSONObject | null>(() => getInteractionSession(interactType.value))
const interactionJoinCode = computed<string>(() => (activeInteraction.value?.['joinCode'] as string) || '')
const interactionPath = computed<string>(() => (activeInteraction.value?.['path'] as string) || '')
const pickedCountText = computed<string>(() => {
  if (allowRepeatPick.value || pickedParticipantIds.value.length === 0) return ''
  return '本轮已抽 ' + pickedParticipantIds.value.length + ' 人'
})

const activeSound = ref<string>('')
const soundList : Array<UTSJSONObject> = [
  { key: 'cheer', iconName: 'soundCheer', name: '欢呼', src: '/static/sounds/cheer.wav' } as UTSJSONObject,
  { key: 'clap', iconName: 'soundClap', name: '鼓掌', src: '/static/sounds/clap.wav' } as UTSJSONObject,
  { key: 'bell', iconName: 'soundBell', name: '铃声', src: '/static/sounds/bell.wav' } as UTSJSONObject,
  { key: 'countdown', iconName: 'toolTimer', name: '倒计时', src: '/static/sounds/countdown.wav' } as UTSJSONObject,
  { key: 'theme', iconName: 'soundTheme', name: '主题', src: '/static/sounds/theme.wav' } as UTSJSONObject,
  { key: 'error', iconName: 'soundError', name: '错误音', src: '/static/sounds/error.wav' } as UTSJSONObject
]
let activeSoundAudio : any = null

const standaloneTimerMode = ref<string>('countup')
const countdownMinutes = ref<number>(1)
const standaloneSeconds = ref<number>(0)
const standaloneRunning = ref<boolean>(false)
let standaloneInterval : number | null = null

const standaloneTimerDisplay = computed<string>(() => {
  const mins = Math.floor(standaloneSeconds.value / 60)
  const secs = standaloneSeconds.value % 60
  const m = mins < 10 ? '0' + mins : '' + mins
  const s = secs < 10 ? '0' + secs : '' + secs
  return m + ':' + s
})

const noteContent = ref<string>('')

const hasOpenSheet = computed<boolean>(() => {
  return checkinSheet.value || groupSheet.value || scoreSheet.value || pickSheet.value || interactSheet.value ||
    soundSheet.value || standaloneTimerSheet.value || noteSheet.value || showToolbox.value || showExitDialog.value
})

function toggleTimer() {
  if (timerRunning.value) {
    timerRunning.value = false
    if (timerInterval) {
      clearInterval(timerInterval)
      timerInterval = null
    }
    liveStore.pauseSession()
  } else {
    if (timerSeconds.value <= 0) {
      timerSeconds.value = phaseDurationSeconds.value
    }
    timerRunning.value = true
    timerInterval = setInterval(() => {
      if (timerSeconds.value > 0) {
        timerSeconds.value--
      } else {
        timerRunning.value = false
        if (timerInterval) {
          clearInterval(timerInterval)
          timerInterval = null
        }
      }
    }, 1000)
    liveStore.resumeSession()
  }
}

function delayFiveMinutes() {
  timerSeconds.value += 300
  uni.showToast({ title: '已延时 5 分钟', icon: 'none' })
}

function handleTimerTap() {
  if (configStore.doubleTapDelayEnabled) {
    if (timerTapTimeout) {
      clearTimeout(timerTapTimeout)
      timerTapTimeout = null
      delayFiveMinutes()
      return
    }
    timerTapTimeout = setTimeout(() => {
      timerTapTimeout = null
      toggleTimer()
    }, 220)
    return
  }
  toggleTimer()
}

function handleBack() {
  showExitDialog.value = true
}

async function confirmExit() {
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  timerRunning.value = false
  try {
    await liveStore.endSession()
  } catch (_e : unknown) {
    uni.showToast({ title: '结束会话失败，请稍后重试', icon: 'none' })
  } finally {
    uni.navigateBack({})
  }
}

function cancelExit() {
  showExitDialog.value = false
}

function handlePrev() {
  if (canPrev.value) {
    liveStore.prevPhase()
  }
}

async function handleNext() {
  if (canNext.value) {
    liveStore.nextPhase()
  } else {
    if (timerInterval) {
      clearInterval(timerInterval)
      timerInterval = null
    }
    timerRunning.value = false
    try {
      await liveStore.endSession()
      uni.redirectTo({ url: '/pages/live/LiveEnd' })
    } catch (_e : unknown) {
      uni.showToast({ title: '结束会话失败，请稍后重试', icon: 'none' })
    }
  }
}

function handleToolClick(idx : number) {
  const tool = quickTools.value[idx]
  openTool(tool['key'] as string)
}

function openTool(key : string) {
  if (key === 'toolbox') {
    showToolbox.value = true
    return
  }
  if (key === 'checkin') openCheckinSheet()
  else if (key === 'group') openGroupSheet()
  else if (key === 'score') openScoreSheet()
  else if (key === 'pick') pickSheet.value = true
  else if (key === 'interact') interactSheet.value = true
  else if (key === 'sound') soundSheet.value = true
  else if (key === 'timer') standaloneTimerSheet.value = true
  else if (key === 'note') noteSheet.value = true
}

const groupColors : Array<string> = ['#4A7CF7', '#FF6B6B', '#51CF66', '#FFD43B', '#CC5DE8', '#FF922B', '#20C997', '#F06595', '#A9E34B', '#748FFC']

function formatCheckinTime(raw : string) : string {
  if (!raw) return '--:--'
  const date = new Date(raw)
  if (isNaN(date.getTime())) {
    return raw.length >= 16 ? raw.slice(11, 16) : raw
  }
  const hours = date.getHours()
  const minutes = date.getMinutes()
  const h = hours < 10 ? '0' + hours : '' + hours
  const m = minutes < 10 ? '0' + minutes : '' + minutes
  return h + ':' + m
}

async function refreshCheckins(showError : boolean = false) {
  if (!liveStore.sessionId) return
  try {
    await liveStore.loadCheckins()
  } catch (_e : unknown) {
    if (showError) {
      uni.showToast({ title: '获取签到列表失败', icon: 'none' })
    }
  }
}

async function openCheckinSheet() {
  checkinSheet.value = true
  await refreshCheckins(false)
}

async function openGroupSheet() {
  groupSheet.value = true
  await refreshCheckins(false)
  syncGroupResultsFromStore()
}

function openScoreSheet() {
  syncGroupResultsFromStore()
  syncScoresFromGroups()
  scoreSheet.value = true
}

async function addManualCheckin() {
  const name = manualCheckinName.value.trim()
  if (!name) {
    uni.showToast({ title: '请输入姓名', icon: 'none' })
    return
  }
  if (!liveStore.sessionId) {
    uni.showToast({ title: '会话未开始', icon: 'none' })
    return
  }
  try {
    isLiveActionBusy.value = true
    await liveStore.checkin({
      name,
      openid: 'manual_' + Date.now() + '_' + Math.floor(Math.random() * 10000)
    } as UTSJSONObject)
    manualCheckinName.value = ''
    await refreshCheckins(false)
    uni.showToast({ title: '已签到', icon: 'success' })
  } catch (e : unknown) {
    uni.showToast({ title: e instanceof Error ? e.message : '签到失败', icon: 'none' })
  } finally {
    isLiveActionBusy.value = false
  }
}

function syncGroupResultsFromStore() {
  const results : Array<UTSJSONObject> = []
  const groups = liveStore.groups
  for (let i = 0; i < groups.length; i++) {
    const group = groups[i]
    const members = (group['members'] as Array<string>) || [] as Array<string>
    const groupId = (group['groupId'] as string) || 'group_' + (i + 1)
    const savedScore = (liveStore.scores[groupId] as number) || (group['score'] as number) || 0
    results.push({
      groupId,
      name: (group['groupName'] as string) || (group['name'] as string) || '第' + (i + 1) + '组',
      count: members.length || ((group['count'] as number) || 0),
      color: groupColors[i % groupColors.length],
      score: savedScore
    } as UTSJSONObject)
  }
  groupResults.value = results
  isGrouped.value = results.length > 0
}

async function doGrouping() {
  if (!liveStore.sessionId) {
    uni.showToast({ title: '会话未开始', icon: 'none' })
    return
  }
  if (groupMethod.value === 'free') {
    uni.showToast({ title: '当前不支持参与者自选队伍', icon: 'none' })
    return
  }
  if (liveStore.participants.length < groupCount.value) {
    uni.showToast({ title: '签到人数不足以分组', icon: 'none' })
    return
  }
  try {
    isLiveActionBusy.value = true
    await liveStore.createGroup({
      action: 'create',
      groupCount: groupCount.value,
      method: groupMethod.value
    } as UTSJSONObject)
    syncGroupResultsFromStore()
    syncScoresFromGroups()
    uni.showToast({ title: '已生成分组', icon: 'success' })
  } catch (e : unknown) {
    uni.showToast({ title: e instanceof Error ? e.message : '分组失败', icon: 'none' })
  } finally {
    isLiveActionBusy.value = false
  }
}

function syncScoresFromGroups() {
  const scores : Array<UTSJSONObject> = []
  for (let i = 0; i < groupResults.value.length; i++) {
    const g = groupResults.value[i]
    const groupId = (g['groupId'] as string) || 'group_' + (i + 1)
    scores.push({
      groupId,
      name: g['name'] as string,
      score: (g['score'] as number) || ((liveStore.scores[groupId] as number) || 0),
      color: g['color'] as string
    } as UTSJSONObject)
  }
  teamScores.value = scores
}

function confirmGrouping() {
  if (groupResults.value.length === 0) {
    uni.showToast({ title: '请先生成分组', icon: 'none' })
    return
  }
  isGrouped.value = true
  syncScoresFromGroups()
  groupSheet.value = false
}

function adjustGroupCount(delta : number) {
  const next = groupCount.value + delta
  if (next >= 2 && next <= 10) {
    groupCount.value = next
  }
}

async function changeScore(idx : number, delta : number) {
  if (idx < 0 || idx >= teamScores.value.length) return
  const currentScore = (teamScores.value[idx]['score'] as number) || 0
  const nextScore = Math.max(0, currentScore + delta)
  const groupId = teamScores.value[idx]['groupId'] as string
  teamScores.value[idx]['score'] = nextScore
  try {
    await liveStore.updateScore({ groupId, score: nextScore } as UTSJSONObject)
    syncGroupResultsFromStore()
    syncScoresFromGroups()
  } catch (e : unknown) {
    teamScores.value[idx]['score'] = currentScore
    uni.showToast({ title: e instanceof Error ? e.message : '更新积分失败', icon: 'none' })
  }
}

async function resetScores() {
  for (let i = 0; i < teamScores.value.length; i++) {
    teamScores.value[i]['score'] = 0
    const groupId = teamScores.value[i]['groupId'] as string
    try {
      await liveStore.updateScore({ groupId, score: 0 } as UTSJSONObject)
    } catch (_e : unknown) {
      uni.showToast({ title: '重置积分失败', icon: 'none' })
      return
    }
  }
  syncGroupResultsFromStore()
  syncScoresFromGroups()
}

function resetPickHistory() {
  pickedParticipantIds.value = []
  pickResult.value = ''
  uni.showToast({ title: '已重置抽取记录', icon: 'none' })
}

async function startPick() {
  isPicking.value = true
  pickResult.value = ''
  if (pickTab.value === 'topic') {
    setTimeout(() => {
      const topics : Array<string> = ['客户沟通', '团队协作', '临场反应', '角色互换', '复盘提问']
      const idx = Math.floor(Math.random() * topics.length)
      pickResult.value = topics[idx]
      isPicking.value = false
    }, 500)
    return
  }
  try {
    if (liveStore.participants.length === 0) {
      await refreshCheckins(false)
    }
    const payload = {} as UTSJSONObject
    if (!allowRepeatPick.value && pickedParticipantIds.value.length > 0) {
      payload['excludeIds'] = pickedParticipantIds.value
    }
    const result = await liveStore.randomPick(payload)
    pickResult.value = (result['name'] as string) || '匿名参与者'
    const pickedId = (result['id'] as string) || ''
    if (pickedId && !allowRepeatPick.value && pickedParticipantIds.value.indexOf(pickedId) === -1) {
      pickedParticipantIds.value.push(pickedId)
    }
  } catch (_e : unknown) {
    const message = !allowRepeatPick.value && pickedParticipantIds.value.length > 0 ? '本轮已抽完，可开启重复抽取' : '没有可抽取的已签到参与者'
    uni.showToast({ title: message, icon: 'none' })
  } finally {
    isPicking.value = false
  }
}

function getInteractionSession(type : string) : UTSJSONObject | null {
  if (!type) return null
  const session = interactionSessions.value[type] as UTSJSONObject | null
  return session || null
}

function getInteractionTitle(type : string) : string {
  if (type === 'vote') return '投票互动'
  if (type === 'promise') return '承诺互动'
  return '词云互动'
}

function setInteractionSession(type : string, session : UTSJSONObject) {
  const next = { ...interactionSessions.value }
  next[type] = session
  interactionSessions.value = next
}

function applyInteractionStats(data : UTSJSONObject) {
  const type = (data['type'] as string) || interactType.value
  if (type === 'wordcloud') {
    wordcloudItems.value = (data['wordcloud'] as Array<UTSJSONObject>) || [] as Array<UTSJSONObject>
  } else if (type === 'vote') {
    voteOptions.value = (data['options'] as Array<UTSJSONObject>) || voteOptions.value
  } else if (type === 'promise') {
    const submissions = (data['submissions'] as Array<UTSJSONObject>) || [] as Array<UTSJSONObject>
    const nextItems : Array<string> = []
    for (let i = submissions.length - 1; i >= 0; i--) {
      const content = submissions[i]['content'] as string
      if (content) nextItems.push(content)
    }
    promiseItems.value = nextItems
  }
}

async function ensureInteraction(type : string) : Promise<UTSJSONObject | null> {
  const current = getInteractionSession(type)
  if (current) return current
  if (!liveStore.sessionId) {
    uni.showToast({ title: '请先开始培训', icon: 'none' })
    return null
  }
  interactionLoading.value = true
  try {
    const payload = {
      sessionId: liveStore.sessionId,
      type,
      title: getInteractionTitle(type),
      options: type === 'vote' ? voteOptions.value : [] as Array<UTSJSONObject>
    } as UTSJSONObject
    const result = await interactionApi.createInteraction(payload)
    setInteractionSession(type, result)
    applyInteractionStats(result)
    return result
  } catch (_e : unknown) {
    return null
  } finally {
    interactionLoading.value = false
  }
}

async function openInteractType(type : string) {
  interactType.value = type
  const result = await ensureInteraction(type)
  if (result) {
    startInteractionPolling()
  }
}

function leaveInteractDetail() {
  interactType.value = ''
  stopInteractionPolling()
}

async function pollInteractionStats() {
  const session = activeInteraction.value
  const interactionId = (session?.['interactionId'] as string) || (session?.['id'] as string) || ''
  if (!interactionId) return
  try {
    const result = await interactionApi.getInteractionStats(interactionId)
    applyInteractionStats(result)
  } catch (e : unknown) {
    console.log('[live.interaction.stats]', e)
  }
}

function startInteractionPolling() {
  stopInteractionPolling()
  pollInteractionStats()
  interactionStatsTimer = setInterval(() => {
    pollInteractionStats()
  }, 3000)
}

function stopInteractionPolling() {
  if (interactionStatsTimer) {
    clearInterval(interactionStatsTimer)
    interactionStatsTimer = null
  }
}

function playSound(key : string) {
  activeSound.value = key
  const item = soundList.find((sound : UTSJSONObject) : boolean => (sound['key'] as string) === key)
  const name = (item?.['name'] as string) || '音效'
  const src = (item?.['src'] as string) || ''
  let played = false
  try {
    if (activeSoundAudio) {
      activeSoundAudio.stop()
      activeSoundAudio.destroy()
      activeSoundAudio = null
    }
    if (src && typeof uni.createInnerAudioContext === 'function') {
      const audio = uni.createInnerAudioContext()
      activeSoundAudio = audio
      audio.src = src
      audio.onError(() => {
        try {
          uni.vibrateShort({ type: 'light' })
        } catch (_e : unknown) {}
      })
      audio.onEnded(() => {
        if (activeSoundAudio === audio) {
          activeSoundAudio.destroy()
          activeSoundAudio = null
        }
      })
      audio.play()
      played = true
    }
  } catch (_e : unknown) {
    played = false
  }
  if (!played) {
    try {
      uni.vibrateShort({ type: 'light' })
    } catch (_e : unknown) {}
  }
  uni.showToast({ title: (played ? '已播放' : '已触发') + name, icon: 'none' })
  setTimeout(() => {
    activeSound.value = ''
  }, 500)
}

async function addWordcloudItem() {
  const word = wordcloudInput.value.trim()
  if (!word) return
  const session = await ensureInteraction('wordcloud')
  if (!session) return
  try {
    await interactionApi.submitInteraction({
      interactionId: (session['interactionId'] as string) || (session['id'] as string),
      code: session['joinCode'] as string,
      content: word,
      name: '培训师',
      anonymous: false
    } as UTSJSONObject)
    wordcloudInput.value = ''
    await pollInteractionStats()
  } catch (_e : unknown) {
  }
}

async function addVoteOption() {
  const label = voteOptionInput.value.trim()
  if (!label) return
  voteOptions.value.push({ label, count: 0 } as UTSJSONObject)
  voteOptionInput.value = ''
  await saveVoteOptions()
}

async function changeVote(index : number, delta : number) {
  if (index < 0 || index >= voteOptions.value.length) return
  const current = (voteOptions.value[index]['count'] as number) || 0
  voteOptions.value[index]['count'] = Math.max(0, current + delta)
  await saveVoteOptions()
}

async function saveVoteOptions() {
  const session = await ensureInteraction('vote')
  if (!session) return
  try {
    const result = await interactionApi.updateInteraction({
      interactionId: (session['interactionId'] as string) || (session['id'] as string),
      options: voteOptions.value
    } as UTSJSONObject)
    setInteractionSession('vote', result)
    applyInteractionStats(result)
  } catch (_e : unknown) {
  }
}

async function addPromiseItem() {
  const content = promiseInput.value.trim()
  if (!content) return
  const session = await ensureInteraction('promise')
  if (!session) return
  try {
    await interactionApi.submitInteraction({
      interactionId: (session['interactionId'] as string) || (session['id'] as string),
      code: session['joinCode'] as string,
      content,
      name: '培训师',
      anonymous: false
    } as UTSJSONObject)
    promiseInput.value = ''
    await pollInteractionStats()
  } catch (_e : unknown) {
  }
}

function toggleStandaloneTimer() {
  if (standaloneRunning.value) {
    standaloneRunning.value = false
    if (standaloneInterval) {
      clearInterval(standaloneInterval)
      standaloneInterval = null
    }
  } else {
    if (standaloneTimerMode.value === 'countdown' && standaloneSeconds.value === 0) {
      standaloneSeconds.value = countdownMinutes.value * 60
    }
    standaloneRunning.value = true
    standaloneInterval = setInterval(() => {
      if (standaloneTimerMode.value === 'countdown') {
        if (standaloneSeconds.value > 0) {
          standaloneSeconds.value--
        } else {
          standaloneRunning.value = false
          if (standaloneInterval) {
            clearInterval(standaloneInterval)
            standaloneInterval = null
          }
        }
      } else {
        standaloneSeconds.value++
      }
    }, 1000)
  }
}

function resetStandaloneTimer() {
  standaloneRunning.value = false
  if (standaloneInterval) {
    clearInterval(standaloneInterval)
    standaloneInterval = null
  }
  standaloneSeconds.value = 0
}

function saveNote() {
  const content = noteContent.value.trim()
  if (!content) return
  const payload = {
    phaseIndex: currentPhaseIndex.value,
    phaseName: currentPhaseName.value,
    content
  } as UTSJSONObject
  liveStore.addNote(payload)
  const currentSessionId = liveStore.sessionId || ''
  if (currentSessionId) {
    noteApi.saveNote({
      sessionId: currentSessionId,
      phase: currentPhaseName.value,
      content
    } as UTSJSONObject).catch((e : unknown) => {
      console.log('[live.note.save]', e)
    })
  }
  noteContent.value = ''
}

function handleTouchStart(event : TouchEvent) {
  if (hasOpenSheet.value) return
  const touches = event.touches
  if (touches.length === 0) return
  touchStartX.value = touches[0].clientX
  touchStartY.value = touches[0].clientY
  lastTouchTime.value = Date.now()
}

function handleTouchEnd(event : TouchEvent) {
  if (hasOpenSheet.value) return
  const changedTouches = event.changedTouches
  if (changedTouches.length === 0) return
  const deltaX = changedTouches[0].clientX - touchStartX.value
  const deltaY = changedTouches[0].clientY - touchStartY.value
  const duration = Date.now() - lastTouchTime.value
  if (Math.abs(deltaY) > 48 || Math.abs(deltaX) < 60 || duration > 600) {
    return
  }
  if (deltaX < 0 && configStore.swipeNextEnabled) {
    console.log('[live.swipe]', 'next', deltaX, deltaY, duration)
    handleNext()
  } else if (deltaX > 0 && configStore.swipePrevEnabled) {
    console.log('[live.swipe]', 'prev', deltaX, deltaY, duration)
    handlePrev()
  }
}

watch(currentPhaseIndex, () => {
  timerRunning.value = false
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  timerSeconds.value = phaseDurationSeconds.value
})

watch(interactSheet, (visible : boolean) => {
  if (!visible) {
    interactType.value = ''
    stopInteractionPolling()
  }
})

watch(interactType, (type : string) => {
  if (!type) {
    stopInteractionPolling()
  }
})

onMounted(async () => {
  safeAreaBottom.value = getSafeAreaBottom()
  viewportHeight.value = getViewportHeight()
  pageMaxWidth.value = getDesktopMaxWidth()
  configStore.restoreConfig()
  const instance = getCurrentInstance()
  if (instance && instance.proxy) {
    const page = (instance.proxy as unknown as UTSJSONObject)['$page'] as UTSJSONObject | null
    if (page && page['options']) {
      const options = page['options'] as UTSJSONObject
      const pid = options['planId'] as string | null
      const tid = options['templateId'] as string | null
      const name = options['name'] as string | null
      const count = options['peopleCount'] as string | null
      if (tid) {
        templateId.value = tid
      }
      if (name) {
        liveStore.planName = (decodeURIComponent(name) as string) || name
      }
      if (count) {
        peopleCount.value = parseInt(count) || 30
      }
      if (pid) {
        await planStore.fetchPlanDetail(pid)
        templateId.value = (planStore.currentPlan?.['type'] as string) || templateId.value
        peopleCount.value = Number(planStore.currentPlan?.['people'] || peopleCount.value)
        await liveStore.startSession({
          planId: pid,
          planName: (planStore.currentPlan?.['name'] as string) || '',
          peopleCount: peopleCount.value
        } as UTSJSONObject)
      } else if (tid) {
        await liveStore.startSession({ templateId: tid, planName: (decodeURIComponent(name || '') as string) } as UTSJSONObject)
      }
    }
  }
  if (liveStore.sessionId) {
    await refreshCheckins(false)
    syncGroupResultsFromStore()
    syncScoresFromGroups()
    try {
      const savedNotes = await noteApi.getNoteList(liveStore.sessionId)
      for (let i = savedNotes.length - 1; i >= 0; i--) {
        liveStore.addNote({
          phaseName: savedNotes[i]['phase'],
          content: savedNotes[i]['content'],
          createdAt: savedNotes[i]['createdAt']
        } as UTSJSONObject)
      }
    } catch (_e : unknown) {
    }
  }
  timerSeconds.value = phaseDurationSeconds.value
})

onUnmounted(() => {
  if (timerTapTimeout) {
    clearTimeout(timerTapTimeout)
    timerTapTimeout = null
  }
  if (timerInterval) {
    clearInterval(timerInterval)
    timerInterval = null
  }
  if (standaloneInterval) {
    clearInterval(standaloneInterval)
    standaloneInterval = null
  }
  if (activeSoundAudio) {
    activeSoundAudio.destroy()
    activeSoundAudio = null
  }
  stopInteractionPolling()
})
</script>

<template>
  <view class="page" @touchstart="handleTouchStart" @touchend="handleTouchEnd">
    <NavBar :title="planName" backgroundColor="#1A1A2E" @back="handleBack"></NavBar>

    <view
      :class="['live-body', { 'sheet-open': hasOpenSheet }]"
      :style="{ '--nav-bar-height': navBarHeight + 'px', '--safe-area-bottom': safeAreaBottom + 'px', maxWidth: pageMaxWidth > 0 ? pageMaxWidth + 'px' : 'none' }"
    >
      <view class="phase-progress-wrap">
        <view class="phase-progress">
          <text class="phase-progress-text">环节 {{ currentPhaseIndex + 1 }}/{{ phases.length }}</text>
          <view class="phase-progress-bar">
            <view class="phase-progress-fill" :style="{ width: ((currentPhaseIndex + 1) / phases.length * 100) + '%' }"></view>
          </view>
        </view>
      </view>

      <view class="current-phase-section">
        <text class="current-phase-name">{{ currentPhaseName }}</text>
      </view>

      <view class="timer-section" @click="handleTimerTap">
        <TimerDisplay :time="timerDisplay" :progress="timerProgress" :isRunning="timerRunning"></TimerDisplay>
        <text class="timer-hint">{{ configStore.doubleTapDelayEnabled ? (timerRunning ? '单击暂停，双击延时 5 分钟' : '单击开始，双击延时 5 分钟') : (timerRunning ? '点击暂停' : '点击开始') }}</text>
      </view>

      <view class="reminders-section">
        <view class="reminders-header">
          <view class="section-title-row">
            <AppIcon name="phaseSummary" size="28rpx" />
            <text class="reminders-title">关键提醒</text>
          </view>
        </view>
        <view class="reminder-item" v-for="(item, idx) in reminders" :key="idx">
          <text class="reminder-bullet">•</text>
          <text class="reminder-text">{{ item }}</text>
        </view>
      </view>

      <view v-if="!hasOpenSheet" class="bottom-action-section">
        <view class="toolbar-section">
          <view class="toolbar-grid">
            <ToolButton
              v-for="(tool, idx) in quickTools"
              :key="idx"
              :iconName="tool['iconName'] as string"
              :label="tool['name'] as string"
              @click="handleToolClick(idx)"
            ></ToolButton>
          </view>
        </view>

        <view class="nav-buttons">
          <view :class="['nav-btn', 'nav-btn-prev', { disabled: !canPrev }]" @click="handlePrev">
            <text class="nav-btn-text">{{ '上一环节' }}</text>
          </view>
          <view class="nav-btn nav-btn-next" @click="handleNext">
            <text class="nav-btn-text">{{ canNext ? '下一环节' : '结束培训' }}</text>
          </view>
        </view>
      </view>
    </view>

    <HalfSheet :visible="checkinSheet" size="large" title="签到管理" @update:visible="checkinSheet = $event">
      <view class="checkin-stats">
        <text class="checkin-stats-text">已签到 {{ checkinCount }} / 预计 {{ peopleCount }} 人</text>
      </view>
      <view class="checkin-qr">
        <view class="checkin-qr-icon-wrap">
        <AppIcon name="stateQr" size="56rpx" />
      </view>
      <text class="checkin-qr-hint">参与者扫码签到</text>
        <text class="checkin-qr-text">{{ checkinEntryPath || '请先开始培训' }}</text>
      </view>
      <view class="manual-checkin">
        <input class="manual-checkin-input" v-model="manualCheckinName" placeholder="手动补录姓名" placeholder-class="input-placeholder" />
        <view :class="['manual-checkin-btn', isLiveActionBusy ? 'manual-checkin-btn-disabled' : '']" @click="addManualCheckin">
          <text class="manual-checkin-btn-text">{{ isLiveActionBusy ? '处理中' : '签到' }}</text>
        </view>
      </view>
      <view class="checkin-list-header">
        <text class="checkin-list-title">最近签到</text>
      </view>
      <view v-if="recentCheckins.length === 0" class="checkin-empty">
        <text class="checkin-empty-text">暂无签到，扫码或手动补录后会显示在这里</text>
      </view>
      <view class="checkin-item" v-for="(item, idx) in recentCheckins" :key="idx">
        <view class="checkin-avatar">
          <text class="checkin-avatar-text">{{ (item['name'] as string).charAt(0) }}</text>
        </view>
        <text class="checkin-name">{{ item['name'] as string }}</text>
        <text class="checkin-time">{{ item['time'] as string }}</text>
      </view>
      <template #footer>
        <view class="sheet-footer-btn sheet-footer-btn-danger" @click="checkinSheet = false">
          <text class="sheet-footer-btn-text">结束签到</text>
        </view>
      </template>
    </HalfSheet>

    <HalfSheet :visible="groupSheet" size="large" title="分组管理" @update:visible="groupSheet = $event">
