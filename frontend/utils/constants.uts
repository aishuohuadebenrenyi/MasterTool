export const API_BASE_URL : string = import.meta.env.VITE_API_BASE_URL || ''

export function normalizePlanType(planType : string | null) : string {
  if (planType == null || planType.length === 0) {
    return PLAN_TYPES['CUSTOM'] as string
  }
  const byLabel = PLAN_TYPE_CODES_BY_LABEL[planType] as string
  if (byLabel) return byLabel
  return (LEGACY_PLAN_TYPE_MAP[planType] as string) || planType
}

export function getPlanTypeLabel(planType : string | null) : string {
  const normalized = normalizePlanType(planType)
  return (PLAN_TYPE_LABELS[normalized] as string) || '自定义'
}

export function getPlanTypeIconName(planType : string | null) : string {
  const normalized = normalizePlanType(planType)
  return (PLAN_TYPE_ICON_NAMES[normalized] as string) || 'stateDocument'
}

export function normalizeActivityScene(scene : string | null) : string {
  if (scene == null || scene.length === 0) {
    return ACTIVITY_SCENES['GENERIC'] as string
  }
  return (ACTIVITY_SCENE_LABELS[scene] as string) || scene
}

export function getActivitySceneLabel(scene : string | null) : string {
  return normalizeActivityScene(scene)
}
