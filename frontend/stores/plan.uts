import { defineStore } from 'pinia'
import { ref, computed } from 'vue'
import * as planApi from '../api/plan'
import { PLAN_STATUS, normalizePlanType } from '../utils/constants'

function normalizePlan(plan : UTSJSONObject) : UTSJSONObject {
  const nextPlan = { ...plan }
  nextPlan['type'] = normalizePlanType((plan['type'] as string) || '')
  nextPlan['client'] = (plan['client'] as string) || (plan['clientName'] as string) || ''
  nextPlan['clientName'] = nextPlan['client']
  nextPlan['scenes'] = (plan['scenes'] as Array<string>) || (plan['tags'] as Array<string>) || [] as Array<string>
  nextPlan['reviewNotes'] = (plan['reviewNotes'] as Array<string>) || [] as Array<string>
  nextPlan['reviewMethod'] = ((plan['reviewMethod'] as string) || '').toLowerCase()
  return nextPlan
}

export const usePlanStore = defineStore('plan', () => {
  const plans = ref<Array<UTSJSONObject>>([])
  const currentPlan = ref<UTSJSONObject | null>(null)
  const loading = ref<boolean>(false)
  const error = ref<string>('')

  const draftPlans = computed<Array<UTSJSONObject>>(() => plans.value.filter(p => (p['status'] as string) === PLAN_STATUS['DRAFT'] as string))
  const confirmedPlans = computed<Array<UTSJSONObject>>(() => plans.value.filter(p => (p['status'] as string) === PLAN_STATUS['CONFIRMED'] as string))
  const deliveredPlans = computed<Array<UTSJSONObject>>(() => plans.value.filter(p => (p['status'] as string) === PLAN_STATUS['DELIVERED'] as string))
  const reviewedPlans = computed<Array<UTSJSONObject>>(() => plans.value.filter(p => (p['status'] as string) === PLAN_STATUS['REVIEWED'] as string))

  async function fetchPlans() {
    loading.value = true
    try {
      const data = await planApi.getPlanList()
      plans.value = ((data.list || []) as Array<UTSJSONObject>).map((item : UTSJSONObject) => normalizePlan(item))
      error.value = ''
      return plans.value
    } catch (e : unknown) {
      plans.value = []
      error.value = (e instanceof Error ? e.message : '获取方案列表失败')
      console.log('[planStore.fetchPlans]', error.value)
      return [] as Array<UTSJSONObject>
    } finally {
      loading.value = false
    }
  }

  async function fetchPlanDetail(planId : string) {
    loading.value = true
    try {
      const data = await planApi.getPlanDetail(planId)
      const normalized = normalizePlan(data)
      currentPlan.value = normalized
      error.value = ''
      return normalized
    } catch (e : unknown) {
      currentPlan.value = null
      error.value = (e instanceof Error ? e.message : '获取方案详情失败')
      console.log('[planStore.fetchPlanDetail]', planId, error.value)
      throw e
    } finally {
      loading.value = false
    }
  }

  async function createPlan(planData : UTSJSONObject) {
    try {
      loading.value = true
      const data = normalizePlan(await planApi.createPlan(planData))
      plans.value.unshift(data)
      error.value = ''
      return data
    } catch (e : unknown) {
      error.value = (e instanceof Error ? e.message : '创建方案失败')
      throw e
    } finally {
      loading.value = false
    }
  }

  async function updatePlan(planId : string, planData : UTSJSONObject) {
    try {
      loading.value = true
      const data = normalizePlan(await planApi.updatePlan(planId, planData))
      const index = plans.value.findIndex(p => (p['id'] as string) === planId)
      if (index !== -1) {
        plans.value[index] = { ...plans.value[index], ...data }
      }
      if ((currentPlan.value?.['id'] as string) === planId) {
        currentPlan.value = { ...currentPlan.value, ...data }
      }
      error.value = ''
      return data
    } catch (e : unknown) {
      error.value = (e instanceof Error ? e.message : '更新方案失败')
      throw e
    } finally {
      loading.value = false
    }
  }

  async function deletePlan(planId : string) {
    try {
      loading.value = true
      await planApi.deletePlan(planId)
      plans.value = plans.value.filter(p => (p['id'] as string) !== planId)
      if ((currentPlan.value?.['id'] as string) === planId) {
        currentPlan.value = null
      }
      error.value = ''
    } catch (e : unknown) {
      error.value = (e instanceof Error ? e.message : '删除方案失败')
      throw e
    } finally {
      loading.value = false
    }
  }

  async function confirmPlan(planId : string) {
    try {
      loading.value = true
      const data = normalizePlan(await planApi.confirmPlan(planId))
      const index = plans.value.findIndex(p => (p['id'] as string) === planId)
      if (index !== -1) {
        plans.value[index] = { ...plans.value[index], ...data, status: PLAN_STATUS['CONFIRMED'] as string }
      }
      if ((currentPlan.value?.['id'] as string) === planId) {
        currentPlan.value = { ...currentPlan.value, ...data, status: PLAN_STATUS['CONFIRMED'] as string }
      }
      error.value = ''
      return data
    } catch (e : unknown) {
      error.value = (e instanceof Error ? e.message : '确认方案失败')
      throw e
    } finally {
      loading.value = false
    }
  }

  async function restartReview(planId : string) {
    try {
      loading.value = true
      const data = await planApi.updatePlan(planId, { status: PLAN_STATUS['DELIVERED'] as string } as UTSJSONObject)
      const index = plans.value.findIndex((p : UTSJSONObject) => (p['id'] as string) === planId)
      if (index !== -1) {
        plans.value[index] = { ...plans.value[index], status: PLAN_STATUS['DELIVERED'] as string }
      }
      if ((currentPlan.value?.['id'] as string) === planId) {
        currentPlan.value = { ...currentPlan.value, status: PLAN_STATUS['DELIVERED'] as string }
      }
      error.value = ''
      return data
    } catch (e : unknown) {
      error.value = (e instanceof Error ? e.message : '重新复盘失败')
      throw e
    } finally {
      loading.value = false
    }
  }

  function setCurrentPlan(plan : UTSJSONObject | null) {
    currentPlan.value = plan
  }

  return {
    plans,
    currentPlan,
    loading,
    error,
    draftPlans,
    confirmedPlans,
    deliveredPlans,
    reviewedPlans,
    fetchPlans,
    fetchPlanDetail,
    createPlan,
    updatePlan,
    deletePlan,
    confirmPlan,
    restartReview,
    setCurrentPlan
  }
})
