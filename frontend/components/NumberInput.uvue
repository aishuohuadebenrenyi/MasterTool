<script setup>
import { computed } from 'vue'

const props = defineProps({
  modelValue: {
    type: Number,
    default: 0
  },
  min: {
    type: Number,
    default: 0
  },
  max: {
    type: Number,
    default: 999
  },
  step: {
    type: Number,
    default: 1
  }
})

const emit = defineEmits(['update:modelValue', 'change'])

const canDecrease = computed(() => props.modelValue > props.min)
const canIncrease = computed(() => props.modelValue < props.max)

function decrease() {
  if (!canDecrease.value) return
  const newVal = Math.max(props.min, props.modelValue - props.step)
  emit('update:modelValue', newVal)
  emit('change', newVal)
}

function increase() {
  if (!canIncrease.value) return
  const newVal = Math.min(props.max, props.modelValue + props.step)
  emit('update:modelValue', newVal)
  emit('change', newVal)
}
</script>

<template>
  <view class="number-input">
    <view :class="['num-btn', { disabled: !canDecrease }]" @click="decrease">−</view>
    <text class="num-value">{{ modelValue }}</text>
    <view :class="['num-btn', { disabled: !canIncrease }]" @click="increase">+</view>
  </view>
</template>

<style lang="scss" scoped>
.number-input {
  display: flex;
  align-items: center;
  gap: $spacing-sm;
}
.num-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: $radius-md;
  background: $bg-tertiary;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: $font-size-xl;
  color: $text-primary;

  &.disabled {
    opacity: 0.3;
  }

  &:active:not(.disabled) {
    background: rgba($brand-primary, 0.1);
    color: $brand-primary;
  }
}
.num-value {
  min-width: 80rpx;
  text-align: center;
  font-size: $font-size-lg;
  font-weight: 600;
  color: $text-primary;
}
</style>
