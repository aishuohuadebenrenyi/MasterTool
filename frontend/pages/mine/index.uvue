        <text class="mine-menu-label">数据详情</text>
        <text class="mine-menu-arrow">›</text>
      </view>
    </view>

    <view class="mine-menu-card">
      <view class="mine-menu-item" @click="uni.navigateTo({ url: '/pages/mine/Settings' })">
        <image class="mine-menu-icon-image" src="/static/icons/mine-settings.svg" mode="aspectFit" />
        <text class="mine-menu-label">设置</text>
        <text class="mine-menu-arrow">›</text>
      </view>
      <view class="mine-menu-item" @click="uni.navigateTo({ url: '/pages/mine/HelpFeedback' })">
