<script setup>
import { ref } from 'vue'
import NavBar from '../../components/NavBar.uvue'
import AppIcon from '../../components/AppIcon.uvue'

const appName = ref<string>('培训师工具箱')
const version = ref<string>('1.0.0')
const description = ref<string>('专为即兴培训师打造的专业工具，提供备课、现场控制、复盘分析等全流程支持，助力每一次培训精彩呈现。')

function openPrivacy() {
  uni.showModal({
    title: '隐私政策',
    content: '我们仅在提供培训准备、现场交付、反馈收集与复盘分析服务所需范围内处理必要数据，具体以正式上线版本政策为准。',
    showCancel: false
  })
}

function openTerms() {
  uni.showModal({
    title: '用户协议',
    content: '使用本工具即表示你同意将其用于合法合规的培训场景，并妥善保管培训数据与参与者信息。',
    showCancel: false
  })
}
</script>

